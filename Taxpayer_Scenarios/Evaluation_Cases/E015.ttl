@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E015 a :Taxpayer ;
    :owns :E015MichiganOwnership, :E015SouthCarolinaOwnership ;
    :uses :E015MichiganResidence2001_2002, :E015SouthCarolinaResidence2003_2004, :E015MichiganResidence2005 ;
    :disposesOf :E015MichiganDisposition, :E015SouthCarolinaDisposition .

:MichiganResidence a :Property .

:SouthCarolinaResidence a :Property .

:E015MichiganOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MichiganResidence ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E015SouthCarolinaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :SouthCarolinaResidence ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E015MichiganResidence2001_2002 a :ResidenceUseInterval ;
    :hasResidenceOf :MichiganResidence ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E015SouthCarolinaResidence2003_2004 a :ResidenceUseInterval ;
    :hasResidenceOf :SouthCarolinaResidence ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E015MichiganResidence2005 a :ResidenceUseInterval ;
    :hasResidenceOf :MichiganResidence ;
    :residenceStart "2005-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:E015MichiganDisposition a :Disposition ;
    :involves :MichiganResidence ;
    :sellDate "2005-12-18"^^xsd:date ;
    :potentialGain "230000"^^xsd:integer .

:E015SouthCarolinaDisposition a :Disposition ;
    :involves :SouthCarolinaResidence ;
    :sellDate "2005-12-18"^^xsd:date ;
    :potentialGain "210000"^^xsd:integer .

:E015Return a :SingleReturn ;
    :associates :E015 ;
    :linkedTo :E015MichiganDisposition, :E015SouthCarolinaDisposition ;
    :exclusionCap "250000"^^xsd:integer .