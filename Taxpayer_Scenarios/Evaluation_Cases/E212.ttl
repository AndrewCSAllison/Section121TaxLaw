@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E212a a :Taxpayer ;
    :owns :E212aOwnership1 ;
    :uses :E212aResidence1 ;
    :disposesOf :HouseDisposition .

:E212b a :Taxpayer ;
    :owns :E212bOwnership1 ;
    :uses :E212bResidence1 ;
    :disposesOf :HouseDisposition .

:House a :Property .

:E212aOwnership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E212bOwnership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E212aResidence1 a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E212bResidence1 a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2003-11-30"^^xsd:date .

:HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "140000"^^xsd:integer ;
    :partialExclusionReason :UnforeseenCircumstanceReason .

:E212aReturn a :SingleReturn ;
    :associates :E212a ;
    :linkedTo :HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E212bReturn a :SingleReturn ;
    :associates :E212b ;
    :linkedTo :HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .