@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E132a a :Taxpayer ;
    :owns :E132aOwnership ;
    :uses :E132aResidenceUse ;
    :disposesOf :E132aDisposition .

:E132b a :Taxpayer ;
    :owns :E132bOwnership ;
    :uses :E132bResidenceUse ;
    :disposesOf :E132bDisposition .

:E132aProperty a :Property .

:E132bProperty a :Property .

:E132aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E132aProperty ;
    :ownershipStart "2001-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E132bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E132bProperty ;
    :ownershipStart "2001-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E132aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E132aProperty ;
    :residenceStart "2001-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E132bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E132bProperty ;
    :residenceStart "2001-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E132aDisposition a :Disposition ;
    :involves :E132aProperty ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E132bDisposition a :Disposition ;
    :involves :E132bProperty ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "310000"^^xsd:integer .

:E132JointReturn a :JointReturn ;
    :associates :E132a, :E132b ;
    :linkedTo :E132aDisposition, :E132bDisposition ;
    :exclusionCap "500000"^^xsd:integer .