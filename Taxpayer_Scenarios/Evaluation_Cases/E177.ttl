@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E177 a :Taxpayer ;
    :owns :E177TownhouseOwnership, :E177HouseOwnership ;
    :uses :E177TownhouseResidence, :E177HouseResidence ;
    :disposesOf :E177TownhouseDisposition, :E177HouseDisposition .

:E177Townhouse a :Property .

:E177House a :Property .

:E177TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E177Townhouse ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E177TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E177Townhouse ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E177HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E177House ;
    :ownershipStart "2003-12-31"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E177HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E177House ;
    :residenceStart "2003-12-31"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:E177TownhouseDisposition a :Disposition ;
    :involves :E177Townhouse ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain "190000"^^xsd:integer .

:E177HouseDisposition a :Disposition ;
    :involves :E177House ;
    :sellDate "2006-12-31"^^xsd:date ;
    :potentialGain "310000"^^xsd:integer .

:E177TownhouseReturn a :SingleReturn ;
    :associates :E177 ;
    :linkedTo :E177TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E177HouseReturn a :SingleReturn ;
    :associates :E177 ;
    :linkedTo :E177HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .