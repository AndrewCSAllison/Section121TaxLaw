@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Property Instance
:MainResidence a :Property .

### Taxpayer Instance
:Y a :Taxpayer ;
    :owns :Y_OwnershipInterval1 ;
    :uses :Y_ResidenceInterval1 ;
    :disposesOf :Y_Disposition1 .

### Ownership Interval
:Y_OwnershipInterval1 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1989-07-20"^^xsd:date ;
    :ownershipEnd "2001-12-01"^^xsd:date ;
    :percentageOwned 1.0 .

### Residence Interval
:Y_ResidenceInterval1 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "1989-07-20"^^xsd:date ;
    :residenceEnd "1998-01-04"^^xsd:date .

### Disposition
:Y_Disposition1 a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2001-12-01"^^xsd:date ;
    :potentialGain 205000 .

### Return
:Y_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :Y ;
    :linkedTo :Y_Disposition1 .