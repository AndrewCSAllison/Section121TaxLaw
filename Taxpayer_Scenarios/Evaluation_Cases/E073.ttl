@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E073 a :Taxpayer ;
    :owns :E073Ownership ;
    :uses :E073ResidenceUse ;
    :disposesOf :E073HouseSale .

:E073House a :Property .

:E073Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E073House ;
    :ownershipStart "1989-07-20"^^xsd:date ;
    :ownershipEnd "2001-12-01"^^xsd:date .

:E073ResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E073House ;
    :residenceStart "1989-07-20"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E073HouseSale a :Disposition ;
    :involves :E073House ;
    :sellDate "2001-12-01"^^xsd:date ;
    :potentialGain "205000"^^xsd:integer .

:E073SingleReturn a :SingleReturn ;
    :associates :E073 ;
    :linkedTo :E073HouseSale ;
    :exclusionCap "250000"^^xsd:integer .