@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E080 a :Taxpayer ;
    :owns :E080TownhouseOwnership ;
    :uses :E080TownhouseResidence ;
    :disposesOf :E080TownhouseDisposition .

:E080Townhouse a :Property .

:E080TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E080Townhouse ;
    :ownershipStart "1997-02-10"^^xsd:date ;
    :ownershipEnd "2000-06-12"^^xsd:date .

:E080TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E080Townhouse ;
    :residenceStart "1995-06-12"^^xsd:date ;
    :residenceEnd "1998-04-20"^^xsd:date .

:E080TownhouseDisposition a :Disposition ;
    :involves :E080Townhouse ;
    :sellDate "2000-06-12"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:E080SingleReturn a :SingleReturn ;
    :associates :E080 ;
    :linkedTo :E080TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .