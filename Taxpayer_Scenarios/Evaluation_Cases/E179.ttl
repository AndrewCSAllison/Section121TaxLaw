@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Properties
:Townhouse a :Property .
:House a :Property .

### Taxpayer
:BH a :Taxpayer .

### Ownership Intervals
:BH_Own_Townhouse a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BH_Own_House a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

### Residence Use Intervals
:BH_Use_Townhouse a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:BH_Use_House a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

### Dispositions
:BH_Sell_Townhouse a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain 160000 .

:BH_Sell_House a :Disposition ;
    :involves :House ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain 280000 .

### Single Returns
:BH_Return_Townhouse a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BH ;
    :linkedTo :BH_Sell_Townhouse .

:BH_Return_House a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BH ;
    :linkedTo :BH_Sell_House .

### Links from Taxpayer
:BH :owns :BH_Own_Townhouse, :BH_Own_House ;
    :uses :BH_Use_Townhouse, :BH_Use_House ;
    :disposesOf :BH_Sell_Townhouse, :BH_Sell_House .