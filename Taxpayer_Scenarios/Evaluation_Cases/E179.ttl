@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E179 a :Taxpayer ;
    :owns :E179TownhouseOwnership, :E179HouseOwnership ;
    :uses :E179TownhouseResidence, :E179HouseResidence ;
    :disposesOf :E179TownhouseDisposition, :E179HouseDisposition .

:E179Townhouse a :Property .

:E179House a :Property .

:E179TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E179Townhouse ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E179TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E179Townhouse ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E179HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E179House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E179HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E179House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E179TownhouseDisposition a :Disposition ;
    :involves :E179Townhouse ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "160000"^^xsd:integer .

:E179HouseDisposition a :Disposition ;
    :involves :E179House ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "280000"^^xsd:integer .

:E179TownhouseReturn a :SingleReturn ;
    :associates :E179 ;
    :linkedTo :E179TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E179HouseReturn a :SingleReturn ;
    :associates :E179 ;
    :linkedTo :E179HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .