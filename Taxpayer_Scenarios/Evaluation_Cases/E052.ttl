@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:R a :Taxpayer .

:MainResidence a :Property .

:Ownership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1985-03-01"^^xsd:date ;
    :ownershipEnd "1999-11-30"^^xsd:date .

:Residence1 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "1985-03-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:Disposition1 a :Disposition ;
    :involves :MainResidence ;
    :sellDate "1999-11-30"^^xsd:date ;
    :potentialGain 150000 .

:Return1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :R ;
    :linkedTo :Disposition1 .

:R :owns :Ownership1 ;
   :uses :Residence1 ;
   :disposesOf :Disposition1 .