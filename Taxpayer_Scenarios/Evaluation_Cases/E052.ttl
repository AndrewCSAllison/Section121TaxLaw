@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E052 a :Taxpayer ;
    :owns :E052Ownership ;
    :uses :E052Residence ;
    :disposesOf :E052Disposition .

:E052House a :Property .

:E052Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E052House ;
    :ownershipStart "1985-03-01"^^xsd:date ;
    :ownershipEnd "1999-11-30"^^xsd:date .

:E052Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E052House ;
    :residenceStart "1985-03-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E052Disposition a :Disposition ;
    :involves :E052House ;
    :sellDate "1999-11-30"^^xsd:date ;
    :potentialGain "150000"^^xsd:integer .

:E052Return a :SingleReturn ;
    :associates :E052 ;
    :linkedTo :E052Disposition ;
    :exclusionCap "250000"^^xsd:integer .