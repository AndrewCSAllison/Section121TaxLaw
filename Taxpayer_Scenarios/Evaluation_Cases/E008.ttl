@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E008 a :Taxpayer ;
    :owns :E008TexasOwnership, :E008CaliforniaOwnership ;
    :uses :E008TexasResidence2000_2001, :E008CaliforniaResidence2002_2003, :E008TexasResidence2004 ;
    :disposesOf :TexasDisposition, :CaliforniaDisposition .

:TexasProperty a :Property .

:CaliforniaProperty a :Property .

:E008TexasOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :TexasProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E008CaliforniaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :CaliforniaProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E008TexasResidence2000_2001 a :ResidenceUseInterval ;
    :hasResidenceOf :TexasProperty ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E008CaliforniaResidence2002_2003 a :ResidenceUseInterval ;
    :hasResidenceOf :CaliforniaProperty ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E008TexasResidence2004 a :ResidenceUseInterval ;
    :hasResidenceOf :TexasProperty ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:TexasDisposition a :Disposition ;
    :involves :TexasProperty ;
    :sellDate "2004-12-15"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:CaliforniaDisposition a :Disposition ;
    :involves :CaliforniaProperty ;
    :sellDate "2004-12-15"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E008Return a :SingleReturn ;
    :associates :E008 ;
    :linkedTo :TexasDisposition, :CaliforniaDisposition ;
    :exclusionCap "250000"^^xsd:integer .