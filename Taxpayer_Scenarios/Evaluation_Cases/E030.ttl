@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E030 a :Taxpayer ;
    :owns :E030TexasOwnership, :E030NewMexicoOwnership ;
    :uses :E030TexasResidence2000_2001, :E030NewMexicoResidence2002_2003, :E030TexasResidence2004 ;
    :disposesOf :E030TexasDisposition, :E030NewMexicoDisposition .

:E030TexasProperty a :Property .

:E030NewMexicoProperty a :Property .

:E030TexasOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E030TexasProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E030NewMexicoOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E030NewMexicoProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E030TexasResidence2000_2001 a :ResidenceUseInterval ;
    :hasResidenceOf :E030TexasProperty ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E030NewMexicoResidence2002_2003 a :ResidenceUseInterval ;
    :hasResidenceOf :E030NewMexicoProperty ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E030TexasResidence2004 a :ResidenceUseInterval ;
    :hasResidenceOf :E030TexasProperty ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E030TexasDisposition a :Disposition ;
    :involves :E030TexasProperty ;
    :sellDate "2004-12-18"^^xsd:date ;
    :potentialGain "230000"^^xsd:integer .

:E030NewMexicoDisposition a :Disposition ;
    :involves :E030NewMexicoProperty ;
    :sellDate "2004-12-18"^^xsd:date ;
    :potentialGain "210000"^^xsd:integer .

:E030Return a :SingleReturn ;
    :associates :E030 ;
    :linkedTo :E030TexasDisposition, :E030NewMexicoDisposition ;
    :exclusionCap "250000"^^xsd:integer .