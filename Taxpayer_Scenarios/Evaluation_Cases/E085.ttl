@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E085 a :Taxpayer ;
    :owns :E085OwnershipInterval ;
    :uses :E085ResidenceInterval ;
    :disposesOf :E085Disposition .

:E085Townhouse a :Property .

:E085OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E085Townhouse ;
    :ownershipStart "1997-04-01"^^xsd:date ;
    :ownershipEnd "2000-09-09"^^xsd:date .

:E085ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E085Townhouse ;
    :residenceStart "1992-01-01"^^xsd:date ;
    :residenceEnd "1998-06-15"^^xsd:date .

:E085Disposition a :Disposition ;
    :involves :E085Townhouse ;
    :sellDate "2000-09-09"^^xsd:date ;
    :potentialGain "245000"^^xsd:integer .

:E085Return a :SingleReturn ;
    :associates :E085 ;
    :linkedTo :E085Disposition ;
    :exclusionCap "250000"^^xsd:integer .