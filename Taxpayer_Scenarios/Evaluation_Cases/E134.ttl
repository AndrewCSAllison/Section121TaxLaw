@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E134a a :Taxpayer ;
    :owns :E134aOwnership ;
    :uses :E134aResidenceUse ;
    :disposesOf :E134aDisposition .

:E134b a :Taxpayer ;
    :owns :E134bOwnership ;
    :uses :E134bResidenceUse ;
    :disposesOf :E134bDisposition .

:E134aProperty a :Property .

:E134bProperty a :Property .

:E134aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E134aProperty ;
    :ownershipStart "1999-02-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E134bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E134bProperty ;
    :ownershipStart "1999-02-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E134aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E134aProperty ;
    :residenceStart "1999-02-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E134bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E134bProperty ;
    :residenceStart "1999-02-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E134aDisposition a :Disposition ;
    :involves :E134aProperty ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer .

:E134bDisposition a :Disposition ;
    :involves :E134bProperty ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "270000"^^xsd:integer .

:E134JointReturn a :JointReturn ;
    :associates :E134a, :E134b ;
    :linkedTo :E134aDisposition, :E134bDisposition ;
    :exclusionCap "500000"^^xsd:integer .