@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E125a a :Taxpayer ;
    :owns :E125aOwnership ;
    :uses :E125aResidenceUse ;
    :disposesOf :E125aDisposition .

:E125b a :Taxpayer ;
    :owns :E125bOwnership ;
    :uses :E125bResidenceUse ;
    :disposesOf :E125bDisposition .

:E125aProperty a :Property .

:E125bProperty a :Property .

:E125aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E125aProperty ;
    :ownershipStart "2000-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E125bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E125bProperty ;
    :ownershipStart "2000-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E125aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E125aProperty ;
    :residenceStart "2000-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E125bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E125bProperty ;
    :residenceStart "2000-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E125aDisposition a :Disposition ;
    :involves :E125aProperty ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E125bDisposition a :Disposition ;
    :involves :E125bProperty ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "280000"^^xsd:integer .

:E125JointReturn a :JointReturn ;
    :associates :E125a, :E125b ;
    :linkedTo :E125aDisposition, :E125bDisposition ;
    :exclusionCap "500000"^^xsd:integer .