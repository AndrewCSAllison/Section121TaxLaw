@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E074 a :Taxpayer ;
    :owns :E074Ownership ;
    :uses :E074ResidenceUse ;
    :disposesOf :E074Disposition .

:House a :Property .

:E074Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "1989-07-20"^^xsd:date ;
    :ownershipEnd "2001-12-01"^^xsd:date .

:E074ResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1989-07-20"^^xsd:date ;
    :residenceEnd "1998-01-04"^^xsd:date .

:E074Disposition a :Disposition ;
    :involves :House ;
    :sellDate "2001-12-01"^^xsd:date ;
    :potentialGain "205000"^^xsd:integer .

:E074Return a :SingleReturn ;
    :associates :E074 ;
    :linkedTo :E074Disposition ;
    :exclusionCap "250000"^^xsd:integer .