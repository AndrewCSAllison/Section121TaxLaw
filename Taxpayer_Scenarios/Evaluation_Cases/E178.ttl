@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E178 a :Taxpayer ;
    :owns :E178TownhouseOwnership, :E178HouseOwnership ;
    :uses :E178TownhouseResidence, :E178HouseResidence ;
    :disposesOf :E178TownhouseDisposition, :E178HouseDisposition .

:Townhouse a :Property .

:House a :Property .

:E178TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E178TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E178HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E178HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E178TownhouseDisposition a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "160000"^^xsd:integer .

:E178HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "280000"^^xsd:integer .

:E178TownhouseReturn a :SingleReturn ;
    :associates :E178 ;
    :linkedTo :E178TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E178HouseReturn a :SingleReturn ;
    :associates :E178 ;
    :linkedTo :E178HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .