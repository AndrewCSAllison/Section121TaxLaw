@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:MichiganHouse a :Property .

:E202a a :Taxpayer ;
    :owns :E202aOwnership ;
    :uses :E202aResidence ;
    :disposesOf :MichiganHouseDisposition .

:E202b a :Taxpayer ;
    :owns :E202bOwnership ;
    :uses :E202bResidence ;
    :disposesOf :MichiganHouseDisposition .

:E202aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MichiganHouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E202bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MichiganHouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E202aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :MichiganHouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E202bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :MichiganHouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:MichiganHouseDisposition a :Disposition ;
    :involves :MichiganHouse ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "120000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E202aReturn a :SingleReturn ;
    :associates :E202a ;
    :linkedTo :MichiganHouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E202bReturn a :SingleReturn ;
    :associates :E202b ;
    :linkedTo :MichiganHouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .