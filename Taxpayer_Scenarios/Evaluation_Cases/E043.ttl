@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E043 a :Taxpayer ;
    :owns :E043HouseOwnership, :E043LandOwnership ;
    :uses :E043HouseResidence, :E043LandResidence ;
    :disposesOf :E043HouseDisposition, :E043LandDisposition .

:E043House a :Property .

:E043Land a :Property .

:E043HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E043House ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2006-09-10"^^xsd:date .

:E043LandOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E043Land ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2006-09-10"^^xsd:date .

:E043HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E043House ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2006-09-10"^^xsd:date .

:E043LandResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E043Land ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2006-09-10"^^xsd:date .

:E043HouseDisposition a :Disposition ;
    :involves :E043House ;
    :sellDate "2006-09-10"^^xsd:date ;
    :potentialGain "-20000"^^xsd:integer .

:E043LandDisposition a :Disposition ;
    :involves :E043Land ;
    :sellDate "2006-09-10"^^xsd:date ;
    :potentialGain "260000"^^xsd:integer .

:E043Return a :SingleReturn ;
    :associates :E043 ;
    :linkedTo :E043HouseDisposition, :E043LandDisposition ;
    :exclusionCap "250000"^^xsd:integer .