@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E114a a :Taxpayer ;
    :owns :E114aOwnership ;
    :uses :E114aResidence ;
    :disposesOf :E114Disposition .

:E114b a :Taxpayer ;
    :owns :E114bOwnership ;
    :uses :E114bResidence ;
    :disposesOf :E114Disposition .

:E114Property a :Property .

:E114aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E114Property ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E114bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E114Property ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E114aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E114Property ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:E114bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E114Property ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:E114Disposition a :Disposition ;
    :involves :E114Property ;
    :sellDate "2017-05-14"^^xsd:date ;
    :potentialGain "480000"^^xsd:integer .

:E114JointReturn a :JointReturn ;
    :associates :E114a, :E114b ;
    :linkedTo :E114Disposition ;
    :exclusionCap "500000"^^xsd:integer .