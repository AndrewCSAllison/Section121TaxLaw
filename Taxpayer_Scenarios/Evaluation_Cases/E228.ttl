@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:BX a :Taxpayer .

:BX_MainResidence a :Property .

:BX_OwnershipInterval1 a :OwnershipUseInterval ;
    :hasOwnershipOf :BX_MainResidence ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:BX_ResidenceInterval1 a :ResidenceUseInterval ;
    :hasResidenceOf :BX_MainResidence ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:BX_Disposition1 a :Disposition ;
    :involves :BX_MainResidence ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain 250000 ;
    :partialExclusionReason :EmploymentRelatedReason .

:BX_SingleReturn1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BX ;
    :linkedTo :BX_Disposition1 .

:BX :owns :BX_OwnershipInterval1 .
:BX :uses :BX_ResidenceInterval1 .
:BX :disposesOf :BX_Disposition1 .