@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E228 a :Taxpayer ;
    :owns :E228Ownership ;
    :uses :E228Residence ;
    :disposesOf :E228Disposition .

:E228House a :Property .

:E228Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E228House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date .

:E228Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E228House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E228Disposition a :Disposition ;
    :involves :E228House ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E228Return a :SingleReturn ;
    :associates :E228 ;
    :linkedTo :E228Disposition ;
    :exclusionCap "250000"^^xsd:integer .