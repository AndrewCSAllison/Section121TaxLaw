@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E139a a :Taxpayer ;
    :owns :E139aOwnership ;
    :disposesOf :ResidenceSale .

:E139b a :Taxpayer ;
    :owns :E139bOwnership ;
    :uses :E139bResidenceUse ;
    :disposesOf :ResidenceSale .

:MainResidence a :Property .

:E139aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2001-02-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E139bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2001-02-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E139bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2001-02-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:ResidenceSale a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain "350000"^^xsd:integer .

:JointReturn2004 a :JointReturn ;
    :associates :E139a, :E139b ;
    :linkedTo :ResidenceSale ;
    :exclusionCap "500000"^^xsd:integer .