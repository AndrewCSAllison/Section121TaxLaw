:TaxpayerL a :Taxpayer ;
    :owns :OwnershipHouse , :OwnershipLand ;
    :uses :ResidenceHouse , :ResidenceLand ;
    :disposesOf :DispositionHouse , :DispositionLand .

:MainHouse a :Property .
:ParcelLand a :Property .

:OwnershipHouse a :OwnershipUseInterval ;
    :hasOwnershipOf :MainHouse ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:OwnershipLand a :OwnershipUseInterval ;
    :hasOwnershipOf :ParcelLand ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:ResidenceHouse a :ResidenceUseInterval ;
    :hasResidenceOf :MainHouse ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:ResidenceLand a :ResidenceUseInterval ;
    :hasResidenceOf :ParcelLand ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:DispositionHouse a :Disposition ;
    :involves :MainHouse ;
    :sellDate "2003-06-15"^^xsd:date ;
    :potentialGain -25000 .

:DispositionLand a :Disposition ;
    :involves :ParcelLand ;
    :sellDate "2003-06-15"^^xsd:date ;
    :potentialGain 270000 .

:SingleReturn2003 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :TaxpayerL ;
    :linkedTo :DispositionHouse , :DispositionLand .
