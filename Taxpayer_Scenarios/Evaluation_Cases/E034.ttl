@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E034 a :Taxpayer ;
    :owns :E034HouseOwnership, :E034LandOwnership ;
    :uses :E034HouseResidence, :E034LandResidence ;
    :disposesOf :E034HouseDisposition, :E034LandDisposition .

:E034House a :Property .

:E034Land a :Property .

:E034HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E034House ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2003-06-15"^^xsd:date .

:E034LandOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E034Land ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2003-06-15"^^xsd:date .

:E034HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E034House ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2003-06-15"^^xsd:date .

:E034LandResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E034Land ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2003-06-15"^^xsd:date .

:E034HouseDisposition a :Disposition ;
    :involves :E034House ;
    :sellDate "2003-06-15"^^xsd:date ;
    :potentialGain "-25000"^^xsd:integer .

:E034LandDisposition a :Disposition ;
    :involves :E034Land ;
    :sellDate "2003-06-15"^^xsd:date ;
    :potentialGain "270000"^^xsd:integer .

:E034Return a :SingleReturn ;
    :associates :E034 ;
    :linkedTo :E034HouseDisposition, :E034LandDisposition ;
    :exclusionCap "250000"^^xsd:integer .