@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E078 a :Taxpayer ;
    :owns :E078OwnershipInterval ;
    :uses :E078ResidenceInterval ;
    :disposesOf :E078Disposition .

:E078Townhouse a :Property .

:E078OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E078Townhouse ;
    :ownershipStart "1997-01-18"^^xsd:date ;
    :ownershipEnd "2000-05-25"^^xsd:date .

:E078ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E078Townhouse ;
    :residenceStart "1995-05-25"^^xsd:date ;
    :residenceEnd "1998-02-01"^^xsd:date .

:E078Disposition a :Disposition ;
    :involves :E078Townhouse ;
    :sellDate "2000-05-25"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:E078SingleReturn a :SingleReturn ;
    :associates :E078 ;
    :linkedTo :E078Disposition ;
    :exclusionCap "250000"^^xsd:integer .