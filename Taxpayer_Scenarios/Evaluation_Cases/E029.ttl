@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E029 a :Taxpayer ;
    :owns :E029TexasOwnership, :E029NewMexicoOwnership ;
    :uses :E029TexasResidence2000_2001, :E029NewMexicoResidence2002_2003, :E029TexasResidence2004 ;
    :disposesOf :E029TexasDisposition, :E029NewMexicoDisposition .

:E029TexasProperty a :Property .

:E029NewMexicoProperty a :Property .

:E029TexasOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E029TexasProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E029NewMexicoOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E029NewMexicoProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E029TexasResidence2000_2001 a :ResidenceUseInterval ;
    :hasResidenceOf :E029TexasProperty ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E029NewMexicoResidence2002_2003 a :ResidenceUseInterval ;
    :hasResidenceOf :E029NewMexicoProperty ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E029TexasResidence2004 a :ResidenceUseInterval ;
    :hasResidenceOf :E029TexasProperty ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E029TexasDisposition a :Disposition ;
    :involves :E029TexasProperty ;
    :sellDate "2004-12-18"^^xsd:date ;
    :potentialGain "230000"^^xsd:integer .

:E029NewMexicoDisposition a :Disposition ;
    :involves :E029NewMexicoProperty ;
    :sellDate "2004-12-18"^^xsd:date ;
    :potentialGain "210000"^^xsd:integer .

:E029Return a :SingleReturn ;
    :associates :E029 ;
    :linkedTo :E029TexasDisposition, :E029NewMexicoDisposition ;
    :exclusionCap "250000"^^xsd:integer .