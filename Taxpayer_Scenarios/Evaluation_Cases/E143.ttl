@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E143a a :Taxpayer ;
    :owns :E143aOwnership ;
    :disposesOf :ResidenceSale .

:E143b a :Taxpayer ;
    :owns :E143bOwnership ;
    :uses :E143bResidenceUse ;
    :disposesOf :ResidenceSale .

:MainResidence a :Property .

:E143aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1999-02-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E143bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1999-02-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E143bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "1999-02-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:ResidenceSale a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "280000"^^xsd:integer .

:E143JointReturn a :JointReturn ;
    :associates :E143a, :E143b ;
    :linkedTo :ResidenceSale ;
    :exclusionCap "500000"^^xsd:integer .