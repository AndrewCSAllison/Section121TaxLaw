@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E197a a :Taxpayer ;
    :owns :E197aOwnership ;
    :uses :E197aResidence ;
    :disposesOf :HouseSale .

:E197b a :Taxpayer ;
    :owns :E197bOwnership ;
    :uses :E197bResidence ;
    :disposesOf :HouseSale .

:House a :Property .

:E197aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E197bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E197aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E197bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer ;
    :partialExclusionReason :HealthRelatedReason .

:JointReturn a :JointReturn ;
    :associates :E197a, :E197b ;
    :linkedTo :HouseSale ;
    :exclusionCap "500000"^^xsd:integer .