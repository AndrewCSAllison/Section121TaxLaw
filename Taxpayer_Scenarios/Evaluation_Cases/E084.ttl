@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E084 a :Taxpayer ;
    :owns :E084OwnershipInterval ;
    :uses :E084ResidenceInterval ;
    :disposesOf :E084TownhouseSale .

:E084Townhouse a :Property .

:E084OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E084Townhouse ;
    :ownershipStart "1996-11-05"^^xsd:date ;
    :ownershipEnd "2000-03-01"^^xsd:date .

:E084ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E084Townhouse ;
    :residenceStart "1995-03-01"^^xsd:date ;
    :residenceEnd "1998-01-30"^^xsd:date .

:E084TownhouseSale a :Disposition ;
    :involves :E084Townhouse ;
    :sellDate "2000-03-01"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E084SingleReturn a :SingleReturn ;
    :associates :E084 ;
    :linkedTo :E084TownhouseSale ;
    :exclusionCap "250000"^^xsd:integer .