@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E104a a :Taxpayer ;
    :owns :E104aOwnership ;
    :uses :E104aResidence ;
    :disposesOf :HouseSale .

:E104b a :Taxpayer ;
    :owns :E104bOwnership ;
    :uses :E104bResidence ;
    :disposesOf :HouseSale .

:House a :Property .

:E104aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E104bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E104aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:E104bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2012-05-31"^^xsd:date ;
    :potentialGain "256000"^^xsd:integer .

:E104aReturn a :SingleReturn ;
    :associates :E104a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E104bReturn a :SingleReturn ;
    :associates :E104b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .