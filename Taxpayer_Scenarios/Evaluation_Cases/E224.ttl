@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E224 a :Taxpayer ;
    :owns :E224SmallHouseOwnership ;
    :uses :E224SmallHouseResidence ;
    :disposesOf :E224SmallHouseDisposition .

:E224SmallHouse a :Property .

:E224SmallHouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E224SmallHouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date .

:E224SmallHouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E224SmallHouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E224SmallHouseDisposition a :Disposition ;
    :involves :E224SmallHouse ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "120000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E224SingleReturn a :SingleReturn ;
    :associates :E224 ;
    :linkedTo :E224SmallHouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .