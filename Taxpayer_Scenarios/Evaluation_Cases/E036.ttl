:TaxpayerL a :Taxpayer ;
    :owns :HouseOwnershipInterval , :LandOwnershipInterval ;
    :uses :HouseResidenceInterval , :LandResidenceInterval ;
    :disposesOf :HouseDisposition , :LandDisposition .

:House a :Property .
:Land a :Property .

:HouseOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:LandOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :Land ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:HouseResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:LandResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :Land ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2003-06-15"^^xsd:date ;
    :potentialGain -25000 .

:LandDisposition a :Disposition ;
    :involves :Land ;
    :sellDate "2003-06-15"^^xsd:date ;
    :potentialGain 270000 .

:SingleReturn1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :TaxpayerL ;
    :linkedTo :HouseDisposition , :LandDisposition .
