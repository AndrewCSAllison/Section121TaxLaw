@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E036 a :Taxpayer ;
    :owns :E036HouseOwnership, :E036LandOwnership ;
    :uses :E036HouseResidence, :E036LandResidence ;
    :disposesOf :E036HouseDisposition, :E036LandDisposition .

:E036House a :Property .

:E036Land a :Property .

:E036HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E036House ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2003-06-15"^^xsd:date .

:E036LandOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E036Land ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2003-06-15"^^xsd:date .

:E036HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E036House ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2003-06-15"^^xsd:date .

:E036LandResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E036Land ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2003-06-15"^^xsd:date .

:E036HouseDisposition a :Disposition ;
    :involves :E036House ;
    :sellDate "2003-06-15"^^xsd:date ;
    :potentialGain "-25000"^^xsd:integer .

:E036LandDisposition a :Disposition ;
    :involves :E036Land ;
    :sellDate "2003-06-15"^^xsd:date ;
    :potentialGain "270000"^^xsd:integer .

:E036Return a :SingleReturn ;
    :associates :E036 ;
    :linkedTo :E036HouseDisposition, :E036LandDisposition ;
    :exclusionCap "250000"^^xsd:integer .