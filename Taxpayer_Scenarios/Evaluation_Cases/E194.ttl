@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E194 a :Taxpayer ;
    :owns :E194Ownership ;
    :uses :E194ResidenceUse ;
    :disposesOf :E194Disposition .

:E194House a :Property .

:E194Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E194House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date .

:E194ResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E194House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:E194Disposition a :Disposition ;
    :involves :E194House ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain "275000"^^xsd:integer ;
    :partialExclusionReason :HealthRelatedReason .

:E194Return a :SingleReturn ;
    :associates :E194 ;
    :linkedTo :E194Disposition ;
    :exclusionCap "250000"^^xsd:integer .