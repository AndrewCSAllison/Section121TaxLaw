:BM a :Taxpayer .

:BMHouse a :Property .

:BMOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :BMHouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:BMResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :BMHouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:BMSale a :Disposition ;
    :involves :BMHouse ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain 275000 ;
    :partialExclusionReason :HealthRelatedReason .

:BMSingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BM ;
    :linkedTo :BMSale .

:BM :owns :BMOwnershipInterval ;
    :uses :BMResidenceInterval ;
    :disposesOf :BMSale .