@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E200a a :Taxpayer ;
    :owns :E200aOwnership ;
    :uses :E200aResidence ;
    :disposesOf :HouseSale .

:E200b a :Taxpayer ;
    :owns :E200bOwnership ;
    :uses :E200bResidence ;
    :disposesOf :HouseSale .

:House a :Property .

:E200aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E200bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E200aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E200bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "325000"^^xsd:integer ;
    :partialExclusionReason :HealthRelatedReason .

:E200aReturn a :SingleReturn ;
    :associates :E200a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E200bReturn a :SingleReturn ;
    :associates :E200b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .