@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E057 a :Taxpayer ;
    :owns :E057Ownership ;
    :uses :E057Residence ;
    :disposesOf :E057Disposition .

:E057House a :Property .

:E057Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E057House ;
    :ownershipStart "1992-06-15"^^xsd:date ;
    :ownershipEnd "2001-02-28"^^xsd:date .

:E057Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E057House ;
    :residenceStart "1992-06-15"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E057Disposition a :Disposition ;
    :involves :E057House ;
    :sellDate "2001-02-28"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E057Return a :SingleReturn ;
    :associates :E057 ;
    :linkedTo :E057Disposition ;
    :exclusionCap "250000"^^xsd:integer .