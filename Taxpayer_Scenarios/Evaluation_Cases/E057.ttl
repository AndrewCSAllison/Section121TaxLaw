@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:S a :Taxpayer .

:MainResidence a :Property .

:Ownership1 a :OwnershipUseInterval ;
    :ownershipStart "1992-06-15"^^xsd:date ;
    :ownershipEnd "2001-02-28"^^xsd:date ;
    :hasOwnershipOf :MainResidence .

:Residence1 a :ResidenceUseInterval ;
    :residenceStart "1992-06-15"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date ;
    :hasResidenceOf :MainResidence .

:Disposition1 a :Disposition ;
    :sellDate "2001-02-28"^^xsd:date ;
    :potentialGain 220000 ;
    :involves :MainResidence .

:Return1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :S ;
    :linkedTo :Disposition1 .

:S :owns :Ownership1 ;
   :uses :Residence1 ;
   :disposesOf :Disposition1 .