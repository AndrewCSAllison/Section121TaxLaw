@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E016 a :Taxpayer ;
    :owns :E016NevadaOwnership, :E016WashingtonOwnership ;
    :uses :E016NevadaResidence2002_2003, :E016WashingtonResidence2004_2005, :E016NevadaResidence2006 ;
    :disposesOf :E016NevadaDisposition, :E016WashingtonDisposition .

:NevadaResidence a :Property .

:WashingtonResidence a :Property .

:E016NevadaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :NevadaResidence ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E016WashingtonOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :WashingtonResidence ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E016NevadaResidence2002_2003 a :ResidenceUseInterval ;
    :hasResidenceOf :NevadaResidence ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E016WashingtonResidence2004_2005 a :ResidenceUseInterval ;
    :hasResidenceOf :WashingtonResidence ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:E016NevadaResidence2006 a :ResidenceUseInterval ;
    :hasResidenceOf :NevadaResidence ;
    :residenceStart "2006-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:E016NevadaDisposition a :Disposition ;
    :involves :NevadaResidence ;
    :sellDate "2006-12-15"^^xsd:date ;
    :potentialGain "235000"^^xsd:integer .

:E016WashingtonDisposition a :Disposition ;
    :involves :WashingtonResidence ;
    :sellDate "2006-12-15"^^xsd:date ;
    :potentialGain "210000"^^xsd:integer .

:E016SingleReturn a :SingleReturn ;
    :associates :E016 ;
    :linkedTo :E016NevadaDisposition, :E016WashingtonDisposition ;
    :exclusionCap "250000"^^xsd:integer .