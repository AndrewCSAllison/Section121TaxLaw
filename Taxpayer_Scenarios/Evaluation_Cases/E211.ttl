@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E211a a :Taxpayer ;
    :owns :E211aOwnership ;
    :uses :E211aResidence ;
    :disposesOf :HouseSale .

:E211b a :Taxpayer ;
    :owns :E211bOwnership ;
    :uses :E211bResidence ;
    :disposesOf :HouseSale .

:House a :Property .

:E211aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E211bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E211aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E211bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2003-11-30"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "140000"^^xsd:integer ;
    :partialExclusionReason :UnforeseenCircumstanceReason .

:E211aReturn a :SingleReturn ;
    :associates :E211a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E211bReturn a :SingleReturn ;
    :associates :E211b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .
