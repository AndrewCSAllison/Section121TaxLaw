@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E189 a :Taxpayer ;
    :owns :E189Ownership ;
    :uses :E189Residence ;
    :disposesOf :E189Disposition .

:E189House a :Property .

:E189Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E189House ;
    :ownershipStart "2002-02-01"^^xsd:date ;
    :ownershipEnd "2005-08-01"^^xsd:date .

:E189Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E189House ;
    :residenceStart "2002-02-01"^^xsd:date ;
    :residenceEnd "2003-05-01"^^xsd:date .

:E189Disposition a :Disposition ;
    :involves :E189House ;
    :sellDate "2005-08-01"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E189Return a :SingleReturn ;
    :associates :E189 ;
    :linkedTo :E189Disposition ;
    :exclusionCap "250000"^^xsd:integer .