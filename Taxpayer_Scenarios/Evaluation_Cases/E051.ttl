@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E051 a :Taxpayer ;
    :owns :E051OwnershipInterval ;
    :uses :E051ResidenceInterval ;
    :disposesOf :E051Disposition .

:E051House a :Property .

:E051OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E051House ;
    :ownershipStart "1990-05-01"^^xsd:date ;
    :ownershipEnd "2000-08-15"^^xsd:date .

:E051ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E051House ;
    :residenceStart "1990-05-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E051Disposition a :Disposition ;
    :involves :E051House ;
    :sellDate "2000-08-15"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:E051Return a :SingleReturn ;
    :associates :E051 ;
    :linkedTo :E051Disposition ;
    :exclusionCap "250000"^^xsd:integer .