@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E216 a :Taxpayer ;
    :owns :E216Ownership1 ;
    :uses :E216Residence1 ;
    :disposesOf :CondominiumDisposition .

:Condominium a :Property .

:E216Ownership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :Condominium ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date .

:E216Residence1 a :ResidenceUseInterval ;
    :hasResidenceOf :Condominium ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:CondominiumDisposition a :Disposition ;
    :involves :Condominium ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain "80000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E216Return a :SingleReturn ;
    :associates :E216 ;
    :linkedTo :CondominiumDisposition ;
    :exclusionCap "250000"^^xsd:integer .