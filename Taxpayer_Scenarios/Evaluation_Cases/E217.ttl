@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E217 a :Taxpayer ;
    :owns :E217Ownership1 ;
    :uses :E217Residence1 ;
    :disposesOf :E217Disposition1 .

:E217House a :Property .

:E217Ownership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :E217House ;
    :ownershipStart "2003-04-01"^^xsd:date ;
    :ownershipEnd "2004-10-31"^^xsd:date .

:E217Residence1 a :ResidenceUseInterval ;
    :hasResidenceOf :E217House ;
    :residenceStart "2003-04-01"^^xsd:date ;
    :residenceEnd "2004-10-31"^^xsd:date .

:E217Disposition1 a :Disposition ;
    :involves :E217House ;
    :sellDate "2004-10-31"^^xsd:date ;
    :potentialGain "95000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E217Return a :SingleReturn ;
    :associates :E217 ;
    :linkedTo :E217Disposition1 ;
    :exclusionCap "250000"^^xsd:integer .

:NonQualifyingReason a :ReasonType .