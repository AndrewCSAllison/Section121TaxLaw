@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E031 a :Taxpayer ;
    :owns :E031ArizonaOwnership, :E031VirginiaOwnership ;
    :uses :E031ArizonaResidence2003_2004, :E031VirginiaResidence2005_2006, :E031ArizonaResidence2007 ;
    :disposesOf :E031ArizonaDisposition, :E031VirginiaDisposition .

:E031ArizonaProperty a :Property .

:E031VirginiaProperty a :Property .

:E031ArizonaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E031ArizonaProperty ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2007-12-31"^^xsd:date .

:E031VirginiaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E031VirginiaProperty ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2007-12-31"^^xsd:date .

:E031ArizonaResidence2003_2004 a :ResidenceUseInterval ;
    :hasResidenceOf :E031ArizonaProperty ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E031VirginiaResidence2005_2006 a :ResidenceUseInterval ;
    :hasResidenceOf :E031VirginiaProperty ;
    :residenceStart "2005-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:E031ArizonaResidence2007 a :ResidenceUseInterval ;
    :hasResidenceOf :E031ArizonaProperty ;
    :residenceStart "2007-01-01"^^xsd:date ;
    :residenceEnd "2007-12-31"^^xsd:date .

:E031ArizonaDisposition a :Disposition ;
    :involves :E031ArizonaProperty ;
    :sellDate "2007-12-20"^^xsd:date ;
    :potentialGain "240000"^^xsd:integer .

:E031VirginiaDisposition a :Disposition ;
    :involves :E031VirginiaProperty ;
    :sellDate "2007-12-20"^^xsd:date ;
    :potentialGain "215000"^^xsd:integer .

:E031Return a :SingleReturn ;
    :associates :E031 ;
    :linkedTo :E031ArizonaDisposition, :E031VirginiaDisposition ;
    :exclusionCap "250000"^^xsd:integer .