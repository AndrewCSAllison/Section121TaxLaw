:TaxpayerM a :Taxpayer ;
    :owns :MHouseOwnershipInterval, :MLandOwnershipInterval ;
    :uses :MHouseResidenceInterval, :MLandResidenceInterval ;
    :disposesOf :MHouseDisposition, :MLandDisposition .

:MainHouse a :Property .
:ParcelLand a :Property .

:MHouseOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :MainHouse ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:MLandOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :ParcelLand ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:MHouseResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :MainHouse ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:MLandResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :ParcelLand ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:MHouseDisposition a :Disposition ;
    :involves :MainHouse ;
    :sellDate "2005-07-01"^^xsd:date ;
    :potentialGain -15000 .

:MLandDisposition a :Disposition ;
    :involves :ParcelLand ;
    :sellDate "2005-07-01"^^xsd:date ;
    :potentialGain 300000 .

:MSingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :TaxpayerM ;
    :linkedTo :MHouseDisposition, :MLandDisposition .
