@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E038 a :Taxpayer ;
    :owns :E038HouseOwnership, :E038LandOwnership ;
    :uses :E038HouseResidence, :E038LandResidence ;
    :disposesOf :E038HouseDisposition, :E038LandDisposition .

:E038House a :Property .

:E038Land a :Property .

:E038HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E038House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2005-07-01"^^xsd:date .

:E038LandOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E038Land ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-07-01"^^xsd:date .

:E038HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E038House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:E038LandResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E038Land ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:E038HouseDisposition a :Disposition ;
    :involves :E038House ;
    :sellDate "2005-07-01"^^xsd:date ;
    :potentialGain "-15000"^^xsd:integer .

:E038LandDisposition a :Disposition ;
    :involves :E038Land ;
    :sellDate "2005-07-01"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E038Return a :SingleReturn ;
    :associates :E038 ;
    :linkedTo :E038HouseDisposition, :E038LandDisposition ;
    :exclusionCap "250000"^^xsd:integer .