@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E220 a :Taxpayer ;
    :owns :E220CondoOwnership ;
    :uses :E220CondoResidence ;
    :disposesOf :E220CondoDisposition .

:E220Condominium a :Property .

:E220CondoOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E220Condominium ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date .

:E220CondoResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E220Condominium ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:E220CondoDisposition a :Disposition ;
    :involves :E220Condominium ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain "190000"^^xsd:integer ;
    :partialExclusionReason :UnforeseenCircumstanceReason .

:E220Return a :SingleReturn ;
    :associates :E220 ;
    :linkedTo :E220CondoDisposition ;
    :exclusionCap "250000"^^xsd:integer .