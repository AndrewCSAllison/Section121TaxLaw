@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E068 a :Taxpayer ;
    :owns :E068OwnershipInterval ;
    :uses :E068ResidenceInterval ;
    :disposesOf :E068Disposition .

:E068House a :Property .

:E068OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E068House ;
    :ownershipStart "1986-05-10"^^xsd:date ;
    :ownershipEnd "2001-09-20"^^xsd:date .

:E068ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E068House ;
    :residenceStart "1986-05-10"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E068Disposition a :Disposition ;
    :involves :E068House ;
    :sellDate "2001-09-20"^^xsd:date ;
    :potentialGain "195000"^^xsd:integer .

:E068SingleReturn a :SingleReturn ;
    :associates :E068 ;
    :linkedTo :E068Disposition ;
    :exclusionCap "250000"^^xsd:integer .