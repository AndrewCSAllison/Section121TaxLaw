@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E182 a :Taxpayer ;
    :owns :E182TownhouseOwnership ;
    :uses :E182TownhouseResidence ;
    :disposesOf :E182TownhouseSale .

:E182Townhouse a :Property .

:E182TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E182Townhouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date .

:E182TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E182Townhouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:E182TownhouseSale a :Disposition ;
    :involves :E182Townhouse ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E182SingleReturn a :SingleReturn ;
    :associates :E182 ;
    :linkedTo :E182TownhouseSale ;
    :exclusionCap "250000"^^xsd:integer .