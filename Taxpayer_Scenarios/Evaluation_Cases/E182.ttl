:BI a :Taxpayer .

:Townhouse a :Property .

:OUInterval1 a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date .

:RUInterval1 a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:Disposition1 a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain 250000 ;
    :partialExclusionReason :EmploymentRelatedReason .

:SingleReturn1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BI ;
    :linkedTo :Disposition1 .

:BI :owns :OUInterval1 ;
    :uses :RUInterval1 ;
    :disposesOf :Disposition1 .