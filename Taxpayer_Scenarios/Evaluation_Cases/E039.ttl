@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E039 a :Taxpayer ;
    :owns :E039HouseOwnership, :E039LandOwnership ;
    :uses :E039HouseResidence, :E039LandResidence ;
    :disposesOf :E039HouseDisposition, :E039LandDisposition .

:E039House a :Property .

:E039Land a :Property .

:E039HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E039House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2005-07-01"^^xsd:date .

:E039LandOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E039Land ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-07-01"^^xsd:date .

:E039HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E039House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2005-07-01"^^xsd:date .

:E039LandResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E039Land ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2005-07-01"^^xsd:date .

:E039HouseDisposition a :Disposition ;
    :involves :E039House ;
    :sellDate "2005-07-01"^^xsd:date ;
    :potentialGain "-15000"^^xsd:integer .

:E039LandDisposition a :Disposition ;
    :involves :E039Land ;
    :sellDate "2005-07-01"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E039Return a :SingleReturn ;
    :associates :E039 ;
    :linkedTo :E039HouseDisposition, :E039LandDisposition ;
    :exclusionCap "250000"^^xsd:integer .