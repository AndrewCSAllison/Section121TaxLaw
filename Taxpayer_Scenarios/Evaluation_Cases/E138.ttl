@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E138a a :Taxpayer ;
    :owns :E138aOwnership ;
    :disposesOf :ResidenceSale .

:E138b a :Taxpayer ;
    :owns :E138bOwnership ;
    :uses :E138bResidenceUse ;
    :disposesOf :ResidenceSale .

:MainResidence a :Property .

:E138aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2000-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E138bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2000-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E138bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2000-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:ResidenceSale a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:JointReturn a :JointReturn ;
    :associates :E138a, :E138b ;
    :linkedTo :ResidenceSale ;
    :exclusionCap "500000"^^xsd:integer .