@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:BB a :Taxpayer .

# Properties
:Townhouse a :Property .
:House a :Property .

# Ownership & Residence Intervals
:BB_OwnUse_Townhouse a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2000-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BB_ResUse_Townhouse a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:BB_OwnUse_House a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BB_ResUse_House a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

# Dispositions
:Disposition_Townhouse a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain 200000 .

:Disposition_House a :Disposition ;
    :involves :House ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain 280000 ;
    :partialExclusionReason :NonQualifyingReason .

# Single Returns
:BB_SingleReturn_Townhouse a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BB ;
    :linkedTo :Disposition_Townhouse .

:BB_SingleReturn_House a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BB ;
    :linkedTo :Disposition_House .

# Link taxpayer to ownership/use intervals
:BB :owns :BB_OwnUse_Townhouse, :BB_OwnUse_House ;
    :uses :BB_ResUse_Townhouse, :BB_ResUse_House ;
    :disposesOf :Disposition_Townhouse, :Disposition_House .