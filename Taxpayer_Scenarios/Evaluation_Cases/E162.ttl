@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E162 a :Taxpayer ;
    :owns :E162TownhouseOwnership, :E162HouseOwnership ;
    :uses :E162TownhouseResidence, :E162HouseResidence ;
    :disposesOf :TownhouseDisposition, :HouseDisposition .

:Townhouse a :Property .

:House a :Property .

:E162TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E162TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:E162HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E162HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:TownhouseDisposition a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "280000"^^xsd:integer .

:TownhouseReturn a :SingleReturn ;
    :associates :E162 ;
    :linkedTo :TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:HouseReturn a :SingleReturn ;
    :associates :E162 ;
    :linkedTo :HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .