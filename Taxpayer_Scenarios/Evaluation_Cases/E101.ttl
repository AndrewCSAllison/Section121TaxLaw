@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E101a a :Taxpayer ;
    :owns :E101aOwnership ;
    :uses :E101aResidence ;
    :disposesOf :HouseSale .

:E101b a :Taxpayer ;
    :owns :E101bOwnership ;
    :uses :E101bResidence ;
    :disposesOf :HouseSale .

:House a :Property .

:E101aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E101bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E101aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:E101bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2014-08-31"^^xsd:date ;
    :potentialGain "720000"^^xsd:integer .

:E101aReturn a :SingleReturn ;
    :associates :E101a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E101bReturn a :SingleReturn ;
    :associates :E101b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .