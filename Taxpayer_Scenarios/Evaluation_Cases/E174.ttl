@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E174 a :Taxpayer ;
    :owns :E174TownhouseOwnership, :E174HouseOwnership ;
    :uses :E174TownhouseResidence, :E174HouseResidence ;
    :disposesOf :E174TownhouseDisposition, :E174HouseDisposition .

:Townhouse a :Property .

:House a :Property .

:E174TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E174TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E174HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E174HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:E174TownhouseDisposition a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain "210000"^^xsd:integer .

:E174HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain "290000"^^xsd:integer .

:E174TownhouseReturn a :SingleReturn ;
    :associates :E174 ;
    :linkedTo :E174TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E174HouseReturn a :SingleReturn ;
    :associates :E174 ;
    :linkedTo :E174HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .