@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E061 a :Taxpayer ;
    :owns :E061OwnershipInterval ;
    :uses :E061ResidenceInterval ;
    :disposesOf :E061Disposition .

:E061House a :Property .

:E061OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E061House ;
    :ownershipStart "1986-01-01"^^xsd:date ;
    :ownershipEnd "2001-07-01"^^xsd:date .

:E061ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E061House ;
    :residenceStart "1986-01-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E061Disposition a :Disposition ;
    :involves :E061House ;
    :sellDate "2001-07-01"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:E061SingleReturn a :SingleReturn ;
    :associates :E061 ;
    :linkedTo :E061Disposition ;
    :exclusionCap "250000"^^xsd:integer .