@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E184 a :Taxpayer ;
    :owns :E184OwnershipInterval ;
    :uses :E184ResidenceInterval ;
    :disposesOf :E184Disposition .

:E184FloridaHouse a :Property .

:E184OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E184FloridaHouse ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date .

:E184ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E184FloridaHouse ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-05-01"^^xsd:date .

:E184Disposition a :Disposition ;
    :involves :E184FloridaHouse ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E184SingleReturn a :SingleReturn ;
    :associates :E184 ;
    :linkedTo :E184Disposition ;
    :exclusionCap "250000"^^xsd:integer .