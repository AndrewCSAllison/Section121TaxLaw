@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E064 a :Taxpayer ;
    :owns :E064Ownership ;
    :uses :E064ResidenceUse ;
    :disposesOf :E064Disposition .

:E064House a :Property .

:E064Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E064House ;
    :ownershipStart "1987-02-01"^^xsd:date ;
    :ownershipEnd "2002-06-15"^^xsd:date .

:E064ResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E064House ;
    :residenceStart "1987-02-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E064Disposition a :Disposition ;
    :involves :E064House ;
    :sellDate "2002-06-15"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E064SingleReturn a :SingleReturn ;
    :associates :E064 ;
    :linkedTo :E064Disposition ;
    :exclusionCap "250000"^^xsd:integer .