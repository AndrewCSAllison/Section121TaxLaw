@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E191 a :Taxpayer ;
    :owns :E191CondoOwnership ;
    :uses :E191CondoResidence ;
    :disposesOf :E191CondoDisposition .

:E191Condominium a :Property .

:E191CondoOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E191Condominium ;
    :ownershipStart "2003-07-01"^^xsd:date ;
    :ownershipEnd "2004-02-05"^^xsd:date .

:E191CondoResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E191Condominium ;
    :residenceStart "2003-07-01"^^xsd:date ;
    :residenceEnd "2004-02-05"^^xsd:date .

:E191CondoDisposition a :Disposition ;
    :involves :E191Condominium ;
    :sellDate "2004-02-05"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E191SingleReturn a :SingleReturn ;
    :associates :E191 ;
    :linkedTo :E191CondoDisposition ;
    :exclusionCap "250000"^^xsd:integer .