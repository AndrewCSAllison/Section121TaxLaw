@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Taxpayer
:BL a :Taxpayer ;
    :owns :BLCondoOwnershipInterval ;
    :uses :BLCondoResidenceInterval ;
    :disposesOf :BLCondoDisposition .

# Property
:BLCondo a :Property .

# Ownership interval
:BLCondoOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :BLCondo ;
    :ownershipStart "2003-07-01"^^xsd:date ;
    :ownershipEnd "2004-02-05"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

# Residence interval
:BLCondoResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :BLCondo ;
    :residenceStart "2003-07-01"^^xsd:date ;
    :residenceEnd "2004-02-05"^^xsd:date .

# Disposition
:BLCondoDisposition a :Disposition ;
    :involves :BLCondo ;
    :sellDate "2004-02-05"^^xsd:date ;
    :potentialGain 300000 ;
    :partialExclusionReason :EmploymentRelatedReason .

# Single return
:BL2004Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BL ;
    :linkedTo :BLCondoDisposition .