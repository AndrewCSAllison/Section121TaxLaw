@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E079 a :Taxpayer ;
    :owns :E079OwnershipInterval ;
    :uses :E079ResidenceInterval ;
    :disposesOf :E079Disposition .

:E079Townhouse a :Property .

:E079OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E079Townhouse ;
    :ownershipStart "1997-02-10"^^xsd:date ;
    :ownershipEnd "2000-06-12"^^xsd:date .

:E079ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E079Townhouse ;
    :residenceStart "1993-01-01"^^xsd:date ;
    :residenceEnd "1998-04-20"^^xsd:date .

:E079Disposition a :Disposition ;
    :involves :E079Townhouse ;
    :sellDate "2000-06-12"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:E079Return a :SingleReturn ;
    :associates :E079 ;
    :linkedTo :E079Disposition ;
    :exclusionCap "250000"^^xsd:integer .