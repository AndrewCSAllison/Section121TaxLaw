@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#########################
# Property Declaration
#########################
:Townhouse a :Property .

#########################
# Taxpayer Declaration
#########################
:AA a :Taxpayer .

#########################
# Ownership and Residence Intervals
#########################
:AA_Ownership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "1997-02-10"^^xsd:date ;
    :ownershipEnd "2000-06-12"^^xsd:date ;
    :percentageOwned 1.0 .

:AA_Residence1 a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "1995-06-12"^^xsd:date ;
    :residenceEnd "1998-04-20"^^xsd:date .

#########################
# Disposition
#########################
:AA_Disposition1 a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2000-06-12"^^xsd:date ;
    :potentialGain 180000 .

#########################
# Return
#########################
:AA_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AA ;
    :linkedTo :AA_Disposition1 .

#########################
# Linking Taxpayer to Intervals and Disposition
#########################
:AA :owns :AA_Ownership1 ;
    :uses :AA_Residence1 ;
    :disposesOf :AA_Disposition1 .