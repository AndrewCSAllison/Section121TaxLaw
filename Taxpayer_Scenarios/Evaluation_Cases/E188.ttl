@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E188 a :Taxpayer ;
    :owns :E188Ownership ;
    :uses :E188Residence ;
    :disposesOf :E188HouseSale .

:E188House a :Property .

:E188Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E188House ;
    :ownershipStart "2002-02-01"^^xsd:date ;
    :ownershipEnd "2005-08-01"^^xsd:date .

:E188Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E188House ;
    :residenceStart "2002-02-01"^^xsd:date ;
    :residenceEnd "2003-05-01"^^xsd:date .

:E188HouseSale a :Disposition ;
    :involves :E188House ;
    :sellDate "2005-08-01"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E188Return a :SingleReturn ;
    :associates :E188 ;
    :linkedTo :E188HouseSale ;
    :exclusionCap "250000"^^xsd:integer .