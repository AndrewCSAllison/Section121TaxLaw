@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E045 a :Taxpayer ;
    :owns :E045HouseOwnership, :E045LandOwnership ;
    :uses :E045HouseResidence, :E045LandResidence ;
    :disposesOf :E045HouseDisposition, :E045LandDisposition .

:E045House a :Property .

:E045Land a :Property .

:E045HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E045House ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2006-09-10"^^xsd:date .

:E045LandOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E045Land ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2006-09-10"^^xsd:date .

:E045HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E045House ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2006-09-10"^^xsd:date .

:E045LandResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E045Land ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2006-09-10"^^xsd:date .

:E045HouseDisposition a :Disposition ;
    :involves :E045House ;
    :sellDate "2006-09-10"^^xsd:date ;
    :potentialGain "-20000"^^xsd:integer .

:E045LandDisposition a :Disposition ;
    :involves :E045Land ;
    :sellDate "2006-09-10"^^xsd:date ;
    :potentialGain "260000"^^xsd:integer .

:E045Return a :SingleReturn ;
    :associates :E045 ;
    :linkedTo :E045HouseDisposition, :E045LandDisposition ;
    :exclusionCap "250000"^^xsd:integer .