@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E154 a :Taxpayer ;
    :owns :E154TownhouseOwnership, :E154HouseOwnership ;
    :uses :E154TownhouseResidence, :E154HouseResidence ;
    :disposesOf :E154TownhouseDisposition, :E154HouseDisposition .

:E154Townhouse a :Property .

:E154House a :Property .

:E154TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E154Townhouse ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E154TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E154Townhouse ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E154HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E154House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E154HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E154House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E154TownhouseDisposition a :Disposition ;
    :involves :E154Townhouse ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "150000"^^xsd:integer .

:E154HouseDisposition a :Disposition ;
    :involves :E154House ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E154TownhouseReturn a :SingleReturn ;
    :associates :E154 ;
    :linkedTo :E154TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E154HouseReturn a :SingleReturn ;
    :associates :E154 ;
    :linkedTo :E154HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .