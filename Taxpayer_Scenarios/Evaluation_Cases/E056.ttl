@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E056 a :Taxpayer ;
    :owns :E056OwnershipInterval ;
    :uses :E056ResidenceInterval ;
    :disposesOf :E056Disposition .

:E056House a :Property .

:E056OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E056House ;
    :ownershipStart "1992-06-15"^^xsd:date ;
    :ownershipEnd "2001-02-28"^^xsd:date .

:E056ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E056House ;
    :residenceStart "1992-06-15"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E056Disposition a :Disposition ;
    :involves :E056House ;
    :sellDate "2001-02-28"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E056Return a :SingleReturn ;
    :associates :E056 ;
    :linkedTo :E056Disposition ;
    :exclusionCap "250000"^^xsd:integer .