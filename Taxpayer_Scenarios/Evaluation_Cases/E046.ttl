@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E046 a :Taxpayer ;
    :owns :E046Ownership ;
    :uses :E046Residence ;
    :disposesOf :E046Disposition .

:E046House a :Property .

:E046Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E046House ;
    :ownershipStart "1986-01-01"^^xsd:date ;
    :ownershipEnd "2000-04-18"^^xsd:date .

:E046Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E046House ;
    :residenceStart "1986-01-01"^^xsd:date ;
    :residenceEnd "1998-01-31"^^xsd:date .

:E046Disposition a :Disposition ;
    :involves :E046House ;
    :sellDate "2000-04-18"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E046Return a :SingleReturn ;
    :associates :E046 ;
    :linkedTo :E046Disposition ;
    :exclusionCap "250000"^^xsd:integer .