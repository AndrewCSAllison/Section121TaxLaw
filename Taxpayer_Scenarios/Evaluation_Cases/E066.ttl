@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:House a :Property .

:V a :Taxpayer ;
    :owns :V_OwnershipInterval ;
    :uses :V_ResidenceInterval ;
    :disposesOf :HouseDisposition .

:V_OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "1987-02-01"^^xsd:date ;
    :ownershipEnd "1997-12-31"^^xsd:date .

:V_ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1987-02-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2002-06-15"^^xsd:date ;
    :potentialGain 220000 .

:V_SingleReturn a :SingleReturn ;
    :associates :V ;
    :linkedTo :HouseDisposition ;
    :exclusionCap 250000 .