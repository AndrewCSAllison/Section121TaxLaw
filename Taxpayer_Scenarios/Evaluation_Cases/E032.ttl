@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E032 a :Taxpayer ;
    :owns :E032ArizonaOwnership, :E032VirginiaOwnership ;
    :uses :E032ArizonaResidence2003_2004, :E032VirginiaResidence2005_2006, :E032ArizonaResidence2007 ;
    :disposesOf :E032ArizonaDisposition, :E032VirginiaDisposition .

:ArizonaResidence a :Property .

:VirginiaResidence a :Property .

:E032ArizonaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :ArizonaResidence ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2007-12-31"^^xsd:date .

:E032VirginiaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :VirginiaResidence ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2007-12-31"^^xsd:date .

:E032ArizonaResidence2003_2004 a :ResidenceUseInterval ;
    :hasResidenceOf :ArizonaResidence ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E032VirginiaResidence2005_2006 a :ResidenceUseInterval ;
    :hasResidenceOf :VirginiaResidence ;
    :residenceStart "2005-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:E032ArizonaResidence2007 a :ResidenceUseInterval ;
    :hasResidenceOf :ArizonaResidence ;
    :residenceStart "2007-01-01"^^xsd:date ;
    :residenceEnd "2007-12-31"^^xsd:date .

:E032ArizonaDisposition a :Disposition ;
    :involves :ArizonaResidence ;
    :sellDate "2007-12-20"^^xsd:date ;
    :potentialGain "240000"^^xsd:integer .

:E032VirginiaDisposition a :Disposition ;
    :involves :VirginiaResidence ;
    :sellDate "2007-12-20"^^xsd:date ;
    :potentialGain "215000"^^xsd:integer .

:E032Return a :SingleReturn ;
    :associates :E032 ;
    :linkedTo :E032ArizonaDisposition, :E032VirginiaDisposition ;
    :exclusionCap "250000"^^xsd:integer .