@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E107a a :Taxpayer ;
    :owns :E107aOwnership ;
    :uses :E107aResidence ;
    :disposesOf :E107Disposition .

:E107b a :Taxpayer ;
    :owns :E107bOwnership ;
    :uses :E107bResidence ;
    :disposesOf :E107Disposition .

:E107Property a :Property .

:E107aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E107Property ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E107bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E107Property ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E107aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E107Property ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:E107bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E107Property ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:E107Disposition a :Disposition ;
    :involves :E107Property ;
    :sellDate "2022-12-31"^^xsd:date ;
    :potentialGain "256000"^^xsd:integer .

:E107JointReturn a :JointReturn ;
    :associates :E107a, :E107b ;
    :linkedTo :E107Disposition ;
    :exclusionCap "500000"^^xsd:integer .