@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E012 a :Taxpayer ;
    :owns :E012TexasOwnership, :E012CaliforniaOwnership ;
    :uses :E012TexasResidence2000_2001, :E012CaliforniaResidence2002_2003, :E012TexasResidence2004 ;
    :disposesOf :E012TexasDisposition, :E012CaliforniaDisposition .

:E012TexasProperty a :Property .

:E012CaliforniaProperty a :Property .

:E012TexasOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E012TexasProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E012CaliforniaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E012CaliforniaProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E012TexasResidence2000_2001 a :ResidenceUseInterval ;
    :hasResidenceOf :E012TexasProperty ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E012CaliforniaResidence2002_2003 a :ResidenceUseInterval ;
    :hasResidenceOf :E012CaliforniaProperty ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E012TexasResidence2004 a :ResidenceUseInterval ;
    :hasResidenceOf :E012TexasProperty ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E012TexasDisposition a :Disposition ;
    :involves :E012TexasProperty ;
    :sellDate "2004-12-15"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E012CaliforniaDisposition a :Disposition ;
    :involves :E012CaliforniaProperty ;
    :sellDate "2004-12-15"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E012Return a :SingleReturn ;
    :associates :E012 ;
    :linkedTo :E012TexasDisposition, :E012CaliforniaDisposition ;
    :exclusionCap "250000"^^xsd:integer .