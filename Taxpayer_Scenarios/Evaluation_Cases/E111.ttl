@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E111a a :Taxpayer ;
    :owns :E111aOwnership ;
    :uses :E111aResidence ;
    :disposesOf :PropertySale .

:E111b a :Taxpayer ;
    :owns :E111bOwnership ;
    :uses :E111bResidence ;
    :disposesOf :PropertySale .

:MainResidence a :Property .

:E111aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E111bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E111aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:E111bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:PropertySale a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2020-02-28"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E111JointReturn a :JointReturn ;
    :associates :E111a, :E111b ;
    :linkedTo :PropertySale ;
    :exclusionCap "500000"^^xsd:integer .