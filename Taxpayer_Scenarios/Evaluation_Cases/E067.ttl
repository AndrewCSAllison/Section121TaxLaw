@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E067 a :Taxpayer ;
    :owns :E067Ownership1 ;
    :uses :E067Residence1 ;
    :disposesOf :E067Disposition1 .

:E067House a :Property .

:E067Ownership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :E067House ;
    :ownershipStart "1986-05-10"^^xsd:date ;
    :ownershipEnd "2001-09-20"^^xsd:date .

:E067Residence1 a :ResidenceUseInterval ;
    :hasResidenceOf :E067House ;
    :residenceStart "1986-05-10"^^xsd:date ;
    :residenceEnd "1997-01-01"^^xsd:date .

:E067Disposition1 a :Disposition ;
    :involves :E067House ;
    :sellDate "2001-09-20"^^xsd:date ;
    :potentialGain "195000"^^xsd:integer .

:E067SingleReturn a :SingleReturn ;
    :associates :E067 ;
    :linkedTo :E067Disposition1 ;
    :exclusionCap "250000"^^xsd:integer .