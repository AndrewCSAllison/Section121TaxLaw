@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:W a :Taxpayer .

:House a :Property .

:W_OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "1986-05-10"^^xsd:date ;
    :ownershipEnd "2001-09-20"^^xsd:date .

:W_ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1986-05-10"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:SaleDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2001-09-20"^^xsd:date ;
    :potentialGain 195000 ;
    :partialExclusionReason :NonQualifyingReason .

:W_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :W ;
    :linkedTo :SaleDisposition .

:W :owns :W_OwnershipInterval ;
    :uses :W_ResidenceInterval ;
    :disposesOf :SaleDisposition .