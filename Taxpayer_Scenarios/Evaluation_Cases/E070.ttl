@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E070 a :Taxpayer ;
    :owns :E070OwnershipInterval ;
    :uses :E070ResidenceInterval ;
    :disposesOf :E070Disposition .

:E070House a :Property .

:E070OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E070House ;
    :ownershipStart "1988-03-01"^^xsd:date ;
    :ownershipEnd "2003-01-15"^^xsd:date .

:E070ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E070House ;
    :residenceStart "1988-03-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E070Disposition a :Disposition ;
    :involves :E070House ;
    :sellDate "2003-01-15"^^xsd:date ;
    :potentialGain "210000"^^xsd:integer .

:E070SingleReturn a :SingleReturn ;
    :associates :E070 ;
    :linkedTo :E070Disposition ;
    :exclusionCap "250000"^^xsd:integer .