@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Residence1 a :Property .
:Residence2 a :Property .

:AO_1 a :Taxpayer ;
    :owns :AO1Ownership ;
    :uses :AO1ResidenceUse ;
    :disposesOf :AO1Disposition .

:AO_2 a :Taxpayer ;
    :owns :AO2Ownership ;
    :uses :AO2ResidenceUse ;
    :disposesOf :AO2Disposition .

:AO1Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :Residence1 ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "1999-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:AO2Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :Residence2 ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "1999-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:AO1ResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :Residence1 ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:AO2ResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :Residence2 ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:AO1Disposition a :Disposition ;
    :involves :Residence1 ;
    :sellDate "1999-12-31"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:AO2Disposition a :Disposition ;
    :involves :Residence2 ;
    :sellDate "1999-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:JointReturn1999 a :JointReturn ;
    :associates :AO_1, :AO_2 ;
    :linkedTo :AO1Disposition, :AO2Disposition ;
    :exclusionCap "500000"^^xsd:integer .