@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E123a a :Taxpayer ;
    :owns :E123aOwnership ;
    :uses :E123aResidenceUse ;
    :disposesOf :E123aDisposition .

:E123b a :Taxpayer ;
    :owns :E123bOwnership ;
    :uses :E123bResidenceUse ;
    :disposesOf :E123bDisposition .

:E123aProperty a :Property .

:E123bProperty a :Property .

:E123aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E123aProperty ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "1999-12-31"^^xsd:date .

:E123bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E123bProperty ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "1999-12-31"^^xsd:date .

:E123aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E123aProperty ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E123bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E123bProperty ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E123aDisposition a :Disposition ;
    :involves :E123aProperty ;
    :sellDate "1999-12-31"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E123bDisposition a :Disposition ;
    :involves :E123bProperty ;
    :sellDate "1999-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E123JointReturn a :JointReturn ;
    :associates :E123a, :E123b ;
    :linkedTo :E123aDisposition, :E123bDisposition ;
    :exclusionCap "500000"^^xsd:integer .