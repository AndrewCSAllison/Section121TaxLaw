@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E103a a :Taxpayer ;
    :owns :E103aOwnership ;
    :uses :E103aResidenceUse ;
    :disposesOf :HouseSale .

:E103b a :Taxpayer ;
    :owns :E103bOwnership ;
    :uses :E103bResidenceUse ;
    :disposesOf :HouseSale .

:House a :Property .

:E103aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E103bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E103aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:E103bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2012-05-31"^^xsd:date ;
    :potentialGain "256000"^^xsd:integer .

:E103aReturn a :SingleReturn ;
    :associates :E103a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E103bReturn a :SingleReturn ;
    :associates :E103b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .