@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E065 a :Taxpayer ;
    :owns :E065OwnershipInterval ;
    :uses :E065ResidenceInterval ;
    :disposesOf :E065Disposition .

:E065House a :Property .

:E065OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E065House ;
    :ownershipStart "1987-02-01"^^xsd:date ;
    :ownershipEnd "2002-06-15"^^xsd:date .

:E065ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E065House ;
    :residenceStart "1987-02-01"^^xsd:date ;
    :residenceEnd "1998-01-04"^^xsd:date .

:E065Disposition a :Disposition ;
    :involves :E065House ;
    :sellDate "2002-06-15"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E065Return a :SingleReturn ;
    :associates :E065 ;
    :linkedTo :E065Disposition ;
    :exclusionCap "250000"^^xsd:integer .