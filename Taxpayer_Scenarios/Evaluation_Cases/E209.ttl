@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E209 a :Taxpayer ;
    :owns :E209Ownership1 ;
    :uses :E209Residence1 ;
    :disposesOf :E209Disposition1 .

:E209Property a :Property .

:E209Ownership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :E209Property ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date .

:E209Residence1 a :ResidenceUseInterval ;
    :hasResidenceOf :E209Property ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E209Disposition1 a :Disposition ;
    :involves :E209Property ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E209Return a :SingleReturn ;
    :associates :E209 ;
    :linkedTo :E209Disposition1 ;
    :exclusionCap "250000"^^xsd:integer .