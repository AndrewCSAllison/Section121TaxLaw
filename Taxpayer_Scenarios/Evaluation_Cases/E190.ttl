@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E190 a :Taxpayer ;
    :owns :E190CondominiumOwnership ;
    :uses :E190CondominiumResidence ;
    :disposesOf :E190CondominiumDisposition .

:E190Condominium a :Property .

:E190CondominiumOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E190Condominium ;
    :ownershipStart "2003-07-01"^^xsd:date ;
    :ownershipEnd "2004-02-05"^^xsd:date .

:E190CondominiumResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E190Condominium ;
    :residenceStart "2003-07-01"^^xsd:date ;
    :residenceEnd "2004-02-05"^^xsd:date .

:E190CondominiumDisposition a :Disposition ;
    :involves :E190Condominium ;
    :sellDate "2004-02-05"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E190SingleReturn a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :E190 ;
    :linkedTo :E190CondominiumDisposition .