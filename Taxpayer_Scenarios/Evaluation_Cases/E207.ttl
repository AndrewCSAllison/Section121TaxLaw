@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E207 a :Taxpayer ;
    :owns :E207Ownership1 ;
    :uses :E207Residence1 ;
    :disposesOf :E207CondoSale .

:E207Condominium a :Property .

:E207Ownership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :E207Condominium ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2003-09-01"^^xsd:date .

:E207Residence1 a :ResidenceUseInterval ;
    :hasResidenceOf :E207Condominium ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2003-09-01"^^xsd:date .

:E207CondoSale a :Disposition ;
    :involves :E207Condominium ;
    :sellDate "2003-09-01"^^xsd:date ;
    :potentialGain "90000"^^xsd:integer ;
    :partialExclusionReason :UnforeseenCircumstanceReason .

:E207Return a :SingleReturn ;
    :associates :E207 ;
    :linkedTo :E207CondoSale ;
    :exclusionCap "250000"^^xsd:integer .