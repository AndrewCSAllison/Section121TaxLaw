@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E187 a :Taxpayer ;
    :owns :E187Ownership ;
    :uses :E187Residence ;
    :disposesOf :E187Disposition .

:E187House a :Property .

:E187Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E187House ;
    :ownershipStart "2002-02-01"^^xsd:date ;
    :ownershipEnd "2005-08-01"^^xsd:date .

:E187Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E187House ;
    :residenceStart "2002-02-01"^^xsd:date ;
    :residenceEnd "2003-05-01"^^xsd:date .

:E187Disposition a :Disposition ;
    :involves :E187House ;
    :sellDate "2005-08-01"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E187Return a :SingleReturn ;
    :associates :E187 ;
    :linkedTo :E187Disposition ;
    :exclusionCap "250000"^^xsd:integer .