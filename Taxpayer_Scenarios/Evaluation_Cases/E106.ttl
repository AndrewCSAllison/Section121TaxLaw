@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E106a a :Taxpayer ;
    :owns :E106aOwnership ;
    :uses :E106aResidence ;
    :disposesOf :E106Disposition .

:E106b a :Taxpayer ;
    :owns :E106bOwnership ;
    :uses :E106bResidence ;
    :disposesOf :E106Disposition .

:E106Property a :Property .

:E106aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E106Property ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E106bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E106Property ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E106aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E106Property ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:E106bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E106Property ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:E106Disposition a :Disposition ;
    :involves :E106Property ;
    :sellDate "2022-12-31"^^xsd:date ;
    :potentialGain "256000"^^xsd:integer .

:E106JointReturn a :JointReturn ;
    :associates :E106a, :E106b ;
    :linkedTo :E106Disposition ;
    :exclusionCap "500000"^^xsd:integer .