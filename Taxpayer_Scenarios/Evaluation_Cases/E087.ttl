@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E087 a :Taxpayer ;
    :owns :E087OwnershipInterval ;
    :uses :E087ResidenceInterval ;
    :disposesOf :E087Disposition .

:E087Townhouse a :Property .

:E087OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E087Townhouse ;
    :ownershipStart "1997-04-01"^^xsd:date ;
    :ownershipEnd "2000-09-09"^^xsd:date .

:E087ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E087Townhouse ;
    :residenceStart "1995-09-09"^^xsd:date ;
    :residenceEnd "1998-06-15"^^xsd:date .

:E087Disposition a :Disposition ;
    :involves :E087Townhouse ;
    :sellDate "2000-09-09"^^xsd:date ;
    :potentialGain "245000"^^xsd:integer .

:E087SingleReturn a :SingleReturn ;
    :associates :E087 ;
    :linkedTo :E087Disposition ;
    :exclusionCap "250000"^^xsd:integer .