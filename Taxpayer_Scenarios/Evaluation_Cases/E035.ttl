@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E035 a :Taxpayer ;
    :owns :E035HouseOwnership, :E035LandOwnership ;
    :uses :E035HouseResidence, :E035LandResidence ;
    :disposesOf :E035HouseDisposition, :E035LandDisposition .

:E035House a :Property .

:E035Land a :Property .

:E035HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E035House ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2003-06-15"^^xsd:date .

:E035LandOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E035Land ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2003-06-15"^^xsd:date .

:E035HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E035House ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2003-06-15"^^xsd:date .

:E035LandResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E035Land ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2003-06-15"^^xsd:date .

:E035HouseDisposition a :Disposition ;
    :involves :E035House ;
    :sellDate "2003-06-15"^^xsd:date ;
    :potentialGain "-25000"^^xsd:integer .

:E035LandDisposition a :Disposition ;
    :involves :E035Land ;
    :sellDate "2003-06-15"^^xsd:date ;
    :potentialGain "270000"^^xsd:integer .

:E035Return a :SingleReturn ;
    :associates :E035 ;
    :linkedTo :E035HouseDisposition, :E035LandDisposition ;
    :exclusionCap "250000"^^xsd:integer .