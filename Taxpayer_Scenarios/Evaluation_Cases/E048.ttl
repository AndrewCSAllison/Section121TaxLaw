@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E048 a :Taxpayer ;
    :owns :E048Ownership ;
    :uses :E048Residence ;
    :disposesOf :E048Disposition .

:E048House a :Property .

:E048Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E048House ;
    :ownershipStart "1986-01-01"^^xsd:date ;
    :ownershipEnd "2000-04-18"^^xsd:date .

:E048Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E048House ;
    :residenceStart "1986-01-01"^^xsd:date ;
    :residenceEnd "1998-01-31"^^xsd:date .

:E048Disposition a :Disposition ;
    :involves :E048House ;
    :sellDate "2000-04-18"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E048Return a :SingleReturn ;
    :associates :E048 ;
    :linkedTo :E048Disposition ;
    :exclusionCap "250000"^^xsd:integer .