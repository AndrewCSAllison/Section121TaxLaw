@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:BQ a :Taxpayer .

:MainResidence a :Property .

:OwnershipInterval1 a :OwnershipUseInterval ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2003-09-01"^^xsd:date ;
    :hasOwnershipOf :MainResidence .

:ResidenceInterval1 a :ResidenceUseInterval ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2003-09-01"^^xsd:date ;
    :hasResidenceOf :MainResidence .

:Disposition1 a :Disposition ;
    :sellDate "2003-09-01"^^xsd:date ;
    :potentialGain 90000 ;
    :involves :MainResidence ;
    :partialExclusionReason :UnforeseenCircumstanceReason .

:SingleReturn1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BQ ;
    :linkedTo :Disposition1 .

:BQ :owns :OwnershipInterval1 ;
    :uses :ResidenceInterval1 ;
    :disposesOf :Disposition1 .