@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E205 a :Taxpayer ;
    :owns :E205Ownership ;
    :uses :E205Residence ;
    :disposesOf :CondominiumSale .

:Condominium a :Property .

:E205Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :Condominium ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2003-09-01"^^xsd:date .

:E205Residence a :ResidenceUseInterval ;
    :hasResidenceOf :Condominium ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2003-09-01"^^xsd:date .

:CondominiumSale a :Disposition ;
    :involves :Condominium ;
    :sellDate "2003-09-01"^^xsd:date ;
    :potentialGain "90000"^^xsd:integer ;
    :partialExclusionReason :UnforeseenCircumstanceReason .

:E205Return a :SingleReturn ;
    :associates :E205 ;
    :linkedTo :CondominiumSale ;
    :exclusionCap "250000"^^xsd:integer .