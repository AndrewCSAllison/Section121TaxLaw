@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:MainResidence a :Property .

:E115a a :Taxpayer ;
    :owns :E115aOwnership ;
    :uses :E115aResidence ;
    :disposesOf :Sale .

:E115b a :Taxpayer ;
    :owns :E115bOwnership ;
    :uses :E115bResidence ;
    :disposesOf :Sale .

:E115aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E115bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E115aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:E115bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:Sale a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2014-08-31"^^xsd:date ;
    :potentialGain "600000"^^xsd:integer .

:JointReturn a :JointReturn ;
    :associates :E115a, :E115b ;
    :linkedTo :Sale ;
    :exclusionCap "500000"^^xsd:integer .