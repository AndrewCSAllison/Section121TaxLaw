@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E173 a :Taxpayer ;
    :owns :E173TownhouseOwnership, :E173HouseOwnership ;
    :uses :E173TownhouseResidence, :E173HouseResidence ;
    :disposesOf :E173TownhouseDisposition, :E173HouseDisposition .

:E173Townhouse a :Property .

:E173House a :Property .

:E173TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E173Townhouse ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E173TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E173Townhouse ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E173HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E173House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E173HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E173House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:E173TownhouseDisposition a :Disposition ;
    :involves :E173Townhouse ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain "210000"^^xsd:integer .

:E173HouseDisposition a :Disposition ;
    :involves :E173House ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain "290000"^^xsd:integer .

:E173TownhouseReturn a :SingleReturn ;
    :associates :E173 ;
    :linkedTo :E173TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E173HouseReturn a :SingleReturn ;
    :associates :E173 ;
    :linkedTo :E173HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .