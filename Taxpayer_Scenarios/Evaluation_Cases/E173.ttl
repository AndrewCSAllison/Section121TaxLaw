@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#########################
# Properties
#########################
:Townhouse a :Property .
:House a :Property .

#########################
# Taxpayer
#########################
:BF a :Taxpayer .

#########################
# Ownership and Residence Intervals
#########################
:BF_Own_Townhouse a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BF_Use_Townhouse a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:BF_Own_House a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BF_Use_House a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

#########################
# Dispositions
#########################
:Disp_Townhouse a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain 210000 .

:Disp_House a :Disposition ;
    :involves :House ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain 290000 .

#########################
# Returns
#########################
:Return_Townhouse a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BF ;
    :linkedTo :Disp_Townhouse .

:Return_House a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BF ;
    :linkedTo :Disp_House .

#########################
# Links
#########################
:BF :owns :BF_Own_Townhouse, :BF_Own_House ;
    :uses :BF_Use_Townhouse, :BF_Use_House ;
    :disposesOf :Disp_Townhouse, :Disp_House .