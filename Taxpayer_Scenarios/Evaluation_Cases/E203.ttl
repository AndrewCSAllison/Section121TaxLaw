@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E203a a :Taxpayer ;
    :disposesOf :MichiganHouseSale ;
    :owns :E203aMichiganOwnership ;
    :uses :E203aMichiganResidence .

:E203b a :Taxpayer ;
    :disposesOf :MichiganHouseSale ;
    :owns :E203bMichiganOwnership ;
    :uses :E203bMichiganResidence .

:MichiganHouse a :Property .

:E203aMichiganOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MichiganHouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E203bMichiganOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MichiganHouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E203aMichiganResidence a :ResidenceUseInterval ;
    :hasResidenceOf :MichiganHouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E203bMichiganResidence a :ResidenceUseInterval ;
    :hasResidenceOf :MichiganHouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:MichiganHouseSale a :Disposition ;
    :involves :MichiganHouse ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "120000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E203JointReturn a :JointReturn ;
    :associates :E203a, :E203b ;
    :linkedTo :MichiganHouseSale ;
    :exclusionCap "500000"^^xsd:integer .