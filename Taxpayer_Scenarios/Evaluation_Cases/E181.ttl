:BI a :Taxpayer .

:Townhouse a :Property .

:BI_OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date ;
    :percentageOwned 1.0 .

:BI_ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:BI_Disposition a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain 250000 ;
    :partialExclusionReason :EmploymentRelatedReason .

:BI_Return a :SingleReturn ;
    :associates :BI ;
    :linkedTo :BI_Disposition ;
    :exclusionCap 250000 .

:BI :owns :BI_OwnershipInterval ;
    :uses :BI_ResidenceInterval ;
    :disposesOf :BI_Disposition . 