@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E181 a :Taxpayer ;
    :owns :E181Ownership ;
    :uses :E181Residence ;
    :disposesOf :E181Sale .

:E181Townhouse a :Property .

:E181Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E181Townhouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date .

:E181Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E181Townhouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:E181Sale a :Disposition ;
    :involves :E181Townhouse ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:EmploymentRelatedReason a :ReasonType .

:E181Return a :Return ;
    :associates :E181 ;
    :linkedTo :E181Sale .