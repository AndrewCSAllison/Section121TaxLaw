@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E150a a :Taxpayer ;
    :owns :E150aOwnership ;
    :disposesOf :ResidenceSale .

:E150b a :Taxpayer ;
    :owns :E150bOwnership ;
    :uses :E150bResidenceUse ;
    :disposesOf :ResidenceSale .

:MainResidence a :Property .

:E150aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2003-02-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E150bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2003-02-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E150bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2003-02-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:ResidenceSale a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2006-12-31"^^xsd:date ;
    :potentialGain "320000"^^xsd:integer .

:JointReturn a :JointReturn ;
    :associates :E150a, :E150b ;
    :linkedTo :ResidenceSale ;
    :exclusionCap "500000"^^xsd:integer .