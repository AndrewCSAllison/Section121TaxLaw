@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E196a a :Taxpayer ;
    :owns :E196aOwnership ;
    :uses :E196aResidence ;
    :disposesOf :HouseSale .

:E196b a :Taxpayer ;
    :owns :E196bOwnership ;
    :uses :E196bResidence ;
    :disposesOf :HouseSale .

:PrincipalResidence a :Property .

:E196aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :PrincipalResidence ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E196bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :PrincipalResidence ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E196aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :PrincipalResidence ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E196bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :PrincipalResidence ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :PrincipalResidence ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer ;
    :partialExclusionReason :HealthRelatedReason .

:JointReturn a :JointReturn ;
    :associates :E196a, :E196b ;
    :linkedTo :HouseSale ;
    :exclusionCap "500000"^^xsd:integer .