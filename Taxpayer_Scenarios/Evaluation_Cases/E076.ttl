@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E076 a :Taxpayer ;
    :owns :E076TownhouseOwnership ;
    :uses :E076TownhouseResidence ;
    :disposesOf :E076TownhouseDisposition .

:E076Townhouse a :Property .

:E076TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E076Townhouse ;
    :ownershipStart "1997-01-18"^^xsd:date ;
    :ownershipEnd "2000-05-25"^^xsd:date .

:E076TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E076Townhouse ;
    :residenceStart "1993-01-01"^^xsd:date ;
    :residenceEnd "1998-02-01"^^xsd:date .

:E076TownhouseDisposition a :Disposition ;
    :involves :E076Townhouse ;
    :sellDate "2000-05-25"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:E076SingleReturn a :SingleReturn ;
    :associates :E076 ;
    :linkedTo :E076TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .