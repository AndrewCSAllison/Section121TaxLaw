@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Residence a :Property .

:E137a a :Taxpayer ;
    :owns :E137aOwnership ;
    :disposesOf :ResidenceSale .

:E137b a :Taxpayer ;
    :owns :E137bOwnership ;
    :uses :E137bResidenceUse ;
    :disposesOf :ResidenceSale .

:E137aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :Residence ;
    :ownershipStart "2000-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E137bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :Residence ;
    :ownershipStart "2000-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E137bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :Residence ;
    :residenceStart "2000-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:ResidenceSale a :Disposition ;
    :involves :Residence ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:JointReturn2003 a :JointReturn ;
    :associates :E137a, :E137b ;
    :linkedTo :ResidenceSale ;
    :exclusionCap "500000"^^xsd:integer .