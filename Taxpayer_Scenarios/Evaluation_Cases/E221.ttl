@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E221 a :Taxpayer ;
    :owns :E221CondoOwnership ;
    :uses :E221CondoResidence ;
    :disposesOf :E221CondoDisposition .

:E221Condominium a :Property .

:E221CondoOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E221Condominium ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date .

:E221CondoResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E221Condominium ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:E221CondoDisposition a :Disposition ;
    :involves :E221Condominium ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain "190000"^^xsd:integer ;
    :partialExclusionReason :UnforeseenCircumstanceReason .

:E221Return a :SingleReturn ;
    :associates :E221 ;
    :linkedTo :E221CondoDisposition ;
    :exclusionCap "250000"^^xsd:integer .