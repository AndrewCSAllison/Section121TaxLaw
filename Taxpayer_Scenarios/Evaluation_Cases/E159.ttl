@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E159 a :Taxpayer ;
    :owns :E159TownhouseOwnership, :E159HouseOwnership ;
    :uses :E159TownhouseResidence, :E159HouseResidence ;
    :disposesOf :E159TownhouseDisposition, :E159HouseDisposition .

:E159Townhouse a :Property .

:E159House a :Property .

:E159TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E159Townhouse ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E159TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E159Townhouse ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E159HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E159House ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E159HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E159House ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E159TownhouseDisposition a :Disposition ;
    :involves :E159Townhouse ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:E159HouseDisposition a :Disposition ;
    :involves :E159House ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain "320000"^^xsd:integer .

:E159TownhouseReturn a :SingleReturn ;
    :associates :E159 ;
    :linkedTo :E159TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E159HouseReturn a :SingleReturn ;
    :associates :E159 ;
    :linkedTo :E159HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .