@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E102House a :Property .

:E102a a :Taxpayer ;
    :owns :E102aOwnership ;
    :uses :E102aResidence ;
    :disposesOf :E102Disposition .

:E102b a :Taxpayer ;
    :owns :E102bOwnership ;
    :uses :E102bResidence ;
    :disposesOf :E102Disposition .

:E102aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E102House ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E102bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E102House ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E102aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E102House ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:E102bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E102House ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:E102Disposition a :Disposition ;
    :involves :E102House ;
    :sellDate "2014-08-31"^^xsd:date ;
    :potentialGain "720000"^^xsd:integer .

:E102aReturn a :SingleReturn ;
    :associates :E102a ;
    :linkedTo :E102Disposition ;
    :exclusionCap "250000"^^xsd:integer .

:E102bReturn a :SingleReturn ;
    :associates :E102b ;
    :linkedTo :E102Disposition ;
    :exclusionCap "250000"^^xsd:integer .