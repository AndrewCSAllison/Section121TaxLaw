@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E091a a :Taxpayer ;
    :owns :E091aOwnership ;
    :uses :E091aResidence ;
    :disposesOf :HouseSale .

:E091b a :Taxpayer ;
    :owns :E091bOwnership ;
    :uses :E091bResidence ;
    :disposesOf :HouseSale .

:House a :Property .

:E091aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E091bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E091aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:E091bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2022-12-31"^^xsd:date ;
    :potentialGain "256000"^^xsd:integer .

:E091aReturn a :SingleReturn ;
    :associates :E091a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E091bReturn a :SingleReturn ;
    :associates :E091b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .