@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E071 a :Taxpayer ;
    :owns :E071Ownership ;
    :uses :E071Residence ;
    :disposesOf :E071Disposition .

:House a :Property .

:E071Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "1988-03-01"^^xsd:date ;
    :ownershipEnd "2003-01-15"^^xsd:date .

:E071Residence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1988-03-01"^^xsd:date ;
    :residenceEnd "1998-01-04"^^xsd:date .

:E071Disposition a :Disposition ;
    :involves :House ;
    :sellDate "2003-01-15"^^xsd:date ;
    :potentialGain "210000"^^xsd:integer .

:E071Return a :SingleReturn ;
    :associates :E071 ;
    :linkedTo :E071Disposition ;
    :exclusionCap "250000"^^xsd:integer .