@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E229a a :Taxpayer ;
    :owns :E229aOwnership ;
    :uses :E229aResidence ;
    :disposesOf :HouseSale .

:E229b a :Taxpayer ;
    :uses :E229bResidence ;
    :disposesOf :HouseSale .

:House a :Property .

:E229aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "2000-01-15"^^xsd:date .

:E229aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "2000-01-15"^^xsd:date .

:E229bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1999-01-15"^^xsd:date ;
    :residenceEnd "2000-01-15"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2000-01-15"^^xsd:date ;
    :potentialGain "500000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E229JointReturn a :JointReturn ;
    :associates :E229a, :E229b ;
    :linkedTo :HouseSale ;
    :exclusionCap "500000"^^xsd:integer .