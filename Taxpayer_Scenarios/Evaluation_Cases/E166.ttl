@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E166 a :Taxpayer ;
    :owns :E166TownhouseOwnership, :E166HouseOwnership ;
    :uses :E166TownhouseResidence, :E166HouseResidence ;
    :disposesOf :E166TownhouseDisposition, :E166HouseDisposition .

:E166Townhouse a :Property .

:E166House a :Property .

:E166TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E166Townhouse ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E166TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E166Townhouse ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E166HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E166House ;
    :ownershipStart "2004-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E166HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E166House ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:E166TownhouseDisposition a :Disposition ;
    :involves :E166Townhouse ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer .

:E166HouseDisposition a :Disposition ;
    :involves :E166House ;
    :sellDate "2006-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E166TownhouseReturn a :SingleReturn ;
    :associates :E166 ;
    :linkedTo :E166TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E166HouseReturn a :SingleReturn ;
    :associates :E166 ;
    :linkedTo :E166HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .