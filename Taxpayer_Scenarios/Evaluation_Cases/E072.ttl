@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E072 a :Taxpayer ;
    :owns :E072Ownership ;
    :uses :E072Residence ;
    :disposesOf :E072Disposition .

:House a :Property .

:E072Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "1988-03-01"^^xsd:date ;
    :ownershipEnd "2003-01-15"^^xsd:date .

:E072Residence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1988-03-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E072Disposition a :Disposition ;
    :involves :House ;
    :sellDate "2003-01-15"^^xsd:date ;
    :potentialGain "210000"^^xsd:integer .

:E072Return a :SingleReturn ;
    :associates :E072 ;
    :linkedTo :E072Disposition ;
    :exclusionCap "250000"^^xsd:integer .