@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E059 a :Taxpayer ;
    :owns :E059OwnershipInterval ;
    :uses :E059ResidenceInterval ;
    :disposesOf :E059Disposition .

:E059House a :Property .

:E059OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E059House ;
    :ownershipStart "1988-09-01"^^xsd:date ;
    :ownershipEnd "2003-05-10"^^xsd:date .

:E059ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E059House ;
    :residenceStart "1988-09-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:E059Disposition a :Disposition ;
    :involves :E059House ;
    :sellDate "2003-05-10"^^xsd:date ;
    :potentialGain "195000"^^xsd:integer .

:E059Return a :SingleReturn ;
    :associates :E059 ;
    :linkedTo :E059Disposition ;
    :exclusionCap "250000"^^xsd:integer .