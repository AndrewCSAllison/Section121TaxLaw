@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E128a a :Taxpayer ;
    :owns :E128aOwnership ;
    :uses :E128aResidenceUse ;
    :disposesOf :E128aDisposition .

:E128b a :Taxpayer ;
    :owns :E128bOwnership ;
    :uses :E128bResidenceUse ;
    :disposesOf :E128bDisposition .

:E128aProperty a :Property .

:E128bProperty a :Property .

:E128aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E128aProperty ;
    :ownershipStart "1998-02-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E128bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E128bProperty ;
    :ownershipStart "1998-02-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E128aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E128aProperty ;
    :residenceStart "1998-02-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E128bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E128bProperty ;
    :residenceStart "1998-02-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E128aDisposition a :Disposition ;
    :involves :E128aProperty ;
    :sellDate "2001-12-31"^^xsd:date ;
    :potentialGain "240000"^^xsd:integer .

:E128bDisposition a :Disposition ;
    :involves :E128bProperty ;
    :sellDate "2001-12-31"^^xsd:date ;
    :potentialGain "260000"^^xsd:integer .

:E128JointReturn a :JointReturn ;
    :associates :E128a, :E128b ;
    :linkedTo :E128aDisposition, :E128bDisposition ;
    :exclusionCap "500000"^^xsd:integer .