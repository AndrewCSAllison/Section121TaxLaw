@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E093a a :Taxpayer ;
    :owns :E093aOwnership ;
    :uses :E093aResidence ;
    :disposesOf :HouseSale .

:E093b a :Taxpayer ;
    :owns :E093bOwnership ;
    :uses :E093bResidence ;
    :disposesOf :HouseSale .

:House a :Property .

:E093aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E093bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E093aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:E093bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2022-12-31"^^xsd:date ;
    :potentialGain "256000"^^xsd:integer .

:E093aReturn a :SingleReturn ;
    :associates :E093a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E093bReturn a :SingleReturn ;
    :associates :E093b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .