@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E027 a :Taxpayer ;
    :owns :E027AlabamaOwnership, :E027NevadaOwnership ;
    :uses :E027AlabamaResidence1997_1998, :E027NevadaResidence1999_2000, :E027AlabamaResidence2001 ;
    :disposesOf :E027AlabamaDisposition, :E027NevadaDisposition .

:E027AlabamaProperty a :Property .

:E027NevadaProperty a :Property .

:E027AlabamaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E027AlabamaProperty ;
    :ownershipStart "1997-01-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date .

:E027NevadaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E027NevadaProperty ;
    :ownershipStart "1997-01-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date .

:E027AlabamaResidence1997_1998 a :ResidenceUseInterval ;
    :hasResidenceOf :E027AlabamaProperty ;
    :residenceStart "1997-01-01"^^xsd:date ;
    :residenceEnd "1998-12-31"^^xsd:date .

:E027NevadaResidence1999_2000 a :ResidenceUseInterval ;
    :hasResidenceOf :E027NevadaProperty ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:E027AlabamaResidence2001 a :ResidenceUseInterval ;
    :hasResidenceOf :E027AlabamaProperty ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E027AlabamaDisposition a :Disposition ;
    :involves :E027AlabamaProperty ;
    :sellDate "2001-12-20"^^xsd:date ;
    :potentialGain "225000"^^xsd:integer .

:E027NevadaDisposition a :Disposition ;
    :involves :E027NevadaProperty ;
    :sellDate "2001-12-20"^^xsd:date ;
    :potentialGain "205000"^^xsd:integer .

:E027SingleReturn a :SingleReturn ;
    :associates :E027 ;
    :linkedTo :E027AlabamaDisposition, :E027NevadaDisposition ;
    :exclusionCap "250000"^^xsd:integer .