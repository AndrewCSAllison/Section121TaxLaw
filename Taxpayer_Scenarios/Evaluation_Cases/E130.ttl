@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E130a a :Taxpayer ;
    :owns :E130aOwnership ;
    :uses :E130aResidenceUse ;
    :disposesOf :E130aDisposition .

:E130b a :Taxpayer ;
    :owns :E130bOwnership ;
    :uses :E130bResidenceUse ;
    :disposesOf :E130bDisposition .

:E130aProperty a :Property .

:E130bProperty a :Property .

:E130aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E130aProperty ;
    :ownershipStart "2001-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E130bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E130bProperty ;
    :ownershipStart "2001-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E130aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E130aProperty ;
    :residenceStart "2001-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E130bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E130bProperty ;
    :residenceStart "2001-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E130aDisposition a :Disposition ;
    :involves :E130aProperty ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E130bDisposition a :Disposition ;
    :involves :E130bProperty ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "310000"^^xsd:integer .

:E130JointReturn a :JointReturn ;
    :associates :E130a, :E130b ;
    :linkedTo :E130aDisposition, :E130bDisposition ;
    :exclusionCap "500000"^^xsd:integer .