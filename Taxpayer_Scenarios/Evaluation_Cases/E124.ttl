@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E124a a :Taxpayer ;
    :owns :E124aOwnership ;
    :uses :E124aResidenceUse ;
    :disposesOf :E124aDisposition .

:E124b a :Taxpayer ;
    :owns :E124bOwnership ;
    :uses :E124bResidenceUse ;
    :disposesOf :E124bDisposition .

:E124aProperty a :Property .

:E124bProperty a :Property .

:E124aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E124aProperty ;
    :ownershipStart "2000-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E124bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E124bProperty ;
    :ownershipStart "2000-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E124aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E124aProperty ;
    :residenceStart "2000-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E124bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E124bProperty ;
    :residenceStart "2000-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E124aDisposition a :Disposition ;
    :involves :E124aProperty ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E124bDisposition a :Disposition ;
    :involves :E124bProperty ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "280000"^^xsd:integer .

:E124JointReturn a :JointReturn ;
    :associates :E124a, :E124b ;
    :linkedTo :E124aDisposition, :E124bDisposition ;
    :exclusionCap "500000"^^xsd:integer .