@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E109a a :Taxpayer ;
    :disposesOf :E109Disposition ;
    :owns :E109aOwnership ;
    :uses :E109aResidence .

:E109b a :Taxpayer ;
    :disposesOf :E109Disposition ;
    :owns :E109bOwnership ;
    :uses :E109bResidence .

:E109Property a :Property .

:E109aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E109Property ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date .

:E109bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E109Property ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date .

:E109aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E109Property ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:E109bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E109Property ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:E109Disposition a :Disposition ;
    :involves :E109Property ;
    :sellDate "2020-02-28"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E109JointReturn a :JointReturn ;
    :associates :E109a, :E109b ;
    :linkedTo :E109Disposition ;
    :exclusionCap "500000"^^xsd:integer .