@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E083 a :Taxpayer ;
    :owns :E083OwnershipInterval ;
    :uses :E083ResidenceInterval ;
    :disposesOf :E083TownhouseSale .

:E083Townhouse a :Property .

:E083OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E083Townhouse ;
    :ownershipStart "1996-11-05"^^xsd:date ;
    :ownershipEnd "2000-03-01"^^xsd:date .

:E083ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E083Townhouse ;
    :residenceStart "1995-03-01"^^xsd:date ;
    :residenceEnd "1998-01-30"^^xsd:date .

:E083TownhouseSale a :Disposition ;
    :involves :E083Townhouse ;
    :sellDate "2000-03-01"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E083SingleReturn a :SingleReturn ;
    :associates :E083 ;
    :linkedTo :E083TownhouseSale ;
    :exclusionCap "250000"^^xsd:integer .