@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E168 a :Taxpayer ;
    :owns :E168TownhouseOwnership, :E168HouseOwnership ;
    :uses :E168TownhouseResidence, :E168HouseResidence ;
    :disposesOf :E168TownhouseDisposition, :E168HouseDisposition .

:E168Townhouse a :Property .

:E168House a :Property .

:E168TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E168Townhouse ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E168TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E168Townhouse ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E168HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E168House ;
    :ownershipStart "2004-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E168HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E168House ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:E168TownhouseDisposition a :Disposition ;
    :involves :E168Townhouse ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer .

:E168HouseDisposition a :Disposition ;
    :involves :E168House ;
    :sellDate "2006-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E168TownhouseReturn a :SingleReturn ;
    :associates :E168 ;
    :linkedTo :E168TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E168HouseReturn a :SingleReturn ;
    :associates :E168 ;
    :linkedTo :E168HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .