@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:BD a :Taxpayer .

:Townhouse a :Property .
:House a :Property .

:BD_Townhouse_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BD_Townhouse_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:BD_House_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2004-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BD_House_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:Disposition_Townhouse a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain 250000 .

:Disposition_House a :Disposition ;
    :involves :House ;
    :sellDate "2006-12-31"^^xsd:date ;
    :potentialGain 300000 .

:Return_Townhouse a :SingleReturn ;
    :associates :BD ;
    :linkedTo :Disposition_Townhouse ;
    :exclusionCap 250000 .

:Return_House a :SingleReturn ;
    :associates :BD ;
    :linkedTo :Disposition_House ;
    :exclusionCap 250000 .

:BD :owns :BD_Townhouse_Ownership , :BD_House_Ownership ;
    :uses :BD_Townhouse_Residence , :BD_House_Residence ;
    :disposesOf :Disposition_Townhouse , :Disposition_House .