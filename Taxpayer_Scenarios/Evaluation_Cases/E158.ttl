@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E158 a :Taxpayer ;
    :owns :E158TownhouseOwnership, :E158HouseOwnership ;
    :uses :E158TownhouseResidence, :E158HouseResidence ;
    :disposesOf :E158TownhouseDisposition, :E158HouseDisposition .

:E158Townhouse a :Property .

:E158House a :Property .

:E158TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E158Townhouse ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E158TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E158Townhouse ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E158HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E158House ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E158HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E158House ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E158TownhouseDisposition a :Disposition ;
    :involves :E158Townhouse ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:E158HouseDisposition a :Disposition ;
    :involves :E158House ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain "320000"^^xsd:integer .

:E158TownhouseReturn a :SingleReturn ;
    :associates :E158 ;
    :linkedTo :E158TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E158HouseReturn a :SingleReturn ;
    :associates :E158 ;
    :linkedTo :E158HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .