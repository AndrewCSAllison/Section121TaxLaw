:BU a :Taxpayer .

:BUHouse a :Property .

:BUOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :BUHouse ;
    :ownershipStart "2003-04-01"^^xsd:date ;
    :ownershipEnd "2004-10-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BUResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :BUHouse ;
    :residenceStart "2003-04-01"^^xsd:date ;
    :residenceEnd "2004-10-31"^^xsd:date .

:BUSale a :Disposition ;
    :involves :BUHouse ;
    :sellDate "2004-10-31"^^xsd:date ;
    :potentialGain 95000 .

:BUSingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BU ;
    :linkedTo :BUSale .

:BU :owns :BUOwnershipInterval ;
    :uses :BUResidenceInterval ;
    :disposesOf :BUSale .