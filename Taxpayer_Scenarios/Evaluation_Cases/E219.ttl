@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E219 a :Taxpayer ;
    :owns :E219Ownership1 ;
    :uses :E219Residence1 ;
    :disposesOf :E219Disposition1 .

:E219House a :Property .

:E219Ownership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :E219House ;
    :ownershipStart "2003-04-01"^^xsd:date ;
    :ownershipEnd "2004-10-31"^^xsd:date .

:E219Residence1 a :ResidenceUseInterval ;
    :hasResidenceOf :E219House ;
    :residenceStart "2003-04-01"^^xsd:date ;
    :residenceEnd "2004-10-31"^^xsd:date .

:E219Disposition1 a :Disposition ;
    :involves :E219House ;
    :sellDate "2004-10-31"^^xsd:date ;
    :potentialGain "95000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E219Return a :SingleReturn ;
    :associates :E219 ;
    :linkedTo :E219Disposition1 ;
    :exclusionCap "250000"^^xsd:integer .

:NonQualifyingReason a :ReasonType .