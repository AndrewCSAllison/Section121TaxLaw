@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E097House a :Property .

:E097a a :Taxpayer ;
    :owns :E097aOwnership ;
    :uses :E097aResidenceUse ;
    :disposesOf :E097Sale .

:E097b a :Taxpayer ;
    :owns :E097bOwnership ;
    :uses :E097bResidenceUse ;
    :disposesOf :E097Sale .

:E097aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E097House ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E097bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E097House ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E097aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E097House ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:E097bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E097House ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:E097Sale a :Disposition ;
    :involves :E097House ;
    :sellDate "2017-05-14"^^xsd:date ;
    :potentialGain "540000"^^xsd:integer .

:E097aReturn a :SingleReturn ;
    :associates :E097a ;
    :linkedTo :E097Sale ;
    :exclusionCap "250000"^^xsd:integer .

:E097bReturn a :SingleReturn ;
    :associates :E097b ;
    :linkedTo :E097Sale ;
    :exclusionCap "250000"^^xsd:integer .