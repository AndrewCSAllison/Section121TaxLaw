@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E060 a :Taxpayer ;
    :owns :E060Ownership ;
    :uses :E060Residence ;
    :disposesOf :E060Disposition .

:E060House a :Property .

:E060Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E060House ;
    :ownershipStart "1988-09-01"^^xsd:date ;
    :ownershipEnd "2003-05-10"^^xsd:date .

:E060Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E060House ;
    :residenceStart "1988-09-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:E060Disposition a :Disposition ;
    :involves :E060House ;
    :sellDate "2003-05-10"^^xsd:date ;
    :potentialGain "195000"^^xsd:integer .

:E060Return a :SingleReturn ;
    :associates :E060 ;
    :linkedTo :E060Disposition ;
    :exclusionCap "250000"^^xsd:integer .