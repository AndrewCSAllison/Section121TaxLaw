@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E183 a :Taxpayer ;
    :owns :E183TownhouseOwnership ;
    :uses :E183TownhouseResidence ;
    :disposesOf :E183TownhouseDisposition .

:E183Townhouse a :Property .

:E183TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E183Townhouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date .

:E183TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E183Townhouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:E183TownhouseDisposition a :Disposition ;
    :involves :E183Townhouse ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E183Return a :SingleReturn ;
    :associates :E183 ;
    :linkedTo :E183TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .