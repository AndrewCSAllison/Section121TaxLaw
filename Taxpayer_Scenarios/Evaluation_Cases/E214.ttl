:BT a :Taxpayer .

:BTCondo a :Property .

:BT_Ownership_Interval a :OwnershipUseInterval ;
    :hasOwnershipOf :BTCondo ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date ;
    :percentageOwned 1.0 .

:BT_Residence_Interval a :ResidenceUseInterval ;
    :hasResidenceOf :BTCondo ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:BTDisposition a :Disposition ;
    :involves :BTCondo ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain 80000 .

:BTSingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BT ;
    :linkedTo :BTDisposition .

:BT :owns :BT_Ownership_Interval ;
    :uses :BT_Residence_Interval ;
    :disposesOf :BTDisposition .