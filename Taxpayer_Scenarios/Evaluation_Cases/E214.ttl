@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E214 a :Taxpayer ;
    :owns :E214CondoOwnership ;
    :uses :E214CondoResidence ;
    :disposesOf :E214CondoDisposition .

:E214Condominium a :Property .

:E214CondoOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E214Condominium ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date .

:E214CondoResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E214Condominium ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:E214CondoDisposition a :Disposition ;
    :involves :E214Condominium ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain "80000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E214Return a :SingleReturn ;
    :associates :E214 ;
    :linkedTo :E214CondoDisposition ;
    :exclusionCap "250000"^^xsd:integer .