@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:MichiganHouse a :Property .

:E204a a :Taxpayer ;
    :owns :E204aOwnership ;
    :uses :E204aResidence ;
    :disposesOf :MichiganDisposition .

:E204b a :Taxpayer ;
    :owns :E204bOwnership ;
    :uses :E204bResidence ;
    :disposesOf :MichiganDisposition .

:E204aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MichiganHouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E204bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MichiganHouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E204aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :MichiganHouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E204bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :MichiganHouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:MichiganDisposition a :Disposition ;
    :involves :MichiganHouse ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "120000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E204aReturn a :SingleReturn ;
    :associates :E204a ;
    :linkedTo :MichiganDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E204bReturn a :SingleReturn ;
    :associates :E204b ;
    :linkedTo :MichiganDisposition ;
    :exclusionCap "250000"^^xsd:integer .