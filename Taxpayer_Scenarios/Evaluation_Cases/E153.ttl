@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E153 a :Taxpayer ;
    :owns :E153TownhouseOwnership, :E153HouseOwnership ;
    :uses :E153TownhouseResidence, :E153HouseResidence ;
    :disposesOf :TownhouseDisposition, :HouseDisposition .

:Townhouse a :Property .

:House a :Property .

:E153TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E153TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E153HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E153HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:TownhouseDisposition a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "150000"^^xsd:integer .

:HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:TownhouseReturn a :SingleReturn ;
    :associates :E153 ;
    :linkedTo :TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:HouseReturn a :SingleReturn ;
    :associates :E153 ;
    :linkedTo :HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .