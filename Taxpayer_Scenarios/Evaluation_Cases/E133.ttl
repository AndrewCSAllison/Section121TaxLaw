@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E133a a :Taxpayer ;
    :owns :E133aOwnership ;
    :uses :E133aResidenceUse ;
    :disposesOf :E133aDisposition .

:E133b a :Taxpayer ;
    :owns :E133bOwnership ;
    :uses :E133bResidenceUse ;
    :disposesOf :E133bDisposition .

:E133aResidence a :Property .

:E133bResidence a :Property .

:E133aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E133aResidence ;
    :ownershipStart "1999-02-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E133bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E133bResidence ;
    :ownershipStart "1999-02-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E133aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E133aResidence ;
    :residenceStart "1999-02-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E133bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E133bResidence ;
    :residenceStart "1999-02-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E133aDisposition a :Disposition ;
    :involves :E133aResidence ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer .

:E133bDisposition a :Disposition ;
    :involves :E133bResidence ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "270000"^^xsd:integer .

:E133JointReturn2002 a :JointReturn, :Return ;
    :associates :E133a, :E133b ;
    :linkedTo :E133aDisposition, :E133bDisposition ;
    :exclusionCap "500000"^^xsd:integer .