@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E022 a :Taxpayer ;
    :owns :E022ColoradoOwnership, :E022MaineOwnership ;
    :uses :E022ColoradoResidence2001_2002, :E022MaineResidence2003_2004, :E022ColoradoResidence2005 ;
    :disposesOf :E022ColoradoDisposition, :E022MaineDisposition .

:ColoradoResidence a :Property .

:MaineResidence a :Property .

:E022ColoradoOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :ColoradoResidence ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E022MaineOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MaineResidence ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E022ColoradoResidence2001_2002 a :ResidenceUseInterval ;
    :hasResidenceOf :ColoradoResidence ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E022MaineResidence2003_2004 a :ResidenceUseInterval ;
    :hasResidenceOf :MaineResidence ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E022ColoradoResidence2005 a :ResidenceUseInterval ;
    :hasResidenceOf :ColoradoResidence ;
    :residenceStart "2005-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:E022ColoradoDisposition a :Disposition ;
    :involves :ColoradoResidence ;
    :sellDate "2005-12-18"^^xsd:date ;
    :potentialGain "240000"^^xsd:integer .

:E022MaineDisposition a :Disposition ;
    :involves :MaineResidence ;
    :sellDate "2005-12-18"^^xsd:date ;
    :potentialGain "215000"^^xsd:integer .

:E022Return a :SingleReturn ;
    :associates :E022 ;
    :linkedTo :E022ColoradoDisposition, :E022MaineDisposition ;
    :exclusionCap "250000"^^xsd:integer .