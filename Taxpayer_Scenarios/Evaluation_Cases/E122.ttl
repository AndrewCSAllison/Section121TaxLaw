@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E122a a :Taxpayer ;
    :owns :E122aOwnership ;
    :uses :E122aResidenceUse ;
    :disposesOf :E122aDisposition .

:E122b a :Taxpayer ;
    :owns :E122bOwnership ;
    :uses :E122bResidenceUse ;
    :disposesOf :E122bDisposition .

:E122aProperty a :Property .

:E122bProperty a :Property .

:E122aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E122aProperty ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "1999-12-31"^^xsd:date .

:E122bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E122bProperty ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "1999-12-31"^^xsd:date .

:E122aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E122aProperty ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E122bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E122bProperty ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E122aDisposition a :Disposition ;
    :involves :E122aProperty ;
    :sellDate "1999-12-31"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E122bDisposition a :Disposition ;
    :involves :E122bProperty ;
    :sellDate "1999-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E122JointReturn a :JointReturn ;
    :associates :E122a, :E122b ;
    :linkedTo :E122aDisposition, :E122bDisposition ;
    :exclusionCap "500000"^^xsd:integer .