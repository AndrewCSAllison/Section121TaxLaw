@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E119a a :Taxpayer ;
    :owns :E119aOwnership ;
    :uses :E119aResidence ;
    :disposesOf :E119Disposition .

:E119b a :Taxpayer ;
    :owns :E119bOwnership ;
    :uses :E119bResidence ;
    :disposesOf :E119Disposition .

:E119Property a :Property .

:E119aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E119Property ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E119bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E119Property ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E119aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E119Property ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:E119bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E119Property ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:E119Disposition a :Disposition ;
    :involves :E119Property ;
    :sellDate "2012-05-31"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E119JointReturn a :JointReturn ;
    :associates :E119a, :E119b ;
    :linkedTo :E119Disposition ;
    :exclusionCap "500000"^^xsd:integer .