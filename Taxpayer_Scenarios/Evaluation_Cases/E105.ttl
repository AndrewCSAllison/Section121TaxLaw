:AI_1 a :Taxpayer .
:AI_2 a :Taxpayer .

:MainResidence a :Property .

:OwnershipInterval_AI_1 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned 0.5 .

:OwnershipInterval_AI_2 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned 0.5 .

:ResidenceInterval_AI_1 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:ResidenceInterval_AI_2 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:Disposition_Main a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2012-05-31"^^xsd:date ;
    :potentialGain 256000 .

:SingleReturn_AI_1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AI_1 ;
    :linkedTo :Disposition_Main .

:SingleReturn_AI_2 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AI_2 ;
    :linkedTo :Disposition_Main .

:AI_1 :owns :OwnershipInterval_AI_1 ;
       :uses :ResidenceInterval_AI_1 ;
       :disposesOf :Disposition_Main .

:AI_2 :owns :OwnershipInterval_AI_2 ;
       :uses :ResidenceInterval_AI_2 ;
       :disposesOf :Disposition_Main . 