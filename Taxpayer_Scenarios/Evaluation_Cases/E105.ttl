@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E105a a :Taxpayer ;
    :owns :E105aOwnership ;
    :uses :E105aResidence ;
    :disposesOf :HouseSale .

:E105b a :Taxpayer ;
    :owns :E105bOwnership ;
    :uses :E105bResidence ;
    :disposesOf :HouseSale .

:House a :Property .

:E105aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E105bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E105aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:E105bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2012-05-31"^^xsd:date ;
    :potentialGain "256000"^^xsd:integer .

:E105aReturn a :SingleReturn ;
    :associates :E105a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E105bReturn a :SingleReturn ;
    :associates :E105b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .