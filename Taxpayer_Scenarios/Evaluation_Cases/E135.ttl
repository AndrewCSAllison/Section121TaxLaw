@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E135a a :Taxpayer ;
    :owns :E135aOwnership ;
    :uses :E135aResidenceUse ;
    :disposesOf :E135aDisposition .

:E135b a :Taxpayer ;
    :owns :E135bOwnership ;
    :uses :E135bResidenceUse ;
    :disposesOf :E135bDisposition .

:E135aProperty a :Property .

:E135bProperty a :Property .

:E135aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E135aProperty ;
    :ownershipStart "1999-02-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E135bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E135bProperty ;
    :ownershipStart "1999-02-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E135aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E135aProperty ;
    :residenceStart "1999-02-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E135bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E135bProperty ;
    :residenceStart "1999-02-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E135aDisposition a :Disposition ;
    :involves :E135aProperty ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer .

:E135bDisposition a :Disposition ;
    :involves :E135bProperty ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "270000"^^xsd:integer .

:E135JointReturn a :JointReturn ;
    :associates :E135a, :E135b ;
    :linkedTo :E135aDisposition, :E135bDisposition ;
    :exclusionCap "500000"^^xsd:integer .