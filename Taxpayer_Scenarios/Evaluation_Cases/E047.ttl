@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:MainResidence a :Property .

:P a :Taxpayer ;
    :owns :P_OwnershipInterval ;
    :uses :P_ResidenceInterval ;
    :disposesOf :P_Disposition .

:P_OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1986-01-01"^^xsd:date ;
    :ownershipEnd "2000-04-18"^^xsd:date ;
    :percentageOwned 1.0 .

:P_ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "1986-01-01"^^xsd:date ;
    :residenceEnd "1998-01-31"^^xsd:date .

:P_Disposition a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2000-04-18"^^xsd:date ;
    :potentialGain 200000 .

:P_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :P ;
    :linkedTo :P_Disposition .
