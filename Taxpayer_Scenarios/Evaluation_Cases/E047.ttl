@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E047 a :Taxpayer ;
    :owns :E047Ownership ;
    :uses :E047Residence ;
    :disposesOf :E047Disposition .

:E047House a :Property .

:E047Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E047House ;
    :ownershipStart "1986-01-01"^^xsd:date ;
    :ownershipEnd "2000-04-18"^^xsd:date .

:E047Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E047House ;
    :residenceStart "1986-01-01"^^xsd:date ;
    :residenceEnd "1998-01-31"^^xsd:date .

:E047Disposition a :Disposition ;
    :involves :E047House ;
    :sellDate "2000-04-18"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E047Return a :SingleReturn ;
    :associates :E047 ;
    :linkedTo :E047Disposition ;
    :exclusionCap "250000"^^xsd:integer .