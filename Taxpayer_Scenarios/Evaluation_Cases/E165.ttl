@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E165 a :Taxpayer ;
    :owns :E165TownhouseOwnership, :E165HouseOwnership ;
    :uses :E165TownhouseResidence, :E165HouseResidence ;
    :disposesOf :TownhouseDisposition, :HouseDisposition .

:Townhouse a :Property .

:House a :Property .

:E165TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E165TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E165HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E165HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:TownhouseDisposition a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain "350000"^^xsd:integer .

:TownhouseReturn a :SingleReturn ;
    :associates :E165 ;
    :linkedTo :TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:HouseReturn a :SingleReturn ;
    :associates :E165 ;
    :linkedTo :HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .