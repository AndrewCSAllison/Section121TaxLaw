@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E193 a :Taxpayer ;
    :owns :E193Ownership ;
    :uses :E193Residence ;
    :disposesOf :E193Disposition .

:E193House a :Property .

:E193Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E193House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date .

:E193Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E193House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:E193Disposition a :Disposition ;
    :involves :E193House ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain "275000"^^xsd:integer ;
    :partialExclusionReason :HealthRelatedReason .

:E193Return a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :E193 ;
    :linkedTo :E193Disposition .