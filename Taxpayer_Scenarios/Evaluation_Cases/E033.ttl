@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E033 a :Taxpayer ;
    :owns :E033ArizonaOwnership, :E033VirginiaOwnership ;
    :uses :E033ArizonaResidence2003_2004, :E033VirginiaResidence2005_2006, :E033ArizonaResidence2007 ;
    :disposesOf :E033ArizonaDisposition, :E033VirginiaDisposition .

:E033ArizonaProperty a :Property .

:E033VirginiaProperty a :Property .

:E033ArizonaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E033ArizonaProperty ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2007-12-31"^^xsd:date .

:E033VirginiaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E033VirginiaProperty ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2007-12-31"^^xsd:date .

:E033ArizonaResidence2003_2004 a :ResidenceUseInterval ;
    :hasResidenceOf :E033ArizonaProperty ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E033VirginiaResidence2005_2006 a :ResidenceUseInterval ;
    :hasResidenceOf :E033VirginiaProperty ;
    :residenceStart "2005-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:E033ArizonaResidence2007 a :ResidenceUseInterval ;
    :hasResidenceOf :E033ArizonaProperty ;
    :residenceStart "2007-01-01"^^xsd:date ;
    :residenceEnd "2007-12-31"^^xsd:date .

:E033ArizonaDisposition a :Disposition ;
    :involves :E033ArizonaProperty ;
    :sellDate "2007-12-20"^^xsd:date ;
    :potentialGain "240000"^^xsd:integer .

:E033VirginiaDisposition a :Disposition ;
    :involves :E033VirginiaProperty ;
    :sellDate "2007-12-20"^^xsd:date ;
    :potentialGain "215000"^^xsd:integer .

:E033Return a :SingleReturn ;
    :associates :E033 ;
    :linkedTo :E033ArizonaDisposition, :E033VirginiaDisposition ;
    :exclusionCap "250000"^^xsd:integer .