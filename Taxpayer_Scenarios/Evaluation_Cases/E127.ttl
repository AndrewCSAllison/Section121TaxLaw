@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E127a a :Taxpayer ;
    :owns :E127aOwnership ;
    :uses :E127aResidenceUse ;
    :disposesOf :E127aDisposition .

:E127b a :Taxpayer ;
    :owns :E127bOwnership ;
    :uses :E127bResidenceUse ;
    :disposesOf :E127bDisposition .

:E127aProperty a :Property .

:E127bProperty a :Property .

:E127aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E127aProperty ;
    :ownershipStart "1998-02-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E127bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E127bProperty ;
    :ownershipStart "1998-02-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E127aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E127aProperty ;
    :residenceStart "1998-02-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E127bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E127bProperty ;
    :residenceStart "1998-02-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E127aDisposition a :Disposition ;
    :involves :E127aProperty ;
    :sellDate "2001-12-31"^^xsd:date ;
    :potentialGain "240000"^^xsd:integer .

:E127bDisposition a :Disposition ;
    :involves :E127bProperty ;
    :sellDate "2001-12-31"^^xsd:date ;
    :potentialGain "260000"^^xsd:integer .

:E127JointReturn2001 a :JointReturn ;
    :associates :E127a, :E127b ;
    :linkedTo :E127aDisposition, :E127bDisposition ;
    :exclusionCap "500000"^^xsd:integer .