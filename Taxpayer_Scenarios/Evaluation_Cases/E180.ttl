@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayer
:BH a :Taxpayer .

### Properties
:Townhouse a :Property .
:House a :Property .

### Ownership Intervals
:BH_Own_Townhouse a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:BH_Own_House a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

### Residence Intervals
:BH_Res_Townhouse a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:BH_Res_House a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

### Dispositions
:Disp_Townhouse a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain 160000 .

:Disp_House a :Disposition ;
    :involves :House ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain 280000 .

### Single Returns
:Return_Townhouse a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BH ;
    :linkedTo :Disp_Townhouse .

:Return_House a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BH ;
    :linkedTo :Disp_House .

### Link taxpayer to ownership and residence
:BH :owns :BH_Own_Townhouse, :BH_Own_House ;
    :uses :BH_Res_Townhouse, :BH_Res_House ;
    :disposesOf :Disp_Townhouse, :Disp_House .