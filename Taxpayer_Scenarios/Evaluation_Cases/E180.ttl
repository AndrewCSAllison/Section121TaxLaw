@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E180 a :Taxpayer ;
    :owns :E180TownhouseOwnership, :E180HouseOwnership ;
    :uses :E180TownhouseResidence, :E180HouseResidence ;
    :disposesOf :E180TownhouseDisposition, :E180HouseDisposition .

:E180Townhouse a :Property .

:E180House a :Property .

:E180TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E180Townhouse ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E180TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E180Townhouse ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E180HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E180House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E180HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E180House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E180TownhouseDisposition a :Disposition ;
    :involves :E180Townhouse ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "160000"^^xsd:integer .

:E180HouseDisposition a :Disposition ;
    :involves :E180House ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "280000"^^xsd:integer .

:E180TownhouseReturn a :SingleReturn ;
    :associates :E180 ;
    :linkedTo :E180TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E180HouseReturn a :SingleReturn ;
    :associates :E180 ;
    :linkedTo :E180HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .