@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E117a a :Taxpayer ;
    :owns :E117aOwnership ;
    :uses :E117aResidence ;
    :disposesOf :E117Disposition .

:E117b a :Taxpayer ;
    :owns :E117bOwnership ;
    :uses :E117bResidence ;
    :disposesOf :E117Disposition .

:E117Property a :Property .

:E117aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E117Property ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date .

:E117bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E117Property ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date .

:E117aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E117Property ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:E117bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E117Property ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:E117Disposition a :Disposition ;
    :involves :E117Property ;
    :sellDate "2014-08-31"^^xsd:date ;
    :potentialGain "600000"^^xsd:integer .

:E117JointReturn a :JointReturn ;
    :associates :E117a, :E117b ;
    :linkedTo :E117Disposition ;
    :exclusionCap "500000"^^xsd:integer .