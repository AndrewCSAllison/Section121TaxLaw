@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E120a a :Taxpayer ;
    :owns :E120aOwnership ;
    :uses :E120aResidence ;
    :disposesOf :E120Disposition .

:E120b a :Taxpayer ;
    :owns :E120bOwnership ;
    :uses :E120bResidence ;
    :disposesOf :E120Disposition .

:E120Property a :Property .

:E120aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E120Property ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E120bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E120Property ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E120aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E120Property ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:E120bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E120Property ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:E120Disposition a :Disposition ;
    :involves :E120Property ;
    :sellDate "2012-05-31"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E120JointReturn a :JointReturn ;
    :associates :E120a, :E120b ;
    :linkedTo :E120Disposition ;
    :exclusionCap "500000"^^xsd:integer .