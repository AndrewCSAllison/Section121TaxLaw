@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E053 a :Taxpayer ;
    :owns :E053OwnershipInterval ;
    :uses :E053ResidenceInterval ;
    :disposesOf :E053Disposition .

:E053House a :Property .

:E053OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E053House ;
    :ownershipStart "1985-03-01"^^xsd:date ;
    :ownershipEnd "1999-11-30"^^xsd:date .

:E053ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E053House ;
    :residenceStart "1985-03-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E053Disposition a :Disposition ;
    :involves :E053House ;
    :sellDate "1999-11-30"^^xsd:date ;
    :potentialGain "150000"^^xsd:integer .

:E053Return a :SingleReturn ;
    :associates :E053 ;
    :linkedTo :E053Disposition ;
    :exclusionCap "250000"^^xsd:integer .