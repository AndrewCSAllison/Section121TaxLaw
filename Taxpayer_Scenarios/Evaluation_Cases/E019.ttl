@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E019 a :Taxpayer ;
    :owns :E019_Oregon_Ownership, :E019_Massachusetts_Ownership ;
    :uses :E019_Oregon_Residence_1999_2000, :E019_Massachusetts_Residence_2001_2002, :E019_Oregon_Residence_2003 ;
    :disposesOf :E019_Oregon_Disposition, :E019_Massachusetts_Disposition .

:E019_Oregon_Property a :Property .

:E019_Massachusetts_Property a :Property .

:E019_Oregon_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E019_Oregon_Property ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E019_Massachusetts_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E019_Massachusetts_Property ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E019_Oregon_Residence_1999_2000 a :ResidenceUseInterval ;
    :hasResidenceOf :E019_Oregon_Property ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:E019_Massachusetts_Residence_2001_2002 a :ResidenceUseInterval ;
    :hasResidenceOf :E019_Massachusetts_Property ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E019_Oregon_Residence_2003 a :ResidenceUseInterval ;
    :hasResidenceOf :E019_Oregon_Property ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E019_Oregon_Disposition a :Disposition ;
    :involves :E019_Oregon_Property ;
    :sellDate "2003-12-20"^^xsd:date ;
    :potentialGain "225000"^^xsd:integer .

:E019_Massachusetts_Disposition a :Disposition ;
    :involves :E019_Massachusetts_Property ;
    :sellDate "2003-12-20"^^xsd:date ;
    :potentialGain "205000"^^xsd:integer .

:E019_Return a :SingleReturn ;
    :associates :E019 ;
    :linkedTo :E019_Oregon_Disposition, :E019_Massachusetts_Disposition ;
    :exclusionCap "250000"^^xsd:integer .