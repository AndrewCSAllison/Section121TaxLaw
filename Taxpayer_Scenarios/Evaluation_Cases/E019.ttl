@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:G a :Taxpayer .

:OregonResidence a :Property .
:MassachusettsResidence a :Property .

:G_OregonOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :OregonResidence ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:G_MassachusettsOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MassachusettsResidence ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:G_OregonResidenceUse1999_2000 a :ResidenceUseInterval ;
    :hasResidenceOf :OregonResidence ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:G_MassachusettsResidenceUse2001_2002 a :ResidenceUseInterval ;
    :hasResidenceOf :MassachusettsResidence ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:G_OregonResidenceUse2003 a :ResidenceUseInterval ;
    :hasResidenceOf :OregonResidence ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:OregonDisposition a :Disposition ;
    :involves :OregonResidence ;
    :sellDate "2003-12-20"^^xsd:date ;
    :potentialGain 225000 .

:MassachusettsDisposition a :Disposition ;
    :involves :MassachusettsResidence ;
    :sellDate "2003-12-20"^^xsd:date ;
    :potentialGain 205000 .

:G_OregonOwnership rdf:type :OwnershipUseInterval .
:G_MassachusettsOwnership rdf:type :OwnershipUseInterval .

:G_OregonResidenceUse1999_2000 rdf:type :ResidenceUseInterval .
:G_MassachusettsResidenceUse2001_2002 rdf:type :ResidenceUseInterval .
:G_OregonResidenceUse2003 rdf:type :ResidenceUseInterval .

:G rdf:type :Taxpayer ;
   :owns :G_OregonOwnership, :G_MassachusettsOwnership ;
   :uses :G_OregonResidenceUse1999_2000, :G_MassachusettsResidenceUse2001_2002, :G_OregonResidenceUse2003 ;
   :disposesOf :OregonDisposition, :MassachusettsDisposition .

:G_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :G ;
    :linkedTo :OregonDisposition, :MassachusettsDisposition .
