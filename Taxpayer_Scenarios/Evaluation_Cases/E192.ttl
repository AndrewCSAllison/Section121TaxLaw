@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E192 a :Taxpayer ;
    :owns :E192CondominiumOwnership ;
    :uses :E192CondominiumResidence ;
    :disposesOf :E192CondominiumDisposition .

:E192Condominium a :Property .

:E192CondominiumOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E192Condominium ;
    :ownershipStart "2003-07-01"^^xsd:date ;
    :ownershipEnd "2004-02-05"^^xsd:date .

:E192CondominiumResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E192Condominium ;
    :residenceStart "2003-07-01"^^xsd:date ;
    :residenceEnd "2004-02-05"^^xsd:date .

:E192CondominiumDisposition a :Disposition ;
    :involves :E192Condominium ;
    :sellDate "2004-02-05"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E192SingleReturn a :SingleReturn ;
    :associates :E192 ;
    :linkedTo :E192CondominiumDisposition ;
    :exclusionCap "250000"^^xsd:integer .