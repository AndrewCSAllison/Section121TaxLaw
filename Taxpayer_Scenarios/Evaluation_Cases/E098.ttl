@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:House a :Property .

:E098a a :Taxpayer ;
    :owns :E098aOwnership ;
    :uses :E098aResidence ;
    :disposesOf :HouseSale .

:E098b a :Taxpayer ;
    :owns :E098bOwnership ;
    :uses :E098bResidence ;
    :disposesOf :HouseSale .

:E098aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E098bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E098aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:E098bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2017-05-14"^^xsd:date ;
    :potentialGain "540000"^^xsd:integer .

:E098aReturn a :SingleReturn ;
    :associates :E098a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E098bReturn a :SingleReturn ;
    :associates :E098b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .