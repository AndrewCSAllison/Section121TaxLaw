@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E129a a :Taxpayer ;
    :owns :E129aOwnership ;
    :uses :E129aResidenceUse ;
    :disposesOf :E129aDisposition .

:E129b a :Taxpayer ;
    :owns :E129bOwnership ;
    :uses :E129bResidenceUse ;
    :disposesOf :E129bDisposition .

:E129aResidence a :Property .

:E129bResidence a :Property .

:E129aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E129aResidence ;
    :ownershipStart "1998-02-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date .

:E129bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E129bResidence ;
    :ownershipStart "1998-02-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date .

:E129aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E129aResidence ;
    :residenceStart "1998-02-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E129bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E129bResidence ;
    :residenceStart "1998-02-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E129aDisposition a :Disposition ;
    :involves :E129aResidence ;
    :sellDate "2001-12-31"^^xsd:date ;
    :potentialGain "240000"^^xsd:integer .

:E129bDisposition a :Disposition ;
    :involves :E129bResidence ;
    :sellDate "2001-12-31"^^xsd:date ;
    :potentialGain "260000"^^xsd:integer .

:E129JointReturn a :JointReturn ;
    :associates :E129a, :E129b ;
    :linkedTo :E129aDisposition, :E129bDisposition ;
    :exclusionCap "500000"^^xsd:integer .