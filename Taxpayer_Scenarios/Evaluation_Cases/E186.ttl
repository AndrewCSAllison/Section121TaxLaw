@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E186 a :Taxpayer ;
    :owns :E186OwnershipInterval ;
    :uses :E186ResidenceInterval ;
    :disposesOf :E186Disposition .

:E186House a :Property .

:E186OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E186House ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date .

:E186ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E186House ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-05-01"^^xsd:date .

:E186Disposition a :Disposition ;
    :involves :E186House ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E186Return a :SingleReturn ;
    :associates :E186 ;
    :linkedTo :E186Disposition ;
    :exclusionCap "250000"^^xsd:integer .