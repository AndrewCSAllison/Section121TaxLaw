@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E155 a :Taxpayer ;
    :owns :E155TownhouseOwnership, :E155HouseOwnership ;
    :uses :E155TownhouseResidence, :E155HouseResidence ;
    :disposesOf :E155TownhouseDisposition, :E155HouseDisposition .

:E155Townhouse a :Property .

:E155House a :Property .

:E155TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E155Townhouse ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E155TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E155Townhouse ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E155HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E155House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E155HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E155House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E155TownhouseDisposition a :Disposition ;
    :involves :E155Townhouse ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "150000"^^xsd:integer .

:E155HouseDisposition a :Disposition ;
    :involves :E155House ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E155TownhouseReturn a :SingleReturn ;
    :associates :E155 ;
    :linkedTo :E155TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E155HouseReturn a :SingleReturn ;
    :associates :E155 ;
    :linkedTo :E155HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .