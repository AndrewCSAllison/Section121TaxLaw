@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E044 a :Taxpayer ;
    :owns :E044HouseOwnership, :E044LandOwnership ;
    :uses :E044HouseResidence, :E044LandResidence ;
    :disposesOf :E044HouseDisposition, :E044LandDisposition .

:E044House a :Property .

:E044Land a :Property .

:E044HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E044House ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2006-09-10"^^xsd:date .

:E044LandOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E044Land ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2006-09-10"^^xsd:date .

:E044HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E044House ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2006-09-10"^^xsd:date .

:E044LandResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E044Land ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2006-09-10"^^xsd:date .

:E044HouseDisposition a :Disposition ;
    :involves :E044House ;
    :sellDate "2006-09-10"^^xsd:date ;
    :potentialGain "-20000"^^xsd:integer .

:E044LandDisposition a :Disposition ;
    :involves :E044Land ;
    :sellDate "2006-09-10"^^xsd:date ;
    :potentialGain "260000"^^xsd:integer .

:E044Return a :SingleReturn ;
    :associates :E044 ;
    :linkedTo :E044HouseDisposition, :E044LandDisposition ;
    :exclusionCap "250000"^^xsd:integer .