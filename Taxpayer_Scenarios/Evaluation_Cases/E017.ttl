@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:F a :Taxpayer .

:NevadaProperty a :Property .
:WashingtonProperty a :Property .

:OwnershipInterval_Nevada a :OwnershipUseInterval ;
    :hasOwnershipOf :NevadaProperty ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:OwnershipInterval_Washington a :OwnershipUseInterval ;
    :hasOwnershipOf :WashingtonProperty ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:F :owns :OwnershipInterval_Nevada , :OwnershipInterval_Washington .

:ResidenceInterval_Nevada_2002_2003 a :ResidenceUseInterval ;
    :hasResidenceOf :NevadaProperty ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:ResidenceInterval_Washington_2004_2005 a :ResidenceUseInterval ;
    :hasResidenceOf :WashingtonProperty ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:ResidenceInterval_Nevada_2006 a :ResidenceUseInterval ;
    :hasResidenceOf :NevadaProperty ;
    :residenceStart "2006-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:F :uses :ResidenceInterval_Nevada_2002_2003 ,
        :ResidenceInterval_Washington_2004_2005 ,
        :ResidenceInterval_Nevada_2006 .

:Disposition_Nevada a :Disposition ;
    :involves :NevadaProperty ;
    :sellDate "2006-12-15"^^xsd:date ;
    :potentialGain 235000 .

:Disposition_Washington a :Disposition ;
    :involves :WashingtonProperty ;
    :sellDate "2006-12-15"^^xsd:date ;
    :potentialGain 210000 .

:F :disposesOf :Disposition_Nevada , :Disposition_Washington .

:Return_2006 a :SingleReturn ;
    :associates :F ;
    :linkedTo :Disposition_Nevada , :Disposition_Washington ;
    :exclusionCap 250000 .
