@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E017 a :Taxpayer ;
    :owns :E017NevadaOwnership, :E017WashingtonOwnership ;
    :uses :E017NevadaResidence2002_2003, :E017WashingtonResidence2004_2005, :E017NevadaResidence2006 ;
    :disposesOf :E017NevadaDisposition, :E017WashingtonDisposition .

:E017NevadaProperty a :Property .

:E017WashingtonProperty a :Property .

:E017NevadaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E017NevadaProperty ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E017WashingtonOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E017WashingtonProperty ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E017NevadaResidence2002_2003 a :ResidenceUseInterval ;
    :hasResidenceOf :E017NevadaProperty ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E017WashingtonResidence2004_2005 a :ResidenceUseInterval ;
    :hasResidenceOf :E017WashingtonProperty ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:E017NevadaResidence2006 a :ResidenceUseInterval ;
    :hasResidenceOf :E017NevadaProperty ;
    :residenceStart "2006-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:E017NevadaDisposition a :Disposition ;
    :involves :E017NevadaProperty ;
    :sellDate "2006-12-15"^^xsd:date ;
    :potentialGain "235000"^^xsd:integer .

:E017WashingtonDisposition a :Disposition ;
    :involves :E017WashingtonProperty ;
    :sellDate "2006-12-15"^^xsd:date ;
    :potentialGain "210000"^^xsd:integer .

:E017Return a :SingleReturn ;
    :associates :E017 ;
    :linkedTo :E017NevadaDisposition, :E017WashingtonDisposition ;
    :exclusionCap "250000"^^xsd:integer .