@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E145a a :Taxpayer ;
    :owns :E145aOwnership ;
    :disposesOf :ResidenceSale .

:E145b a :Taxpayer ;
    :owns :E145bOwnership ;
    :uses :E145bResidenceUse ;
    :disposesOf :ResidenceSale .

:MainResidence a :Property .

:E145aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2002-02-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E145bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2002-02-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E145bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2002-02-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:ResidenceSale a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain "400000"^^xsd:integer .

:JointReturn a :JointReturn ;
    :associates :E145a, :E145b ;
    :linkedTo :ResidenceSale ;
    :exclusionCap "500000"^^xsd:integer .