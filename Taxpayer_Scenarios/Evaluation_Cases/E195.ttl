:BM a :Taxpayer .

:BMProperty a :Property .

:BM_Ownership_Interval a :OwnershipUseInterval ;
    :hasOwnershipOf :BMProperty ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date ;
    :percentageOwned 1.0 .

:BM_Residence_Interval a :ResidenceUseInterval ;
    :hasResidenceOf :BMProperty ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:BMSale a :Disposition ;
    :involves :BMProperty ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain 275000 ;
    :partialExclusionReason :HealthRelatedReason .

:BM_Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BM ;
    :linkedTo :BMSale .

:BM :owns :BM_Ownership_Interval ;
    :uses :BM_Residence_Interval ;
    :disposesOf :BMSale .