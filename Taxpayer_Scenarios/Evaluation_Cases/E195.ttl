@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E195 a :Taxpayer ;
    :owns :E195Ownership ;
    :uses :E195ResidenceUse ;
    :disposesOf :E195Disposition .

:E195House a :Property .

:E195Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E195House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date .

:E195ResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E195House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:E195Disposition a :Disposition ;
    :involves :E195House ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain "275000"^^xsd:integer ;
    :partialExclusionReason :HealthRelatedReason .

:E195Return a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :E195 ;
    :linkedTo :E195Disposition .