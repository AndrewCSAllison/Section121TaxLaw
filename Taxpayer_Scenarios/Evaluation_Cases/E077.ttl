@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E077 a :Taxpayer ;
    :owns :E077OwnershipInterval ;
    :uses :E077ResidenceInterval ;
    :disposesOf :E077TownhouseSale .

:E077Townhouse a :Property .

:E077OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E077Townhouse ;
    :ownershipStart "1997-01-18"^^xsd:date ;
    :ownershipEnd "2000-05-25"^^xsd:date .

:E077ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E077Townhouse ;
    :residenceStart "1995-05-25"^^xsd:date ;
    :residenceEnd "1998-02-01"^^xsd:date .

:E077TownhouseSale a :Disposition ;
    :involves :E077Townhouse ;
    :sellDate "2000-05-25"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:E077SingleReturn a :SingleReturn ;
    :associates :E077 ;
    :linkedTo :E077TownhouseSale ;
    :exclusionCap "250000"^^xsd:integer .