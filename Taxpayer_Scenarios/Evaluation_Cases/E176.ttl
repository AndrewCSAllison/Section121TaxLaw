@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E176 a :Taxpayer ;
    :owns :E176TownhouseOwnership,
          :E176HouseOwnership ;
    :uses :E176TownhouseResidence,
          :E176HouseResidence ;
    :disposesOf :E176TownhouseDisposition,
                :E176HouseDisposition .

:E176Townhouse a :Property .

:E176House a :Property .

:E176TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E176Townhouse ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E176TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E176Townhouse ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E176HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E176House ;
    :ownershipStart "2003-12-31"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E176HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E176House ;
    :residenceStart "2003-12-31"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:E176TownhouseDisposition a :Disposition ;
    :involves :E176Townhouse ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain "190000"^^xsd:integer .

:E176HouseDisposition a :Disposition ;
    :involves :E176House ;
    :sellDate "2006-12-31"^^xsd:date ;
    :potentialGain "310000"^^xsd:integer .

:E176TownhouseReturn a :SingleReturn ;
    :associates :E176 ;
    :linkedTo :E176TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E176HouseReturn a :SingleReturn ;
    :associates :E176 ;
    :linkedTo :E176HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .