@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:House a :Property .

:Land a :Property .

:E041 a :Taxpayer ;
    :owns :E041HouseOwnership, :E041LandOwnership ;
    :uses :E041HouseResidence, :E041LandResidence ;
    :disposesOf :HouseDisposition, :LandDisposition .

:E041HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "1995-01-01"^^xsd:date ;
    :ownershipEnd "2000-05-20"^^xsd:date .

:E041LandOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :Land ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "2000-05-20"^^xsd:date .

:E041HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1995-01-01"^^xsd:date ;
    :residenceEnd "2000-05-20"^^xsd:date .

:E041LandResidence a :ResidenceUseInterval ;
    :hasResidenceOf :Land ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "2000-05-20"^^xsd:date .

:HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2000-05-20"^^xsd:date ;
    :potentialGain "-10000"^^xsd:integer .

:LandDisposition a :Disposition ;
    :involves :Land ;
    :sellDate "2000-05-20"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer .

:E041SingleReturn a :SingleReturn ;
    :associates :E041 ;
    :linkedTo :HouseDisposition, :LandDisposition ;
    :exclusionCap "250000"^^xsd:integer .