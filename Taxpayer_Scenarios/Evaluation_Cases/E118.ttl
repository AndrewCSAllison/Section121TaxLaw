@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E118a a :Taxpayer ;
    :owns :E118aOwnership ;
    :uses :E118aResidence ;
    :disposesOf :E118Disposition .

:E118b a :Taxpayer ;
    :owns :E118bOwnership ;
    :uses :E118bResidence ;
    :disposesOf :E118Disposition .

:E118Property a :Property .

:E118aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E118Property ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date .

:E118bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E118Property ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date .

:E118aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E118Property ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:E118bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E118Property ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:E118Disposition a :Disposition ;
    :involves :E118Property ;
    :sellDate "2012-05-31"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E118JointReturn a :JointReturn ;
    :associates :E118a, :E118b ;
    :linkedTo :E118Disposition ;
    :exclusionCap "500000"^^xsd:integer .