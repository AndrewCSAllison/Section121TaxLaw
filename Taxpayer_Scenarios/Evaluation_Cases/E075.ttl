# Source ontology and modeling requirements: :contentReference[oaicite:0]{index=0}
@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E075 a :Taxpayer ;
    :owns :E075Ownership ;
    :uses :E075Residence ;
    :disposesOf :E075Disposition .

:House a :Property .

:E075Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "1989-07-20"^^xsd:date ;
    :ownershipEnd "2001-12-01"^^xsd:date .

:E075Residence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1989-07-20"^^xsd:date ;
    :residenceEnd "1998-01-04"^^xsd:date .

:E075Disposition a :Disposition ;
    :involves :House ;
    :sellDate "2001-12-01"^^xsd:date ;
    :potentialGain "205000"^^xsd:integer .

:E075Return a :SingleReturn ;
    :associates :E075 ;
    :linkedTo :E075Disposition ;
    :exclusionCap "250000"^^xsd:integer .