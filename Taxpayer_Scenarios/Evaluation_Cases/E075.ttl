:TaxpayerY a :Taxpayer .

:House a :Property .

:OwnershipIntervalY a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "1989-07-20"^^xsd:date ;
    :ownershipEnd "2001-12-01"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:ResidenceIntervalY a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1989-07-20"^^xsd:date ;
    :residenceEnd "1998-01-04"^^xsd:date .

:DispositionY a :Disposition ;
    :involves :House ;
    :sellDate "2001-12-01"^^xsd:date ;
    :potentialGain 205000 .

:SingleReturnY a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :TaxpayerY ;
    :linkedTo :DispositionY .

:TaxpayerY :owns :OwnershipIntervalY ;
           :uses :ResidenceIntervalY ;
           :disposesOf :DispositionY .