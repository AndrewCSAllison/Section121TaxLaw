@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E169 a :Taxpayer ;
    :owns :E169TownhouseOwnership, :E169HouseOwnership ;
    :uses :E169TownhouseResidence, :E169HouseResidence ;
    :disposesOf :E169TownhouseDisposition, :E169HouseDisposition .

:E169Townhouse a :Property .

:E169House a :Property .

:E169TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E169Townhouse ;
    :ownershipStart "1997-01-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date .

:E169TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E169Townhouse ;
    :residenceStart "1997-01-01"^^xsd:date ;
    :residenceEnd "1998-12-31"^^xsd:date .

:E169HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E169House ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E169HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E169House ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E169TownhouseDisposition a :Disposition ;
    :involves :E169Townhouse ;
    :sellDate "2001-12-31"^^xsd:date ;
    :potentialGain "120000"^^xsd:integer .

:E169HouseDisposition a :Disposition ;
    :involves :E169House ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "270000"^^xsd:integer .

:E169TownhouseReturn a :SingleReturn ;
    :associates :E169 ;
    :linkedTo :E169TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E169HouseReturn a :SingleReturn ;
    :associates :E169 ;
    :linkedTo :E169HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .