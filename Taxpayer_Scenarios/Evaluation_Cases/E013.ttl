@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E013 a :Taxpayer ;
    :owns :E013MichiganOwnership, :E013SouthCarolinaOwnership ;
    :uses :E013MichiganResidence2001_2002, :E013SouthCarolinaResidence2003_2004, :E013MichiganResidence2005 ;
    :disposesOf :E013MichiganDisposition, :E013SouthCarolinaDisposition .

:E013MichiganProperty a :Property .

:E013SouthCarolinaProperty a :Property .

:E013MichiganOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E013MichiganProperty ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E013SouthCarolinaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E013SouthCarolinaProperty ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E013MichiganResidence2001_2002 a :ResidenceUseInterval ;
    :hasResidenceOf :E013MichiganProperty ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E013SouthCarolinaResidence2003_2004 a :ResidenceUseInterval ;
    :hasResidenceOf :E013SouthCarolinaProperty ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E013MichiganResidence2005 a :ResidenceUseInterval ;
    :hasResidenceOf :E013MichiganProperty ;
    :residenceStart "2005-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:E013MichiganDisposition a :Disposition ;
    :involves :E013MichiganProperty ;
    :sellDate "2005-12-18"^^xsd:date ;
    :potentialGain "230000"^^xsd:integer .

:E013SouthCarolinaDisposition a :Disposition ;
    :involves :E013SouthCarolinaProperty ;
    :sellDate "2005-12-18"^^xsd:date ;
    :potentialGain "210000"^^xsd:integer .

:E013Return a :SingleReturn ;
    :associates :E013 ;
    :linkedTo :E013MichiganDisposition, :E013SouthCarolinaDisposition ;
    :exclusionCap "250000"^^xsd:integer .