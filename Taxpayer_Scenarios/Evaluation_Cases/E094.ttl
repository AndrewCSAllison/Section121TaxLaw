@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E094a a :Taxpayer ;
    :owns :E094aOwnership ;
    :uses :E094aResidenceUse ;
    :disposesOf :HouseSale .

:E094b a :Taxpayer ;
    :owns :E094bOwnership ;
    :uses :E094bResidenceUse ;
    :disposesOf :HouseSale .

:House a :Property .

:E094aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E094bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E094aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:E094bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2020-02-28"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E094aReturn a :SingleReturn ;
    :associates :E094a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E094bReturn a :SingleReturn ;
    :associates :E094b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .