@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AF_1 a :Taxpayer .
:AF_2 a :Taxpayer .

:MainResidence a :Property .

:AF1OwnershipUse a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned 0.5 .

:AF2OwnershipUse a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned 0.5 .

:AF1ResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:AF2ResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:Disposition1 a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2020-02-28"^^xsd:date ;
    :potentialGain 300000 .

:AF1Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AF_1 ;
    :linkedTo :Disposition1 .

:AF2Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AF_2 ;
    :linkedTo :Disposition1 .

:AF_1 :owns :AF1OwnershipUse ;
       :uses :AF1ResidenceUse ;
       :disposesOf :Disposition1 .

:AF_2 :owns :AF2OwnershipUse ;
       :uses :AF2ResidenceUse ;
       :disposesOf :Disposition1 .