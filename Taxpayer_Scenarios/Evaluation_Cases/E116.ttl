@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E116a a :Taxpayer ;
    :disposesOf :E116Disposition ;
    :owns :E116aOwnership ;
    :uses :E116aResidence .

:E116b a :Taxpayer ;
    :disposesOf :E116Disposition ;
    :owns :E116bOwnership ;
    :uses :E116bResidence .

:E116Property a :Property .

:E116aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E116Property ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E116bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E116Property ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E116aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E116Property ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:E116bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E116Property ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:E116Disposition a :Disposition ;
    :involves :E116Property ;
    :sellDate "2014-08-31"^^xsd:date ;
    :potentialGain "600000"^^xsd:integer .

:E116JointReturn a :JointReturn ;
    :associates :E116a, :E116b ;
    :linkedTo :E116Disposition ;
    :exclusionCap "500000"^^xsd:integer .