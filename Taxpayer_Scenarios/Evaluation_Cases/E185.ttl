@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E185 a :Taxpayer ;
    :owns :E185Ownership ;
    :uses :E185Residence ;
    :disposesOf :E185Disposition .

:E185FloridaHouse a :Property .

:E185Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E185FloridaHouse ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E185Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E185FloridaHouse ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-05-01"^^xsd:date .

:E185Disposition a :Disposition ;
    :involves :E185FloridaHouse ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E185Return a :SingleReturn ;
    :associates :E185 ;
    :linkedTo :E185Disposition ;
    :exclusionCap "250000"^^xsd:integer .