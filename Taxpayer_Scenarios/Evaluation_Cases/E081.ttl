@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E081 a :Taxpayer ;
    :owns :E081OwnershipInterval ;
    :uses :E081ResidenceInterval ;
    :disposesOf :E081Disposition .

:E081Townhouse a :Property .

:E081OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E081Townhouse ;
    :ownershipStart "1997-02-10"^^xsd:date ;
    :ownershipEnd "2000-06-12"^^xsd:date .

:E081ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E081Townhouse ;
    :residenceStart "1995-06-12"^^xsd:date ;
    :residenceEnd "1998-04-20"^^xsd:date .

:E081Disposition a :Disposition ;
    :involves :E081Townhouse ;
    :sellDate "2000-06-12"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:E081SingleReturn a :SingleReturn ;
    :associates :E081 ;
    :linkedTo :E081Disposition ;
    :exclusionCap "250000"^^xsd:integer .