@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AA a :Taxpayer .

:Townhouse a :Property .

:AA_Ownership_1 a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "1997-02-10"^^xsd:date ;
    :ownershipEnd "2000-06-12"^^xsd:date .

:AA_Residence_1 a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "1995-06-12"^^xsd:date ;
    :residenceEnd "1998-04-20"^^xsd:date .

:AA_Disposition a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2000-06-12"^^xsd:date ;
    :potentialGain 180000 .

:AA_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AA ;
    :linkedTo :AA_Disposition .

:AA :owns :AA_Ownership_1 ;
    :uses :AA_Residence_1 ;
    :disposesOf :AA_Disposition .