@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E020 a :Taxpayer ;
    :owns :E020OregonOwnership, :E020MassachusettsOwnership ;
    :uses :E020OregonResidence1999_2000, :E020MassachusettsResidence2001_2002, :E020OregonResidence2003 ;
    :disposesOf :E020OregonDisposition, :E020MassachusettsDisposition .

:E020OregonProperty a :Property .

:E020MassachusettsProperty a :Property .

:E020OregonOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E020OregonProperty ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E020MassachusettsOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E020MassachusettsProperty ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E020OregonResidence1999_2000 a :ResidenceUseInterval ;
    :hasResidenceOf :E020OregonProperty ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:E020MassachusettsResidence2001_2002 a :ResidenceUseInterval ;
    :hasResidenceOf :E020MassachusettsProperty ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E020OregonResidence2003 a :ResidenceUseInterval ;
    :hasResidenceOf :E020OregonProperty ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E020OregonDisposition a :Disposition ;
    :involves :E020OregonProperty ;
    :sellDate "2003-12-20"^^xsd:date ;
    :potentialGain "225000"^^xsd:integer .

:E020MassachusettsDisposition a :Disposition ;
    :involves :E020MassachusettsProperty ;
    :sellDate "2003-12-20"^^xsd:date ;
    :potentialGain "205000"^^xsd:integer .

:E020Return a :SingleReturn ;
    :associates :E020 ;
    :linkedTo :E020OregonDisposition, :E020MassachusettsDisposition ;
    :exclusionCap "250000"^^xsd:integer .