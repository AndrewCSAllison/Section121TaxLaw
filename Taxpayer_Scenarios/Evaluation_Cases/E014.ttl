@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:TaxpayerE a :Taxpayer ;
    :owns :OwnershipIntervalMI , :OwnershipIntervalSC ;
    :uses :ResidenceIntervalMI_2001_2002 ,
          :ResidenceIntervalSC_2003_2004 ,
          :ResidenceIntervalMI_2005 ;
    :disposesOf :DispositionMI , :DispositionSC .

:PropertyMI a :Property .
:PropertySC a :Property .

:OwnershipIntervalMI a :OwnershipUseInterval ;
    :hasOwnershipOf :PropertyMI ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:OwnershipIntervalSC a :OwnershipUseInterval ;
    :hasOwnershipOf :PropertySC ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:ResidenceIntervalMI_2001_2002 a :ResidenceUseInterval ;
    :hasResidenceOf :PropertyMI ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:ResidenceIntervalSC_2003_2004 a :ResidenceUseInterval ;
    :hasResidenceOf :PropertySC ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:ResidenceIntervalMI_2005 a :ResidenceUseInterval ;
    :hasResidenceOf :PropertyMI ;
    :residenceStart "2005-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:DispositionMI a :Disposition ;
    :involves :PropertyMI ;
    :sellDate "2005-12-18"^^xsd:date ;
    :potentialGain 230000 .

:DispositionSC a :Disposition ;
    :involves :PropertySC ;
    :sellDate "2005-12-18"^^xsd:date ;
    :potentialGain 210000 .

:ReturnE a :SingleReturn ;
    :associates :TaxpayerE ;
    :linkedTo :DispositionMI , :DispositionSC ;
    :exclusionCap 250000 .
