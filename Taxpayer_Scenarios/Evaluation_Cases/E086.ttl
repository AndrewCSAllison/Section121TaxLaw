@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E086 a :Taxpayer ;
    :owns :E086Ownership ;
    :uses :E086Residence ;
    :disposesOf :E086Disposition .

:TownhouseE086 a :Property .

:E086Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :TownhouseE086 ;
    :ownershipStart "1997-04-01"^^xsd:date ;
    :ownershipEnd "2000-09-09"^^xsd:date .

:E086Residence a :ResidenceUseInterval ;
    :hasResidenceOf :TownhouseE086 ;
    :residenceStart "1992-01-01"^^xsd:date ;
    :residenceEnd "1998-06-15"^^xsd:date .

:E086Disposition a :Disposition ;
    :involves :TownhouseE086 ;
    :sellDate "2000-09-09"^^xsd:date ;
    :potentialGain "245000"^^xsd:integer .

:E086Return a :SingleReturn ;
    :associates :E086 ;
    :linkedTo :E086Disposition ;
    :exclusionCap "250000"^^xsd:integer .