@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E226 a :Taxpayer ;
    :owns :E226Ownership ;
    :uses :E226Residence ;
    :disposesOf :E226Disposition .

:E226House a :Property .

:E226Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E226House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date .

:E226Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E226House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E226Disposition a :Disposition ;
    :involves :E226House ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E226Return a :SingleReturn ;
    :associates :E226 ;
    :linkedTo :E226Disposition ;
    :exclusionCap "250000"^^xsd:integer .

:EmploymentRelatedReason a :ReasonType .