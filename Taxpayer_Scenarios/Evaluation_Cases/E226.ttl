:BX a :Taxpayer .

:BXProperty a :Property .

:BXOwnership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :BXProperty ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned 1.0 .

:BXResidence1 a :ResidenceUseInterval ;
    :hasResidenceOf :BXProperty ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:BXDisposition1 a :Disposition ;
    :involves :BXProperty ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain 250000 ;
    :partialExclusionReason :EmploymentRelatedReason .

:BXSingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BX ;
    :linkedTo :BXDisposition1 .

:BX :owns :BXOwnership1 ;
    :uses :BXResidence1 ;
    :disposesOf :BXDisposition1 .