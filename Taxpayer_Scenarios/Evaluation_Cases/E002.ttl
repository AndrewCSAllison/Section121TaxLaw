@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E002 a :Taxpayer ;
    :owns :E002_NY_Ownership, :E002_FL_Ownership ;
    :uses :E002_NY_Residence, :E002_FL_Residence ;
    :disposesOf :E002_NY_Disposition .

:NewYorkResidence a :Property .

:FloridaResidence a :Property .

:E002_NY_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :NewYorkResidence ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E002_FL_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :FloridaResidence ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E002_NY_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :NewYorkResidence ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E002_FL_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :FloridaResidence ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E002_NY_Disposition a :Disposition ;
    :involves :NewYorkResidence ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E002_Return a :SingleReturn ;
    :associates :E002 ;
    :linkedTo :E002_NY_Disposition ;
    :exclusionCap "250000"^^xsd:integer .