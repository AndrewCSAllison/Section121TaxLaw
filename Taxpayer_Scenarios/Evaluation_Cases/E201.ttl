@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E201a a :Taxpayer ;
    :owns :E201aOwnership ;
    :uses :E201aResidence ;
    :disposesOf :HouseDisposition .

:E201b a :Taxpayer ;
    :owns :E201bOwnership ;
    :uses :E201bResidence ;
    :disposesOf :HouseDisposition .

:House a :Property .

:E201aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E201bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E201aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E201bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "325000"^^xsd:integer ;
    :partialExclusionReason :HealthRelatedReason .

:E201JointReturn a :JointReturn ;
    :associates :E201a, :E201b ;
    :linkedTo :HouseDisposition ;
    :exclusionCap "500000"^^xsd:integer .