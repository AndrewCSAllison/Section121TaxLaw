@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E210 a :Taxpayer ;
    :owns :E210Ownership1 ;
    :uses :E210Residence1 ;
    :disposesOf :E210Disposition1 .

:MainResidence a :Property .

:E210Ownership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date .

:E210Residence1 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E210Disposition1 a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E210Return a :SingleReturn ;
    :associates :E210 ;
    :linkedTo :E210Disposition1 ;
    :exclusionCap "250000"^^xsd:integer .