@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E062 a :Taxpayer ;
    :owns :E062Ownership ;
    :uses :E062ResidenceUse ;
    :disposesOf :E062Disposition .

:E062House a :Property .

:E062Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E062House ;
    :ownershipStart "1986-01-01"^^xsd:date ;
    :ownershipEnd "2001-07-01"^^xsd:date .

:E062ResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E062House ;
    :residenceStart "1986-01-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E062Disposition a :Disposition ;
    :involves :E062House ;
    :sellDate "2001-07-01"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:E062Return a :SingleReturn ;
    :associates :E062 ;
    :linkedTo :E062Disposition ;
    :exclusionCap "250000"^^xsd:integer .