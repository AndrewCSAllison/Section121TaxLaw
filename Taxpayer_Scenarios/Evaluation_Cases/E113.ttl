@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E113a a :Taxpayer ;
    :disposesOf :E113Disposition ;
    :owns :E113aOwnership ;
    :uses :E113aResidence .

:E113b a :Taxpayer ;
    :disposesOf :E113Disposition ;
    :owns :E113bOwnership ;
    :uses :E113bResidence .

:E113Property a :Property .

:E113aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E113Property ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date .

:E113bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E113Property ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date .

:E113aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E113Property ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:E113bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E113Property ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:E113Disposition a :Disposition ;
    :involves :E113Property ;
    :sellDate "2017-05-14"^^xsd:date ;
    :potentialGain "480000"^^xsd:integer .

:E113JointReturn a :JointReturn ;
    :associates :E113a, :E113b ;
    :linkedTo :E113Disposition ;
    :exclusionCap "500000"^^xsd:integer .