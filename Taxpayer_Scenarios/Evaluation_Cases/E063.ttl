@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E063 a :Taxpayer ;
    :owns :E063OwnershipInterval ;
    :uses :E063ResidenceInterval ;
    :disposesOf :E063Disposition .

:E063House a :Property .

:E063OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E063House ;
    :ownershipStart "1986-01-01"^^xsd:date ;
    :ownershipEnd "2001-07-01"^^xsd:date .

:E063ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E063House ;
    :residenceStart "1986-01-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E063Disposition a :Disposition ;
    :involves :E063House ;
    :sellDate "2001-07-01"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:E063SingleReturn a :SingleReturn ;
    :associates :E063 ;
    :linkedTo :E063Disposition ;
    :exclusionCap "250000"^^xsd:integer .