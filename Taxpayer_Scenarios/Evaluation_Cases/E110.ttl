@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E110a a :Taxpayer ;
    :disposesOf :E110Disposition ;
    :owns :E110aOwnership ;
    :uses :E110aResidence .

:E110b a :Taxpayer ;
    :disposesOf :E110Disposition ;
    :owns :E110bOwnership ;
    :uses :E110bResidence .

:E110Property a :Property .

:E110aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E110Property ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date .

:E110bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E110Property ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date .

:E110aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E110Property ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:E110bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E110Property ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:E110Disposition a :Disposition ;
    :involves :E110Property ;
    :sellDate "2020-02-28"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E110JointReturn a :JointReturn ;
    :associates :E110a, :E110b ;
    :linkedTo :E110Disposition ;
    :exclusionCap "500000"^^xsd:integer .