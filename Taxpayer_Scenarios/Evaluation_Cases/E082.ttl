@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#########################
# Property Instance
#########################
:Townhouse a :Property .

#########################
# Taxpayer Instance
#########################
:AB a :Taxpayer ;
    :owns :AB_OwnershipInterval1 ;
    :uses :AB_ResidenceInterval1 ;
    :disposesOf :AB_Disposition1 .

#########################
# Ownership Interval
#########################
:AB_OwnershipInterval1 a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "1996-11-05"^^xsd:date ;
    :ownershipEnd "2000-03-01"^^xsd:date ;
    :percentageOwned 1.0 .

#########################
# Residence Use Interval
#########################
:AB_ResidenceInterval1 a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "1995-03-01"^^xsd:date ;
    :residenceEnd "1998-01-30"^^xsd:date .

#########################
# Disposition
#########################
:AB_Disposition1 a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2000-03-01"^^xsd:date ;
    :potentialGain 220000 .

#########################
# Return
#########################
:AB_SingleReturn a :SingleReturn ; 
    :exclusionCap 250000 ;
    :associates :AB ;
    :linkedTo :AB_Disposition1 .