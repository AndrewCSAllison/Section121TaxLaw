@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E082 a :Taxpayer ;
    :owns :E082OwnershipInterval ;
    :uses :E082ResidenceInterval ;
    :disposesOf :E082Disposition .

:E082Townhouse a :Property .

:E082OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E082Townhouse ;
    :ownershipStart "1996-11-05"^^xsd:date ;
    :ownershipEnd "2000-03-01"^^xsd:date .

:E082ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E082Townhouse ;
    :residenceStart "1995-03-01"^^xsd:date ;
    :residenceEnd "1998-01-30"^^xsd:date .

:E082Disposition a :Disposition ;
    :involves :E082Townhouse ;
    :sellDate "2000-03-01"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E082SingleReturn a :SingleReturn ;
    :associates :E082 ;
    :linkedTo :E082Disposition ;
    :exclusionCap "250000"^^xsd:integer .