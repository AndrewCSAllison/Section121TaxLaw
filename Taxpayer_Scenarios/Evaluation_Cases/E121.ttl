@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E121a a :Taxpayer ;
    :owns :E121aOwnership ;
    :uses :E121aResidenceUse ;
    :disposesOf :E121aDisposition .

:E121b a :Taxpayer ;
    :owns :E121bOwnership ;
    :uses :E121bResidenceUse ;
    :disposesOf :E121bDisposition .

:E121aResidence a :Property .

:E121bResidence a :Property .

:E121aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E121aResidence ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "1999-12-31"^^xsd:date .

:E121aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E121aResidence ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E121bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E121bResidence ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "1999-12-31"^^xsd:date .

:E121bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E121bResidence ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E121aDisposition a :Disposition ;
    :involves :E121aResidence ;
    :sellDate "1999-12-31"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E121bDisposition a :Disposition ;
    :involves :E121bResidence ;
    :sellDate "1999-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E121JointReturn a :JointReturn ;
    :associates :E121a, :E121b ;
    :linkedTo :E121aDisposition, :E121bDisposition ;
    :exclusionCap "500000"^^xsd:integer .