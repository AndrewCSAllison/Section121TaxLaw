@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E147a a :Taxpayer ;
    :owns :E147aOwnershipInterval ;
    :disposesOf :ResidenceDisposition .

:E147b a :Taxpayer ;
    :owns :E147bOwnershipInterval ;
    :uses :E147bResidenceUseInterval ;
    :disposesOf :ResidenceDisposition .

:MainResidence a :Property .

:E147aOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2002-02-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E147bOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2002-02-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E147bResidenceUseInterval a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2002-02-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:ResidenceDisposition a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain "400000"^^xsd:integer .

:E147JointReturn a :JointReturn ;
    :associates :E147a, :E147b ;
    :linkedTo :ResidenceDisposition ;
    :exclusionCap "500000"^^xsd:integer .