:AH_1 a :Taxpayer .
:AH_2 a :Taxpayer .

:MainResidence a :Property .

:OUI_AH1 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date ;
    :percentageOwned 0.5 .

:OUI_AH2 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date ;
    :percentageOwned 0.5 .

:RUI_AH1 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:RUI_AH2 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:Disposition_MainResidence a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2014-08-31"^^xsd:date ;
    :potentialGain 720000 .

:SingleReturn_AH1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AH_1 ;
    :linkedTo :Disposition_MainResidence .

:SingleReturn_AH2 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AH_2 ;
    :linkedTo :Disposition_MainResidence .

:AH_1 :owns :OUI_AH1 .
:AH_2 :owns :OUI_AH2 .

:AH_1 :uses :RUI_AH1 .
:AH_2 :uses :RUI_AH2 .

:AH_1 :disposesOf :Disposition_MainResidence .
:AH_2 :disposesOf :Disposition_MainResidence .