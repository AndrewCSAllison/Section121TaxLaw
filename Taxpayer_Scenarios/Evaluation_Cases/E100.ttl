@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E100a a :Taxpayer ;
    :owns :E100aOwnership ;
    :uses :E100aResidence ;
    :disposesOf :HouseSale .

:E100b a :Taxpayer ;
    :owns :E100bOwnership ;
    :uses :E100bResidence ;
    :disposesOf :HouseSale .

:House a :Property .

:E100aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E100bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd "2014-08-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E100aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:E100bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd "2014-08-31"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2014-08-31"^^xsd:date ;
    :potentialGain "720000"^^xsd:integer .

:E100aReturn a :SingleReturn ;
    :associates :E100a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E100bReturn a :SingleReturn ;
    :associates :E100b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .