@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E223 a :Taxpayer ;
    :owns :E223SmallHouseOwnership ;
    :uses :E223SmallHouseResidence ;
    :disposesOf :E223SmallHouseDisposition .

:E223SmallHouse a :Property .

:E223SmallHouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E223SmallHouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date .

:E223SmallHouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E223SmallHouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E223SmallHouseDisposition a :Disposition ;
    :involves :E223SmallHouse ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "120000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E223Return a :SingleReturn ;
    :associates :E223 ;
    :linkedTo :E223SmallHouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .