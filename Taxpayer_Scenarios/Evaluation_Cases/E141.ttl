@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E141Residence a :Property .

:E141a a :Taxpayer ;
    :owns :E141aOwnership ;
    :disposesOf :E141Disposition .

:E141b a :Taxpayer ;
    :owns :E141bOwnership ;
    :uses :E141bResidenceUse ;
    :disposesOf :E141Disposition .

:E141aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E141Residence ;
    :ownershipStart "2001-02-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E141bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E141Residence ;
    :ownershipStart "2001-02-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E141bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E141Residence ;
    :residenceStart "2001-02-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E141Disposition a :Disposition ;
    :involves :E141Residence ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain "350000"^^xsd:integer .

:E141JointReturn a :JointReturn ;
    :associates :E141a, :E141b ;
    :linkedTo :E141Disposition ;
    :exclusionCap "500000"^^xsd:integer .