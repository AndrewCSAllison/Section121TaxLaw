@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E206 a :Taxpayer ;
    :owns :E206OwnershipInterval ;
    :uses :E206ResidenceInterval ;
    :disposesOf :E206Disposition .

:E206Condominium a :Property .

:E206OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E206Condominium ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2003-09-01"^^xsd:date .

:E206ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E206Condominium ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2003-09-01"^^xsd:date .

:E206Disposition a :Disposition ;
    :involves :E206Condominium ;
    :sellDate "2003-09-01"^^xsd:date ;
    :potentialGain "90000"^^xsd:integer ;
    :partialExclusionReason :UnforeseenCircumstanceReason .

:E206Return a :SingleReturn ;
    :associates :E206 ;
    :linkedTo :E206Disposition ;
    :exclusionCap "250000"^^xsd:integer .