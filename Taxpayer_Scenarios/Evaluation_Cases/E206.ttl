@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:BQ a :Taxpayer .

:Condominium a :Property .

:Ownership1 a :OwnershipUseInterval ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2003-09-01"^^xsd:date ;
    :hasOwnershipOf :Condominium .

:Residence1 a :ResidenceUseInterval ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2003-09-01"^^xsd:date ;
    :hasResidenceOf :Condominium .

:Disposition1 a :Disposition ;
    :sellDate "2003-09-01"^^xsd:date ;
    :potentialGain 90000 ;
    :involves :Condominium ;
    :partialExclusionReason :UnforeseenCircumstanceReason .

:BQ :owns :Ownership1 ;
    :uses :Residence1 ;
    :disposesOf :Disposition1 .

:Return1 a :SingleReturn ;
    :associates :BQ ;
    :linkedTo :Disposition1 ;
    :exclusionCap 250000 .