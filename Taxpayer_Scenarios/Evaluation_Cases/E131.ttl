@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E131a a :Taxpayer ;
    :owns :E131aOwnership ;
    :uses :E131aResidenceUse ;
    :disposesOf :E131aDisposition .

:E131b a :Taxpayer ;
    :owns :E131bOwnership ;
    :uses :E131bResidenceUse ;
    :disposesOf :E131bDisposition .

:E131aProperty a :Property .

:E131bProperty a :Property .

:E131aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E131aProperty ;
    :ownershipStart "2001-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E131bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E131bProperty ;
    :ownershipStart "2001-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E131aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E131aProperty ;
    :residenceStart "2001-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E131bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E131bProperty ;
    :residenceStart "2001-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E131aDisposition a :Disposition ;
    :involves :E131aProperty ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E131bDisposition a :Disposition ;
    :involves :E131bProperty ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "310000"^^xsd:integer .

:E131JointReturn a :JointReturn ;
    :associates :E131a, :E131b ;
    :linkedTo :E131aDisposition, :E131bDisposition ;
    :exclusionCap "500000"^^xsd:integer .