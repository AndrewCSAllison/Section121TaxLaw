@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E213a a :Taxpayer ;
    :owns :E213aOwnership1 ;
    :uses :E213aResidence1 ;
    :disposesOf :HouseDisposition .

:E213b a :Taxpayer ;
    :owns :E213bOwnership1 ;
    :uses :E213bResidence1 ;
    :disposesOf :HouseDisposition .

:House a :Property .

:E213aOwnership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E213bOwnership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E213aResidence1 a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E213bResidence1 a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2003-11-30"^^xsd:date .

:HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "140000"^^xsd:integer ;
    :partialExclusionReason :UnforeseenCircumstanceReason .

:E213aReturn a :SingleReturn ;
    :associates :E213a ;
    :linkedTo :HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E213bReturn a :SingleReturn ;
    :associates :E213b ;
    :linkedTo :HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .