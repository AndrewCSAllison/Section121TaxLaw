@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E090 a :Taxpayer ;
    :owns :E090TownhouseOwnership ;
    :uses :E090TownhouseResidence ;
    :disposesOf :E090TownhouseDisposition .

:E090Townhouse a :Property .

:E090TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E090Townhouse ;
    :ownershipStart "1996-12-12"^^xsd:date ;
    :ownershipEnd "2000-04-21"^^xsd:date .

:E090TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E090Townhouse ;
    :residenceStart "1995-04-21"^^xsd:date ;
    :residenceEnd "1998-02-10"^^xsd:date .

:E090TownhouseDisposition a :Disposition ;
    :involves :E090Townhouse ;
    :sellDate "2000-04-21"^^xsd:date ;
    :potentialGain "235000"^^xsd:integer .

:E090SingleReturn a :SingleReturn ;
    :associates :E090 ;
    :linkedTo :E090TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .