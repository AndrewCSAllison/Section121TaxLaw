@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E040 a :Taxpayer ;
    :owns :E040HouseOwnership, :E040LandOwnership ;
    :uses :E040HouseResidence, :E040LandResidence ;
    :disposesOf :E040HouseDisposition, :E040LandDisposition .

:E040House a :Property .

:E040Land a :Property .

:E040HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E040House ;
    :ownershipStart "1995-01-01"^^xsd:date ;
    :ownershipEnd "2000-05-20"^^xsd:date .

:E040LandOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E040Land ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "2000-05-20"^^xsd:date .

:E040HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E040House ;
    :residenceStart "1995-01-01"^^xsd:date ;
    :residenceEnd "2000-05-20"^^xsd:date .

:E040LandResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E040Land ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "2000-05-20"^^xsd:date .

:E040HouseDisposition a :Disposition ;
    :involves :E040House ;
    :sellDate "2000-05-20"^^xsd:date ;
    :potentialGain "-10000"^^xsd:integer .

:E040LandDisposition a :Disposition ;
    :involves :E040Land ;
    :sellDate "2000-05-20"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer .

:E040Return a :SingleReturn ;
    :associates :E040 ;
    :linkedTo :E040HouseDisposition, :E040LandDisposition ;
    :exclusionCap "250000"^^xsd:integer .