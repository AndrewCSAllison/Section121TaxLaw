:TaxpayerN a :Taxpayer ;
    :owns :N_House_Ownership , :N_Land_Ownership ;
    :uses :N_House_Residence , :N_Land_Residence ;
    :disposesOf :N_House_Disposition , :N_Land_Disposition .

:N_House a :Property .
:N_Land a :Property .

:N_House_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :N_House ;
    :ownershipStart "1995-01-01"^^xsd:date ;
    :ownershipEnd "2000-12-31"^^xsd:date .

:N_Land_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :N_Land ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "2000-12-31"^^xsd:date .

:N_House_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :N_House ;
    :residenceStart "1995-01-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:N_Land_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :N_Land ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:N_House_Disposition a :Disposition ;
    :involves :N_House ;
    :sellDate "2000-05-20"^^xsd:date ;
    :potentialGain -10000 .

:N_Land_Disposition a :Disposition ;
    :involves :N_Land ;
    :sellDate "2000-05-20"^^xsd:date ;
    :potentialGain 250000 .

:N_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :TaxpayerN ;
    :linkedTo :N_House_Disposition , :N_Land_Disposition .
