@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E049 a :Taxpayer ;
    :owns :E049Ownership ;
    :uses :E049Residence ;
    :disposesOf :E049Disposition .

:E049House a :Property .

:E049Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E049House ;
    :ownershipStart "1990-05-01"^^xsd:date ;
    :ownershipEnd "2000-08-15"^^xsd:date .

:E049Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E049House ;
    :residenceStart "1990-05-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E049Disposition a :Disposition ;
    :involves :E049House ;
    :sellDate "2000-08-15"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:E049Return a :SingleReturn ;
    :associates :E049 ;
    :linkedTo :E049Disposition ;
    :exclusionCap "250000"^^xsd:integer .