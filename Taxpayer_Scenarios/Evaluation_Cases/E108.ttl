@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E108a a :Taxpayer ;
    :owns :E108aOwnership ;
    :uses :E108aResidenceUse ;
    :disposesOf :E108Disposition .

:E108b a :Taxpayer ;
    :owns :E108bOwnership ;
    :uses :E108bResidenceUse ;
    :disposesOf :E108Disposition .

:E108Property a :Property .

:E108aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E108Property ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date .

:E108bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E108Property ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date .

:E108aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E108Property ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:E108bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E108Property ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:E108Disposition a :Disposition ;
    :involves :E108Property ;
    :sellDate "2022-12-31"^^xsd:date ;
    :potentialGain "256000"^^xsd:integer .

:E108JointReturn a :JointReturn ;
    :associates :E108a, :E108b ;
    :linkedTo :E108Disposition ;
    :exclusionCap "500000"^^xsd:integer .