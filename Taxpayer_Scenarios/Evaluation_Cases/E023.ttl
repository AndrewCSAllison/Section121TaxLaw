@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:H a :Taxpayer ;
    :owns :H_Colorado_OwnershipInterval , :H_Maine_OwnershipInterval ;
    :uses :H_Colorado_UseInterval_1 , :H_Maine_UseInterval , :H_Colorado_UseInterval_2 ;
    :disposesOf :H_Colorado_Disposition , :H_Maine_Disposition .

:Colorado_Property a :Property .
:Maine_Property a :Property .

:H_Colorado_OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :Colorado_Property ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:H_Maine_OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :Maine_Property ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:H_Colorado_UseInterval_1 a :ResidenceUseInterval ;
    :hasResidenceOf :Colorado_Property ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:H_Maine_UseInterval a :ResidenceUseInterval ;
    :hasResidenceOf :Maine_Property ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:H_Colorado_UseInterval_2 a :ResidenceUseInterval ;
    :hasResidenceOf :Colorado_Property ;
    :residenceStart "2005-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:H_Colorado_Disposition a :Disposition ;
    :involves :Colorado_Property ;
    :sellDate "2005-12-18"^^xsd:date ;
    :potentialGain 240000 .

:H_Maine_Disposition a :Disposition ;
    :involves :Maine_Property ;
    :sellDate "2005-12-18"^^xsd:date ;
    :potentialGain 215000 .

:H_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :H ;
    :linkedTo :H_Colorado_Disposition , :H_Maine_Disposition .
