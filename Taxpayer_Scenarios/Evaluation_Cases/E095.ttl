@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E095a a :Taxpayer ;
    :owns :E095aOwnership ;
    :uses :E095aResidence ;
    :disposesOf :HouseSale .

:E095b a :Taxpayer ;
    :owns :E095bOwnership ;
    :uses :E095bResidence ;
    :disposesOf :HouseSale .

:House a :Property .

:E095aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E095bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E095aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:E095bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2020-02-28"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E095aReturn a :SingleReturn ;
    :associates :E095a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E095bReturn a :SingleReturn ;
    :associates :E095b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .