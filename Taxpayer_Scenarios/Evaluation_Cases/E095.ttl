@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AF_1 a :Taxpayer .
:AF_2 a :Taxpayer .

:MainResidence a :Property .

:AF1_OwnUse a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned 0.5 .

:AF2_OwnUse a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned 0.5 .

:AF1_ResUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:AF2_ResUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:Disposition1 a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2020-02-28"^^xsd:date ;
    :potentialGain 300000 .

:AF_1 :owns :AF1_OwnUse ;
       :uses :AF1_ResUse ;
       :disposesOf :Disposition1 .

:AF_2 :owns :AF2_OwnUse ;
       :uses :AF2_ResUse ;
       :disposesOf :Disposition1 .

:Return1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AF_1 ;
    :linkedTo :Disposition1 .

:Return2 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AF_2 ;
    :linkedTo :Disposition1 .