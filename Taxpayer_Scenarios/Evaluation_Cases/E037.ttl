:TaxpayerM a :Taxpayer ;
    :owns :M_House_Ownership , :M_Land_Ownership ;
    :uses :M_House_Residence , :M_Land_Residence ;
    :disposesOf :M_House_Disposition , :M_Land_Disposition .

:MainResidence a :Property .
:LandParcel a :Property .

:M_House_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:M_Land_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :LandParcel ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:M_House_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:M_Land_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :LandParcel ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:M_House_Disposition a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2005-07-01"^^xsd:date ;
    :potentialGain -15000 .

:M_Land_Disposition a :Disposition ;
    :involves :LandParcel ;
    :sellDate "2005-07-01"^^xsd:date ;
    :potentialGain 300000 .

:M_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :TaxpayerM ;
    :linkedTo :M_House_Disposition , :M_Land_Disposition .
