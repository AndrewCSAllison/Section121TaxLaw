@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E037 a :Taxpayer ;
    :owns :E037HouseOwnership, :E037LandOwnership ;
    :uses :E037HouseResidence, :E037LandResidence ;
    :disposesOf :E037HouseDisposition, :E037LandDisposition .

:E037House a :Property .

:E037Land a :Property .

:E037HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E037House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2005-07-01"^^xsd:date .

:E037LandOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E037Land ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-07-01"^^xsd:date .

:E037HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E037House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2005-07-01"^^xsd:date .

:E037LandResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E037Land ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2005-07-01"^^xsd:date .

:E037HouseDisposition a :Disposition ;
    :involves :E037House ;
    :sellDate "2005-07-01"^^xsd:date ;
    :potentialGain "-15000"^^xsd:integer .

:E037LandDisposition a :Disposition ;
    :involves :E037Land ;
    :sellDate "2005-07-01"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E037Return a :SingleReturn ;
    :associates :E037 ;
    :linkedTo :E037HouseDisposition, :E037LandDisposition ;
    :exclusionCap "250000"^^xsd:integer .