@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E010 a :Taxpayer ;
    :owns :E010TexasOwnership, :E010CaliforniaOwnership ;
    :uses :E010TexasResidence2000_2001, :E010CaliforniaResidence2002_2003, :E010TexasResidence2004 ;
    :disposesOf :E010TexasDisposition, :E010CaliforniaDisposition .

:E010TexasProperty a :Property .

:E010CaliforniaProperty a :Property .

:E010TexasOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E010TexasProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E010CaliforniaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E010CaliforniaProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E010TexasResidence2000_2001 a :ResidenceUseInterval ;
    :hasResidenceOf :E010TexasProperty ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E010CaliforniaResidence2002_2003 a :ResidenceUseInterval ;
    :hasResidenceOf :E010CaliforniaProperty ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E010TexasResidence2004 a :ResidenceUseInterval ;
    :hasResidenceOf :E010TexasProperty ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E010TexasDisposition a :Disposition ;
    :involves :E010TexasProperty ;
    :sellDate "2004-12-15"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E010CaliforniaDisposition a :Disposition ;
    :involves :E010CaliforniaProperty ;
    :sellDate "2004-12-15"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E010Return a :SingleReturn ;
    :associates :E010 ;
    :linkedTo :E010TexasDisposition, :E010CaliforniaDisposition ;
    :exclusionCap "250000"^^xsd:integer .
