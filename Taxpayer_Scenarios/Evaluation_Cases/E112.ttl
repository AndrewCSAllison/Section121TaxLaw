@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E112a a :Taxpayer ;
    :owns :E112aOwnership ;
    :uses :E112aResidence ;
    :disposesOf :E112Disposition .

:E112b a :Taxpayer ;
    :owns :E112bOwnership ;
    :uses :E112bResidence ;
    :disposesOf :E112Disposition .

:E112Property a :Property .

:E112aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E112Property ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E112bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E112Property ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E112aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E112Property ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:E112bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E112Property ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:E112Disposition a :Disposition ;
    :involves :E112Property ;
    :sellDate "2017-05-14"^^xsd:date ;
    :potentialGain "480000"^^xsd:integer .

:E112JointReturn a :JointReturn ;
    :associates :E112a, :E112b ;
    :linkedTo :E112Disposition ;
    :exclusionCap "500000"^^xsd:integer .