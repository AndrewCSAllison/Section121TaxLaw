@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#########################
# Property Instance
#########################
:MainResidence a :Property .

#########################
# Taxpayer Instances
#########################
:AF_1 a :Taxpayer .
:AF_2 a :Taxpayer .

#########################
# Ownership Intervals
#########################
:AF1_OwnUse a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned 0.5 .

:AF2_OwnUse a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned 0.5 .

#########################
# Residence Use Intervals
#########################
:AF1_ResUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:AF2_ResUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

#########################
# Disposition
#########################
:MainSale a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2020-02-28"^^xsd:date ;
    :potentialGain 300000 .

#########################
# Returns
#########################
:AF1_Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AF_1 ;
    :linkedTo :MainSale .

:AF2_Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AF_2 ;
    :linkedTo :MainSale .

#########################
# Linking Taxpayers to Ownership and Residence
#########################
:AF_1 :owns :AF1_OwnUse ;
       :uses :AF1_ResUse ;
       :disposesOf :MainSale .

:AF_2 :owns :AF2_OwnUse ;
       :uses :AF2_ResUse ;
       :disposesOf :MainSale . 