@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E096a a :Taxpayer ;
    :owns :E096aOwnership ;
    :uses :E096aResidenceUse ;
    :disposesOf :HouseSale .

:E096b a :Taxpayer ;
    :owns :E096bOwnership ;
    :uses :E096bResidenceUse ;
    :disposesOf :HouseSale .

:House a :Property .

:E096aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E096bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd "2020-02-28"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E096aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:E096bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd "2020-02-28"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2020-02-28"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E096aReturn a :SingleReturn ;
    :associates :E096a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E096bReturn a :SingleReturn ;
    :associates :E096b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .