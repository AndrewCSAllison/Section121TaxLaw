@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#########################
# Taxpayer
#########################
:AY a :Taxpayer .

#########################
# Properties
#########################
:Townhouse a :Property .
:House2000 a :Property .

#########################
# OwnershipUseIntervals
#########################
:AY_Townhouse_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:AY_House2000_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :House2000 ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

#########################
# ResidenceUseIntervals
#########################
:AY_Townhouse_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:AY_House2000_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :House2000 ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

#########################
# Dispositions
#########################
:AY_Townhouse_Disposition a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain 150000 .

:AY_House2000_Disposition a :Disposition ;
    :involves :House2000 ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain 300000 ;
    :partialExclusionReason :NonQualifyingReason .

#########################
# Single Returns
#########################
:AY_Townhouse_Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AY ;
    :linkedTo :AY_Townhouse_Disposition .

:AY_House2000_Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AY ;
    :linkedTo :AY_House2000_Disposition .

#########################
# Ownership & Use Links
#########################
:AY :owns :AY_Townhouse_Ownership , :AY_House2000_Ownership ;
    :uses :AY_Townhouse_Residence , :AY_House2000_Residence ;
    :disposesOf :AY_Townhouse_Disposition , :AY_House2000_Disposition .