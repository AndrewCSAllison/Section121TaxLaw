@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E152 a :Taxpayer ;
    :owns :E152TownhouseOwnership, :E152HouseOwnership ;
    :uses :E152TownhouseResidence, :E152HouseResidence ;
    :disposesOf :E152TownhouseDisposition, :E152HouseDisposition .

:E152Townhouse a :Property .

:E152House a :Property .

:E152TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E152Townhouse ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E152TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E152Townhouse ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E152HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E152House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E152HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E152House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E152TownhouseDisposition a :Disposition ;
    :involves :E152Townhouse ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "150000"^^xsd:integer .

:E152HouseDisposition a :Disposition ;
    :involves :E152House ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E152TownhouseReturn a :SingleReturn ;
    :associates :E152 ;
    :linkedTo :E152TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E152HouseReturn a :SingleReturn ;
    :associates :E152 ;
    :linkedTo :E152HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .