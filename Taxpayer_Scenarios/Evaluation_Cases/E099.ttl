@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E099a a :Taxpayer ;
    :owns :E099aOwnership ;
    :uses :E099aResidence ;
    :disposesOf :HouseSale .

:E099b a :Taxpayer ;
    :owns :E099bOwnership ;
    :uses :E099bResidence ;
    :disposesOf :HouseSale .

:House a :Property .

:E099aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E099bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E099aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:E099bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2017-05-14"^^xsd:date ;
    :potentialGain "540000"^^xsd:integer .

:E099aReturn a :SingleReturn ;
    :associates :E099a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E099bReturn a :SingleReturn ;
    :associates :E099b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .