@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E170 a :Taxpayer ;
    :owns :E170TownhouseOwnership, :E170HouseOwnership ;
    :uses :E170TownhouseResidence, :E170HouseResidence ;
    :disposesOf :E170TownhouseDisposition, :E170HouseDisposition .

:E170Townhouse a :Property .

:E170House a :Property .

:E170TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E170Townhouse ;
    :ownershipStart "1997-01-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date .

:E170TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E170Townhouse ;
    :residenceStart "1997-01-01"^^xsd:date ;
    :residenceEnd "1998-12-31"^^xsd:date .

:E170HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E170House ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E170HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E170House ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E170TownhouseDisposition a :Disposition ;
    :involves :E170Townhouse ;
    :sellDate "2001-12-31"^^xsd:date ;
    :potentialGain "120000"^^xsd:integer .

:E170HouseDisposition a :Disposition ;
    :involves :E170House ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "270000"^^xsd:integer .

:E170TownhouseReturn a :SingleReturn ;
    :associates :E170 ;
    :linkedTo :E170TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E170HouseReturn a :SingleReturn ;
    :associates :E170 ;
    :linkedTo :E170HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .