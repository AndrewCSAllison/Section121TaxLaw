@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E227 a :Taxpayer ;
    :owns :E227Ownership ;
    :uses :E227ResidenceUse ;
    :disposesOf :E227Disposition .

:E227House a :Property .

:E227Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E227House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date .

:E227ResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E227House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E227Disposition a :Disposition ;
    :involves :E227House ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:E227Return a :SingleReturn ;
    :associates :E227 ;
    :linkedTo :E227Disposition ;
    :exclusionCap "250000"^^xsd:integer .