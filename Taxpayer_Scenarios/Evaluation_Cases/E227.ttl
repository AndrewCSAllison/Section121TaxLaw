@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:BX a :Taxpayer ;
    :owns :BX_OwnershipInterval ;
    :uses :BX_ResidenceInterval ;
    :disposesOf :BX_Disposition .

:BX_House a :Property .

:BX_OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :BX_House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned 1.0 .

:BX_ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :BX_House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:BX_Disposition a :Disposition ;
    :involves :BX_House ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain 250000 ;
    :partialExclusionReason :EmploymentRelatedReason .

:BX_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BX ;
    :linkedTo :BX_Disposition .