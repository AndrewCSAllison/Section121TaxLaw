@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E156 a :Taxpayer ;
    :owns :E156TownhouseOwnership, :E156HouseOwnership ;
    :uses :E156TownhouseResidence, :E156HouseResidence ;
    :disposesOf :E156TownhouseDisposition, :E156HouseDisposition .

:E156Townhouse a :Property .

:E156House a :Property .

:E156TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E156Townhouse ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E156TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E156Townhouse ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E156HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E156House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E156HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E156House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E156TownhouseDisposition a :Disposition ;
    :involves :E156Townhouse ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "150000"^^xsd:integer .

:E156HouseDisposition a :Disposition ;
    :involves :E156House ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E156TownhouseReturn a :SingleReturn ;
    :associates :E156 ;
    :linkedTo :E156TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E156HouseReturn a :SingleReturn ;
    :associates :E156 ;
    :linkedTo :E156HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .