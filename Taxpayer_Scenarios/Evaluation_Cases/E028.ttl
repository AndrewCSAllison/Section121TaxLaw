@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E028 a :Taxpayer ;
    :owns :E028TexasOwnership, :E028NewMexicoOwnership ;
    :uses :E028TexasResidence2000_2001, :E028NewMexicoResidence2002_2003, :E028TexasResidence2004 ;
    :disposesOf :E028TexasDisposition, :E028NewMexicoDisposition .

:E028TexasProperty a :Property .

:E028NewMexicoProperty a :Property .

:E028TexasOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E028TexasProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E028NewMexicoOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E028NewMexicoProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E028TexasResidence2000_2001 a :ResidenceUseInterval ;
    :hasResidenceOf :E028TexasProperty ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E028NewMexicoResidence2002_2003 a :ResidenceUseInterval ;
    :hasResidenceOf :E028NewMexicoProperty ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E028TexasResidence2004 a :ResidenceUseInterval ;
    :hasResidenceOf :E028TexasProperty ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E028TexasDisposition a :Disposition ;
    :involves :E028TexasProperty ;
    :sellDate "2004-12-18"^^xsd:date ;
    :potentialGain "230000"^^xsd:integer .

:E028NewMexicoDisposition a :Disposition ;
    :involves :E028NewMexicoProperty ;
    :sellDate "2004-12-18"^^xsd:date ;
    :potentialGain "210000"^^xsd:integer .

:E028SingleReturn a :SingleReturn ;
    :associates :E028 ;
    :linkedTo :E028TexasDisposition, :E028NewMexicoDisposition ;
    :exclusionCap "250000"^^xsd:integer .