@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E167 a :Taxpayer ;
    :owns :E167TownhouseOwnership, :E167HouseOwnership ;
    :uses :E167TownhouseResidence, :E167HouseResidence ;
    :disposesOf :TownhouseDisposition, :HouseDisposition .

:Townhouse a :Property .

:House a :Property .

:E167TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E167TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E167HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2004-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E167HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:TownhouseDisposition a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain "250000"^^xsd:integer .

:HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2006-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:TownhouseSingleReturn a :SingleReturn ;
    :associates :E167 ;
    :linkedTo :TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:HouseSingleReturn a :SingleReturn ;
    :associates :E167 ;
    :linkedTo :HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .