@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E215 a :Taxpayer ;
    :owns :E215CondoOwnership ;
    :uses :E215CondoResidence ;
    :disposesOf :E215CondoDisposition .

:E215Condominium a :Property .

:E215CondoOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E215Condominium ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date .

:E215CondoResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E215Condominium ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:E215CondoDisposition a :Disposition ;
    :involves :E215Condominium ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain "80000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E215Return a :SingleReturn ;
    :associates :E215 ;
    :linkedTo :E215CondoDisposition ;
    :exclusionCap "250000"^^xsd:integer .