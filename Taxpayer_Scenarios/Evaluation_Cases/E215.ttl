:BT a :Taxpayer .

:BTCondo a :Property .

:BT_OwnershipInterval1 a :OwnershipUseInterval ;
    :hasOwnershipOf :BTCondo ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:BT_ResidenceInterval1 a :ResidenceUseInterval ;
    :hasResidenceOf :BTCondo ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:BT_Disposition1 a :Disposition ;
    :involves :BTCondo ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain 80000 ;
    :partialExclusionReason :NonQualifyingReason .

:BT_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BT ;
    :linkedTo :BT_Disposition1 .

:BT :owns :BT_OwnershipInterval1 ;
    :uses :BT_ResidenceInterval1 ;
    :disposesOf :BT_Disposition1 .