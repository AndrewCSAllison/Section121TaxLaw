@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E018 a :Taxpayer ;
    :owns :E018NevadaOwnership, :E018WashingtonOwnership ;
    :uses :E018NevadaResidence2002_2003, :E018WashingtonResidence2004_2005, :E018NevadaResidence2006 ;
    :disposesOf :E018NevadaDisposition, :E018WashingtonDisposition .

:E018NevadaProperty a :Property .

:E018WashingtonProperty a :Property .

:E018NevadaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E018NevadaProperty ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E018WashingtonOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E018WashingtonProperty ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E018NevadaResidence2002_2003 a :ResidenceUseInterval ;
    :hasResidenceOf :E018NevadaProperty ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E018WashingtonResidence2004_2005 a :ResidenceUseInterval ;
    :hasResidenceOf :E018WashingtonProperty ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

:E018NevadaResidence2006 a :ResidenceUseInterval ;
    :hasResidenceOf :E018NevadaProperty ;
    :residenceStart "2006-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:E018NevadaDisposition a :Disposition ;
    :involves :E018NevadaProperty ;
    :sellDate "2006-12-15"^^xsd:date ;
    :potentialGain "235000"^^xsd:integer .

:E018WashingtonDisposition a :Disposition ;
    :involves :E018WashingtonProperty ;
    :sellDate "2006-12-15"^^xsd:date ;
    :potentialGain "210000"^^xsd:integer .

:E018Return a :SingleReturn ;
    :associates :E018 ;
    :linkedTo :E018NevadaDisposition, :E018WashingtonDisposition ;
    :exclusionCap "250000"^^xsd:integer .