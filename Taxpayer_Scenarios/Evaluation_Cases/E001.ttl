@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:TaxpayerA a :Taxpayer ;
    :owns :OwnershipNY ,
          :OwnershipFL ;
    :uses :ResidenceNY ,
          :ResidenceFL ;
    :disposesOf :DispositionNY .

:PropertyNY a :Property .
:PropertyFL a :Property .

:OwnershipNY a :OwnershipUseInterval ;
    :hasOwnershipOf :PropertyNY ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:OwnershipFL a :OwnershipUseInterval ;
    :hasOwnershipOf :PropertyFL ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:ResidenceNY a :ResidenceUseInterval ;
    :hasResidenceOf :PropertyNY ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:ResidenceFL a :ResidenceUseInterval ;
    :hasResidenceOf :PropertyFL ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:DispositionNY a :Disposition ;
    :involves :PropertyNY ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain 300000 .

:ReturnA a :SingleReturn ;
    :associates :TaxpayerA ;
    :linkedTo :DispositionNY ;
    :exclusionCap 250000 .
