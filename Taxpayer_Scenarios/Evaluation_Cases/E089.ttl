@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#########################
# Property
#########################
:Townhouse a :Property .

#########################
# Taxpayer
#########################
:AD a :Taxpayer ;
    :owns :AD_Townhouse_Ownership ;
    :uses :AD_Townhouse_Residence ;
    :disposesOf :AD_Townhouse_Disposition .

#########################
# Ownership Use Interval
#########################
:AD_Townhouse_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "1996-12-12"^^xsd:date ;
    :ownershipEnd "2000-04-21"^^xsd:date ;
    :percentageOwned 1.0 .

#########################
# Residence Use Interval
#########################
:AD_Townhouse_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "1995-04-21"^^xsd:date ;
    :residenceEnd "1998-02-10"^^xsd:date .

#########################
# Disposition
#########################
:AD_Townhouse_Disposition a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2000-04-21"^^xsd:date ;
    :potentialGain 235000 .

#########################
# Return
#########################
:AD_SingleReturn a :SingleReturn ;
    :associates :AD ;
    :linkedTo :AD_Townhouse_Disposition ;
    :exclusionCap 250000 .