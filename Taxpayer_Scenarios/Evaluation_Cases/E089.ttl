@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E089 a :Taxpayer ;
    :owns :E089OwnershipInterval ;
    :uses :E089ResidenceInterval ;
    :disposesOf :E089Disposition .

:E089Townhouse a :Property .

:E089OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E089Townhouse ;
    :ownershipStart "1996-12-12"^^xsd:date ;
    :ownershipEnd "2000-04-21"^^xsd:date .

:E089ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E089Townhouse ;
    :residenceStart "1995-04-21"^^xsd:date ;
    :residenceEnd "1998-02-10"^^xsd:date .

:E089Disposition a :Disposition ;
    :involves :E089Townhouse ;
    :sellDate "2000-04-21"^^xsd:date ;
    :potentialGain "235000"^^xsd:integer .

:E089SingleReturn a :SingleReturn, :Return ;
    :associates :E089 ;
    :linkedTo :E089Disposition ;
    :exclusionCap "250000"^^xsd:integer .