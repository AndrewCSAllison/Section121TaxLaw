@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E069 a :Taxpayer ;
    :owns :E069Ownership ;
    :uses :E069ResidenceUse ;
    :disposesOf :E069Disposition .

:E069House a :Property .

:E069Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E069House ;
    :ownershipStart "1986-05-10"^^xsd:date ;
    :ownershipEnd "2001-09-20"^^xsd:date .

:E069ResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E069House ;
    :residenceStart "1986-05-10"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E069Disposition a :Disposition ;
    :involves :E069House ;
    :sellDate "2001-09-20"^^xsd:date ;
    :potentialGain "195000"^^xsd:integer .

:E069Return a :SingleReturn ;
    :associates :E069 ;
    :linkedTo :E069Disposition ;
    :exclusionCap "250000"^^xsd:integer .