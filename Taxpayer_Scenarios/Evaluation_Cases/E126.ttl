@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E126a a :Taxpayer ;
    :owns :E126aOwnership ;
    :uses :E126aResidenceUse ;
    :disposesOf :E126aDisposition .

:E126b a :Taxpayer ;
    :owns :E126bOwnership ;
    :uses :E126bResidenceUse ;
    :disposesOf :E126bDisposition .

:E126aProperty a :Property .

:E126bProperty a :Property .

:E126aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E126aProperty ;
    :ownershipStart "2000-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E126bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E126bProperty ;
    :ownershipStart "2000-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E126aResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E126aProperty ;
    :residenceStart "2000-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E126bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :E126bProperty ;
    :residenceStart "2000-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E126aDisposition a :Disposition ;
    :involves :E126aProperty ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E126bDisposition a :Disposition ;
    :involves :E126bProperty ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "280000"^^xsd:integer .

:E126JointReturn a :JointReturn ;
    :associates :E126a, :E126b ;
    :linkedTo :E126aDisposition, :E126bDisposition ;
    :exclusionCap "500000"^^xsd:integer .