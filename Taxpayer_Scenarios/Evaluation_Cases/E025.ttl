@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E025 a :Taxpayer ;
    :owns :E025AlabamaOwnership, :E025NevadaOwnership ;
    :uses :E025AlabamaResidence1997_1998, :E025NevadaResidence1999_2000, :E025AlabamaResidence2001 ;
    :disposesOf :E025AlabamaDisposition, :E025NevadaDisposition .

:E025AlabamaProperty a :Property .

:E025NevadaProperty a :Property .

:E025AlabamaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E025AlabamaProperty ;
    :ownershipStart "1997-01-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date .

:E025NevadaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E025NevadaProperty ;
    :ownershipStart "1997-01-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date .

:E025AlabamaResidence1997_1998 a :ResidenceUseInterval ;
    :hasResidenceOf :E025AlabamaProperty ;
    :residenceStart "1997-01-01"^^xsd:date ;
    :residenceEnd "1998-12-31"^^xsd:date .

:E025NevadaResidence1999_2000 a :ResidenceUseInterval ;
    :hasResidenceOf :E025NevadaProperty ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:E025AlabamaResidence2001 a :ResidenceUseInterval ;
    :hasResidenceOf :E025AlabamaProperty ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E025AlabamaDisposition a :Disposition ;
    :involves :E025AlabamaProperty ;
    :sellDate "2001-12-20"^^xsd:date ;
    :potentialGain "225000"^^xsd:integer .

:E025NevadaDisposition a :Disposition ;
    :involves :E025NevadaProperty ;
    :sellDate "2001-12-20"^^xsd:date ;
    :potentialGain "205000"^^xsd:integer .

:E025Return a :SingleReturn ;
    :associates :E025 ;
    :linkedTo :E025AlabamaDisposition, :E025NevadaDisposition ;
    :exclusionCap "250000"^^xsd:integer .