@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E208 a :Taxpayer ;
    :owns :E208Ownership ;
    :uses :E208Residence ;
    :disposesOf :E208Disposition .

:E208House a :Property .

:E208Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :E208House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date .

:E208Residence a :ResidenceUseInterval ;
    :hasResidenceOf :E208House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E208Disposition a :Disposition ;
    :involves :E208House ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E208Return a :SingleReturn ;
    :associates :E208 ;
    :linkedTo :E208Disposition ;
    :exclusionCap "250000"^^xsd:integer .