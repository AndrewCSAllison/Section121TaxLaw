@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E055 a :Taxpayer ;
    :owns :E055OwnershipInterval ;
    :uses :E055ResidenceInterval ;
    :disposesOf :E055Disposition .

:E055House a :Property .

:E055OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E055House ;
    :ownershipStart "1992-06-15"^^xsd:date ;
    :ownershipEnd "2001-02-28"^^xsd:date .

:E055ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E055House ;
    :residenceStart "1992-06-15"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date .

:E055Disposition a :Disposition ;
    :involves :E055House ;
    :sellDate "2001-02-28"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E055Return a :SingleReturn ;
    :associates :E055 ;
    :linkedTo :E055Disposition ;
    :exclusionCap "250000"^^xsd:integer .