@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E175 a :Taxpayer ;
    :owns :E175TownhouseOwnership,
          :E175HouseOwnership ;
    :uses :E175TownhouseResidence,
          :E175HouseResidence ;
    :disposesOf :E175TownhouseDisposition,
                :E175HouseDisposition .

:E175Townhouse a :Property .

:E175House a :Property .

:E175TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E175Townhouse ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date .

:E175TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E175Townhouse ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E175HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E175House ;
    :ownershipStart "2003-12-31"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:E175HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E175House ;
    :residenceStart "2003-12-31"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:E175TownhouseDisposition a :Disposition ;
    :involves :E175Townhouse ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain "190000"^^xsd:integer .

:E175HouseDisposition a :Disposition ;
    :involves :E175House ;
    :sellDate "2006-12-31"^^xsd:date ;
    :potentialGain "310000"^^xsd:integer .

:E175TownhouseReturn a :SingleReturn ;
    :associates :E175 ;
    :linkedTo :E175TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E175HouseReturn a :SingleReturn ;
    :associates :E175 ;
    :linkedTo :E175HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .