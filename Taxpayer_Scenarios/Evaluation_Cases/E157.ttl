@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E157 a :Taxpayer ;
    :owns :E157TownhouseOwnership, :E157HouseOwnership ;
    :uses :E157TownhouseResidence, :E157HouseResidence ;
    :disposesOf :TownhouseDisposition, :HouseDisposition .

:Townhouse a :Property .

:House a :Property .

:E157TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E157TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E157HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E157HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:TownhouseDisposition a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer .

:HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain "320000"^^xsd:integer .

:TownhouseSingleReturn a :SingleReturn ;
    :associates :E157 ;
    :linkedTo :TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:HouseSingleReturn a :SingleReturn ;
    :associates :E157 ;
    :linkedTo :HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .