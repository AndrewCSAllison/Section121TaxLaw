@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E088 a :Taxpayer ;
    :owns :E088TownhouseOwnership ;
    :uses :E088TownhouseResidence ;
    :disposesOf :E088TownhouseSale .

:E088Townhouse a :Property .

:E088TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E088Townhouse ;
    :ownershipStart "1996-12-12"^^xsd:date ;
    :ownershipEnd "2000-04-21"^^xsd:date .

:E088TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E088Townhouse ;
    :residenceStart "1995-04-21"^^xsd:date ;
    :residenceEnd "1998-02-10"^^xsd:date .

:E088TownhouseSale a :Disposition ;
    :involves :E088Townhouse ;
    :sellDate "2000-04-21"^^xsd:date ;
    :potentialGain "235000"^^xsd:integer .

:E088SingleReturn a :SingleReturn ;
    :associates :E088 ;
    :linkedTo :E088TownhouseSale ;
    :exclusionCap "250000"^^xsd:integer .