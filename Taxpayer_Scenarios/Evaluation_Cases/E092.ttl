@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayers
:AE_1 a :Taxpayer .
:AE_2 a :Taxpayer .

### Property
:MainResidence a :Property .

### Ownership Intervals
:OwnershipInterval_AE1 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned 0.5 .
    
:OwnershipInterval_AE2 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned 0.5 .

### Residence Use Intervals
:ResidenceInterval_AE1 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:ResidenceInterval_AE2 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

### Linking Taxpayers to Ownership and Use
:AE_1 :owns :OwnershipInterval_AE1 ;
       :uses :ResidenceInterval_AE1 .

:AE_2 :owns :OwnershipInterval_AE2 ;
       :uses :ResidenceInterval_AE2 .

### Disposition
:Disposition_MainResidence a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2022-12-31"^^xsd:date ;
    :potentialGain 256000 .

:AE_1 :disposesOf :Disposition_MainResidence .
:AE_2 :disposesOf :Disposition_MainResidence .

### Returns
:Return_AE1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AE_1 ;
    :linkedTo :Disposition_MainResidence .

:Return_AE2 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AE_2 ;
    :linkedTo :Disposition_MainResidence .