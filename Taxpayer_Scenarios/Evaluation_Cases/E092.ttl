@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E092a a :Taxpayer ;
    :owns :E092aOwnership ;
    :uses :E092aResidence ;
    :disposesOf :HouseSale .

:E092b a :Taxpayer ;
    :owns :E092bOwnership ;
    :uses :E092bResidence ;
    :disposesOf :HouseSale .

:House a :Property .

:E092aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E092bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:E092aResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:E092bResidence a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:HouseSale a :Disposition ;
    :involves :House ;
    :sellDate "2022-12-31"^^xsd:date ;
    :potentialGain "256000"^^xsd:integer .

:E092aReturn a :SingleReturn ;
    :associates :E092a ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .

:E092bReturn a :SingleReturn ;
    :associates :E092b ;
    :linkedTo :HouseSale ;
    :exclusionCap "250000"^^xsd:integer .