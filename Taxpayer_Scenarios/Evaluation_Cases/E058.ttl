@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E058 a :Taxpayer ;
    :owns :E058OwnershipInterval ;
    :uses :E058ResidenceInterval ;
    :disposesOf :E058Disposition .

:E058House a :Property .

:E058OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E058House ;
    :ownershipStart "1988-09-01"^^xsd:date ;
    :ownershipEnd "2003-05-10"^^xsd:date .

:E058ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E058House ;
    :residenceStart "1988-09-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:E058Disposition a :Disposition ;
    :involves :E058House ;
    :sellDate "2003-05-10"^^xsd:date ;
    :potentialGain "195000"^^xsd:integer .

:E058SingleReturn a :SingleReturn ;
    :associates :E058 ;
    :linkedTo :E058Disposition ;
    :exclusionCap "250000"^^xsd:integer .