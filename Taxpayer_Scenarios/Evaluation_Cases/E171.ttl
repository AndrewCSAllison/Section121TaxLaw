@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E171 a :Taxpayer ;
    :owns :E171TownhouseOwnership, :E171HouseOwnership ;
    :uses :E171TownhouseResidence, :E171HouseResidence ;
    :disposesOf :E171TownhouseDisposition, :E171HouseDisposition .

:E171Townhouse a :Property .

:E171House a :Property .

:E171TownhouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E171Townhouse ;
    :ownershipStart "1997-01-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date .

:E171TownhouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E171Townhouse ;
    :residenceStart "1997-01-01"^^xsd:date ;
    :residenceEnd "1998-12-31"^^xsd:date .

:E171HouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E171House ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date .

:E171HouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E171House ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:E171TownhouseDisposition a :Disposition ;
    :involves :E171Townhouse ;
    :sellDate "2001-12-31"^^xsd:date ;
    :potentialGain "120000"^^xsd:integer .

:E171HouseDisposition a :Disposition ;
    :involves :E171House ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "270000"^^xsd:integer .

:E171TownhouseReturn a :SingleReturn ;
    :associates :E171 ;
    :linkedTo :E171TownhouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .

:E171HouseReturn a :SingleReturn ;
    :associates :E171 ;
    :linkedTo :E171HouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .