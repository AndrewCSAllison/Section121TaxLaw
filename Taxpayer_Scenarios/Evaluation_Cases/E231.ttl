@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E231a a :Taxpayer ;
    :owns :E231aOwnershipInterval ;
    :uses :E231aResidenceInterval ;
    :disposesOf :HouseDisposition .

:E231b a :Taxpayer ;
    :uses :E231bResidenceInterval .

:House a :Property .

:E231aOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "2000-01-15"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:E231aResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "2000-01-15"^^xsd:date .

:E231bResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1999-01-15"^^xsd:date ;
    :residenceEnd "2000-01-15"^^xsd:date .

:HouseDisposition a :Disposition ;
    :involves :House ;
    :sellDate "2000-01-15"^^xsd:date ;
    :potentialGain "500000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:EmploymentRelatedReason a :ReasonType .

:E231JointReturn a :JointReturn ;
    :associates :E231a, :E231b ;
    :linkedTo :HouseDisposition ;
    :exclusionCap "500000"^^xsd:integer .