@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E054 a :Taxpayer ;
    :owns :E054OwnershipInterval ;
    :uses :E054ResidenceInterval ;
    :disposesOf :E054Disposition .

:E054House a :Property .

:E054OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :E054House ;
    :ownershipStart "1985-03-01"^^xsd:date ;
    :ownershipEnd "1999-11-30"^^xsd:date .

:E054ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :E054House ;
    :residenceStart "1985-03-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date .

:E054Disposition a :Disposition ;
    :involves :E054House ;
    :sellDate "1999-11-30"^^xsd:date ;
    :potentialGain "150000"^^xsd:integer .

:E054Return a :SingleReturn ;
    :associates :E054 ;
    :linkedTo :E054Disposition ;
    :exclusionCap "250000"^^xsd:integer .