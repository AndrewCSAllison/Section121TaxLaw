@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayer
:BC a :Taxpayer .

### Properties
:Townhouse a :Property .
:House a :Property .

### Ownership and Residence Intervals
:BC_Townhouse_OWN a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BC_Townhouse_RES a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:BC_House_OWN a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BC_House_RES a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

### Dispositions
:BC_Townhouse_DISP a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain 220000 .

:BC_House_DISP a :Disposition ;
    :involves :House ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain 350000 .

### Returns
:BC_Townhouse_RETURN a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BC ;
    :linkedTo :BC_Townhouse_DISP .

:BC_House_RETURN a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BC ;
    :linkedTo :BC_House_DISP .

### Taxpayer Links
:BC :owns :BC_Townhouse_OWN , :BC_House_OWN ;
    :uses :BC_Townhouse_RES , :BC_House_RES ;
    :disposesOf :BC_Townhouse_DISP , :BC_House_DISP .