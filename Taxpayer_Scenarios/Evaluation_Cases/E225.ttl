@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E225 a :Taxpayer ;
    :owns :E225SmallHouseOwnership ;
    :uses :E225SmallHouseResidence ;
    :disposesOf :E225SmallHouseDisposition .

:E225SmallHouse a :Property .

:E225SmallHouseOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E225SmallHouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date .

:E225SmallHouseResidence a :ResidenceUseInterval ;
    :hasResidenceOf :E225SmallHouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:E225SmallHouseDisposition a :Disposition ;
    :involves :E225SmallHouse ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "120000"^^xsd:integer ;
    :partialExclusionReason :NonQualifyingReason .

:E225Return a :SingleReturn ;
    :associates :E225 ;
    :linkedTo :E225SmallHouseDisposition ;
    :exclusionCap "250000"^^xsd:integer .