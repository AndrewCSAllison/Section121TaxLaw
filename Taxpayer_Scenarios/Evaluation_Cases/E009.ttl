@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:E009 a :Taxpayer ;
    :owns :E009TexasOwnership,
          :E009CaliforniaOwnership ;
    :uses :E009TexasResidence2000_2001,
          :E009CaliforniaResidence2002_2003,
          :E009TexasResidence2004 ;
    :disposesOf :E009TexasDisposition,
                :E009CaliforniaDisposition .

:E009TexasProperty a :Property .

:E009CaliforniaProperty a :Property .

:E009TexasOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E009TexasProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E009CaliforniaOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :E009CaliforniaProperty ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:E009TexasResidence2000_2001 a :ResidenceUseInterval ;
    :hasResidenceOf :E009TexasProperty ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:E009CaliforniaResidence2002_2003 a :ResidenceUseInterval ;
    :hasResidenceOf :E009CaliforniaProperty ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E009TexasResidence2004 a :ResidenceUseInterval ;
    :hasResidenceOf :E009TexasProperty ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:E009TexasDisposition a :Disposition ;
    :involves :E009TexasProperty ;
    :sellDate "2004-12-15"^^xsd:date ;
    :potentialGain "220000"^^xsd:integer .

:E009CaliforniaDisposition a :Disposition ;
    :involves :E009CaliforniaProperty ;
    :sellDate "2004-12-15"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer .

:E009Return a :SingleReturn ;
    :associates :E009 ;
    :linkedTo :E009TexasDisposition,
              :E009CaliforniaDisposition ;
    :exclusionCap "250000"^^xsd:integer .