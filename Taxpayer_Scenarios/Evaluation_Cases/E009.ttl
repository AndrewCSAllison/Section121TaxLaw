:TaxpayerC a :Taxpayer ;
    :owns :OwnershipC_Texas , :OwnershipC_California ;
    :uses :ResidenceC_Texas1 , :ResidenceC_California , :ResidenceC_Texas2 ;
    :disposesOf :DispositionC_Texas , :DispositionC_California .

:OwnershipC_Texas a :OwnershipUseInterval ;
    :hasOwnershipOf :Property_Texas ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:OwnershipC_California a :OwnershipUseInterval ;
    :hasOwnershipOf :Property_California ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:ResidenceC_Texas1 a :ResidenceUseInterval ;
    :hasResidenceOf :Property_Texas ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:ResidenceC_California a :ResidenceUseInterval ;
    :hasResidenceOf :Property_California ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:ResidenceC_Texas2 a :ResidenceUseInterval ;
    :hasResidenceOf :Property_Texas ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:Property_Texas a :Property .
:Property_California a :Property .

:DispositionC_Texas a :Disposition ;
    :involves :Property_Texas ;
    :sellDate "2004-12-15"^^xsd:date ;
    :potentialGain 220000 .

:DispositionC_California a :Disposition ;
    :involves :Property_California ;
    :sellDate "2004-12-15"^^xsd:date ;
    :potentialGain 200000 .

:ReturnC a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :TaxpayerC ;
    :linkedTo :DispositionC_Texas , :DispositionC_California .
