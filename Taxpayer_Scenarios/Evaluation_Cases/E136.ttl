@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ResidenceE136 a :Property .

:E136a a :Taxpayer ;
    :owns :E136aOwnership ;
    :disposesOf :E136Disposition .

:E136b a :Taxpayer ;
    :owns :E136bOwnership ;
    :uses :E136bResidenceUse ;
    :disposesOf :E136Disposition .

:E136aOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :ResidenceE136 ;
    :ownershipStart "2000-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E136bOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :ResidenceE136 ;
    :ownershipStart "2000-02-01"^^xsd:date ;
    :ownershipEnd "2003-12-31"^^xsd:date .

:E136bResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :ResidenceE136 ;
    :residenceStart "2000-02-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:E136Disposition a :Disposition ;
    :involves :ResidenceE136 ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer .

:E136JointReturn a :JointReturn ;
    :associates :E136a, :E136b ;
    :linkedTo :E136Disposition ;
    :exclusionCap "500000"^^xsd:integer .