@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

:Example_Townhouse_House a owl:Ontology ;
    rdfs:comment "Section 121 Example – Taxpayer A sells a townhouse in 2002 (gain excluded), then a house in 2003 (exclusion not available due to sale within 2 years)." .

#########################
# Taxpayer
#########################
:T010 a :Taxpayer ;
    rdfs:comment "Taxpayer A who owns and sells two properties in consecutive years." .

#########################
# Properties
#########################
:Townhouse a :Property ;
    rdfs:comment "Townhouse used as principal residence from 1998 to 1999, sold in 2002." .

:House a :Property ;
    rdfs:comment "House purchased and used as principal residence from 2000 onward, sold in 2003." .

#########################
# Ownership and Residence Intervals
#########################

### Townhouse
:OwnershipInterval_T010_Townhouse a :OwnershipUseInterval ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2002-01-15"^^xsd:date ;
    :hasOwnershipOf :Townhouse .

:ResidenceInterval_T010_Townhouse a :ResidenceUseInterval ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "1999-12-31"^^xsd:date ;
    :hasResidenceOf :Townhouse .

### House
:OwnershipInterval_T010_House a :OwnershipUseInterval ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2003-06-30"^^xsd:date ;
    :hasOwnershipOf :House .

:ResidenceInterval_T010_House a :ResidenceUseInterval ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2003-06-30"^^xsd:date ;
    :hasResidenceOf :House .

#########################
# Taxpayer Links
#########################
:T010 :owns :OwnershipInterval_T010_Townhouse, :OwnershipInterval_T010_House ;
       :uses :ResidenceInterval_T010_Townhouse, :ResidenceInterval_T010_House ;
       :disposesOf :Disposition_Townhouse, :Disposition_House .

#########################
# Dispositions
#########################

### Townhouse Sale — Qualifies for §121 Exclusion
:Disposition_Townhouse a :Disposition ;
    :sellDate "2002-01-15"^^xsd:date ;
    :potentialGain 200000 ;
    :involves :Townhouse .

### House Sale — Fails §121 Exclusion (Sold Within 2 Years of Prior Exclusion)
:Disposition_House a :Disposition ;
    :sellDate "2003-06-30"^^xsd:date ;
    :potentialGain 300000 ;
    :involves :House .

#########################
# Returns
#########################

### 2002 Sale (Townhouse)
:SingleReturn_Townhouse a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :T010 ;
    :linkedTo :Disposition_Townhouse ;
    rdfs:comment "Taxpayer A’s 2002 return — townhouse sale gain excluded under §121." .

### 2003 Sale (House)
:SingleReturn_House a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :T010 ;
    :linkedTo :Disposition_House ;
    rdfs:comment "Taxpayer A’s 2003 return — gain not excluded due to §121(b)(3) limitation (prior exclusion within 2 years)." .
