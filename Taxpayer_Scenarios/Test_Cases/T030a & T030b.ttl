@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

################################################################################
# Scenario T030 — Joint sale where T030a used §121 in prior 2 years
################################################################################

:T030a a :Taxpayer .
:T030b a :Taxpayer .

:Home_T030 a :Property .

##############################################
# Ownership / Residence (both spouses qualify)
##############################################

:Own_T030a a :OwnershipUseInterval ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd   "2025-05-01"^^xsd:date ;
    :hasOwnershipOf :Home_T030 .

:Own_T030b a :OwnershipUseInterval ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd   "2025-05-01"^^xsd:date ;
    :hasOwnershipOf :Home_T030 .

:Use_T030a a :ResidenceUseInterval ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd   "2025-05-01"^^xsd:date ;
    :hasResidenceOf :Home_T030 .

:Use_T030b a :ResidenceUseInterval ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd   "2025-05-01"^^xsd:date ;
    :hasResidenceOf :Home_T030 .

##############################################
# Prior §121 exclusion event for T030a (2024)
##############################################

:Home_T030_prev a :Property .

:Own_T030a_prev a :OwnershipUseInterval ;
    :ownershipStart "2018-01-01"^^xsd:date ;
    :ownershipEnd   "2024-03-01"^^xsd:date ;
    :hasOwnershipOf :Home_T030_prev .

:Use_T030a_prev a :ResidenceUseInterval ;
    :residenceStart "2018-01-01"^^xsd:date ;
    :residenceEnd   "2024-03-01"^^xsd:date ;
    :hasResidenceOf :Home_T030_prev .

:Disp_T030a_prev a :Disposition ;
    :sellDate "2024-03-01"^^xsd:date ;
    :potentialGain 200000 ;
    :involves :Home_T030_prev .

:T030a :owns :Own_T030a_prev ;
       :uses :Use_T030a_prev ;
       :disposesOf :Disp_T030a_prev .

##############################################
# Current sale (joint sale) — 2025-05-01
##############################################

:Disp_T030 a :Disposition ;
    :sellDate "2025-05-01"^^xsd:date ;
    :potentialGain 350000 ;
    :involves :Home_T030 .

:T030a :owns :Own_T030a ;
       :uses :Use_T030a ;
       :disposesOf :Disp_T030 .

:T030b :owns :Own_T030b ;
       :uses :Use_T030b ;
       :disposesOf :Disp_T030 .

##############################################
# Joint return — will trigger §121(b)(2)(B) fallback
##############################################

:Return_T030 a :JointReturn ;
    :exclusionCap 500000 ;
    :associates :T030a, :T030b ;
    :linkedTo :Disp_T030 .

:Return_T030aPrev a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :T030a ;
    :linkedTo :Disp_T030a_prev .
