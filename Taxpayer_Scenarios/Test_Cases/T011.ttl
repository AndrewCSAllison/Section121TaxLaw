@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

#########################
# Taxpayer Individual
#########################
:T011 a :Taxpayer .

#########################
# Property
#########################
:T011_House a :Property .

#########################
# Ownership Interval
#########################
:T011_OwnInterval a :OwnershipUseInterval ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-30"^^xsd:date ;
    :hasOwnershipOf :T011_House .

:T011 :owns :T011_OwnInterval .

#########################
# Residence Interval
#########################
:T011_ResInterval a :ResidenceUseInterval ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-30"^^xsd:date ;
    :hasResidenceOf :T011_House .

:T011 :uses :T011_ResInterval .

#########################
# Disposition (Sale)
#########################
:T011_Disposition_2004 a :Disposition ;
    :sellDate "2004-06-30"^^xsd:date ;
    :potentialGain 300000 ;
    :involves :T011_House ;
    :partialExclusionReason :EmploymentRelatedReason .

:T011 :disposesOf :T011_Disposition_2004 .

#########################
# Return (Single Filer)
#########################
:T011_Return_2004 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :T011 ;
    :linkedTo :T011_Disposition_2004 .
