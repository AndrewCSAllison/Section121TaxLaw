@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

:T002 a :Taxpayer ;
    rdfs:label "T002" ;
    rdfs:comment "Owns two residences (Virginia and Maine). Principal residence VA in 1999,2000,2003; ME in 2001-2002. Eligible for §121 exclusion for sale of either residence (but not both) during 2003." ;
    :owns :Own_VA , :Own_ME ;
    :uses :ResUse_VA_1999_2000 , :ResUse_VA_2003 , :ResUse_ME_2001_2002 ;
    :disposesOf :Disposition_VA_2003 , :Disposition_ME_2003 .

################################
# Properties (real estate)
################################
:Property_VA a :Property ;
    rdfs:label "Virginia Residence" ;
    rdfs:comment "Primary Virginia residence used by Taxpayer B in 1999, 2000 and 2003." .

:Property_ME a :Property ;
    rdfs:label "Maine Residence" ;
    rdfs:comment "Maine residence used by Taxpayer B in 2001 and 2002." .

################################
# Ownership intervals
################################
:Own_VA a :OwnershipUseInterval ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd   "2004-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_VA ;
    rdfs:comment "Assumed continuous ownership spanning the periods described; adjusted to ensure clear ownership through 2003." .

:Own_ME a :OwnershipUseInterval ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd   "2004-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_ME ;
    rdfs:comment "Assumed continuous ownership spanning the periods described; adjusted to ensure clear ownership through 2003." .

################################
# Residence (use) intervals
################################
:ResUse_VA_1999_2000 a :ResidenceUseInterval ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd   "2000-12-31"^^xsd:date ;
    :hasResidenceOf :Property_VA ;
    rdfs:comment "VA principal residence during 1999 and 2000." .

:ResUse_VA_2003 a :ResidenceUseInterval ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd   "2003-12-31"^^xsd:date ;
    :hasResidenceOf :Property_VA ;
    rdfs:comment "VA principal residence during 2003." .

:ResUse_ME_2001_2002 a :ResidenceUseInterval ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd   "2002-12-31"^^xsd:date ;
    :hasResidenceOf :Property_ME ;
    rdfs:comment "ME principal residence during 2001 and 2002." .

################################
# Dispositions (sales/exchanges) occurring in 2003
################################
:Disposition_VA_2003 a :Disposition ;
    :sellDate "2003-06-01"^^xsd:date ;
    :potentialGain 180000 ;
    :involves :Property_VA ;
    rdfs:comment "Sale of Virginia residence in 2003. Taxpayer B qualifies for §121 on this property based on 2 years' use within the 5-year lookback." .

:Disposition_ME_2003 a :Disposition ;
    :sellDate "2003-06-01"^^xsd:date ;
    :potentialGain 140000 ;
    :involves :Property_ME ;
    rdfs:comment "Sale of Maine residence in 2003. Taxpayer B also meets the 2-year use test for Maine within the 5-year lookback. Only one exclusion may be claimed for the tax year; both dispositions are represented, but only one exclusion is allowable under §121." .

################################
# Return linking dispositions and taxpayer
################################
:Return_TB_2003 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :T002 ;
    :linkedTo :Disposition_VA_2003 , :Disposition_ME_2003 ;
    rdfs:comment "Single filer return for Taxpayer B in 2003. Exclusion cap set to $250,000 for single returns. Although both properties meet the use/ownership tests in the 5-year lookback, §121 allows the exclusion for only one residence in the same tax year." .

################################
# Reason types (from ontology)
################################
:EmploymentRelatedReason a :ReasonType .
:HealthRelatedReason a :ReasonType .
:UnforeseenCircumstanceReason a :ReasonType .
:NonQualifyingReason a :ReasonType .
