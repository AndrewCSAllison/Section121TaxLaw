@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

:T075 a :Taxpayer .

:T075_Property a :Property .

##################################
# Ownership & Residence Intervals
##################################

:T075_OwnInterval a :OwnershipUseInterval ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd   "2004-01-01"^^xsd:date ;
    :hasOwnershipOf :T075_Property .

:T075_ResInterval a :ResidenceUseInterval ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd   "2004-01-01"^^xsd:date ;
    :hasResidenceOf :T075_Property .

:T075 :owns :T075_OwnInterval ;
      :uses :T075_ResInterval .

#####################
# Disposition (Sale)
#####################

:T075_Sale a :Disposition ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain "120000"^^xsd:integer ;
    :involves :T075_Property ;
    :partialExclusionReason :NonQualifyingReason .

:T075 :disposesOf :T075_Sale .

###########################
# Return (Single)
###########################

:T075_SingleReturn a :SingleReturn ;
    :associates :T075 ;
    :linkedTo :T075_Sale ;
    :exclusionCap "250000"^^xsd:integer .
