@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayers
:T032a a :Taxpayer .
:T032b a :Taxpayer .

### Property
:Property_T032 a :Property .

### Ownership Intervals
:Own_T032a_1 a :OwnershipUseInterval ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd   "2020-02-28"^^xsd:date ;
    :hasOwnershipOf :Property_T032 ;
    :percentageOwned "0.5"^^xsd:decimal .

:Own_T032b_1 a :OwnershipUseInterval ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd   "2020-02-28"^^xsd:date ;
    :hasOwnershipOf :Property_T032 ;
    :percentageOwned "0.5"^^xsd:decimal .

### Residence Use
:Use_T032a_1 a :ResidenceUseInterval ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd   "2020-02-28"^^xsd:date ;
    :hasResidenceOf :Property_T032 .

:Use_T032b_1 a :ResidenceUseInterval ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd   "2020-02-28"^^xsd:date ;
    :hasResidenceOf :Property_T032 .

### Disposition (one sale; the gain is split by ownership share)
:Disp_T032 a :Disposition ;
    :sellDate "2020-02-28"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer ;
    :involves :Property_T032 .

### Associations
:T032a :owns :Own_T032a_1 ; :uses :Use_T032a_1 ; :disposesOf :Disp_T032 .
:T032b :owns :Own_T032b_1 ; :uses :Use_T032b_1 ; :disposesOf :Disp_T032 .

### Individual Returns
:Return_T032a a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :T032a ;
    :linkedTo :Disp_T032 .

:Return_T032b a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :T032b ;
    :linkedTo :Disp_T032 .
