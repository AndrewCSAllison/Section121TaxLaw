@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayer
:T057 a :Taxpayer .

### Properties
:Property_T057_1 a :Property .
:Property_T057_2 a :Property .

### Ownership Intervals
:Own_T057_1 a :OwnershipUseInterval ;
    :ownershipStart "1997-01-01"^^xsd:date ;
    :ownershipEnd   "2002-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_T057_1 .

:Own_T057_2 a :OwnershipUseInterval ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd   "2001-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_T057_2 .

### Residence Use Intervals
:Use_T057_1 a :ResidenceUseInterval ;
    :residenceStart "1997-01-01"^^xsd:date ;
    :residenceEnd   "1998-12-31"^^xsd:date ;
    :hasResidenceOf :Property_T057_1 .

:Use_T057_2 a :ResidenceUseInterval ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd   "2001-12-31"^^xsd:date ;
    :hasResidenceOf :Property_T057_2 .

### Dispositions
:Disp_T057_1 a :Disposition ;
    :sellDate "2001-12-31"^^xsd:date ;
    :potentialGain "120000"^^xsd:integer ;
    :involves :Property_T057_1 .

:Disp_T057_2 a :Disposition ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "270000"^^xsd:integer ;
    :involves :Property_T057_2 .

### Associations
:T057 :owns :Own_T057_1, :Own_T057_2 ;
       :uses :Use_T057_1, :Use_T057_2 ;
       :disposesOf :Disp_T057_1, :Disp_T057_2 .

### Single Return
:Return_T057 a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :T057 ;
    :linkedTo :Disp_T057_1, :Disp_T057_2 .
