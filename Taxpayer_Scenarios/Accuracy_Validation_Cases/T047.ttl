@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayers
:T047a a :Taxpayer .
:T047b a :Taxpayer .

### Property
:Property_T047 a :Property .

### Ownership Intervals
:Own_T047a_1 a :OwnershipUseInterval ;
    :ownershipStart "2001-02-01"^^xsd:date ;
    :ownershipEnd   "2004-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_T047 ;
    :percentageOwned 1.0 .

:Own_T047b_1 a :OwnershipUseInterval ;
    :ownershipStart "2001-02-01"^^xsd:date ;
    :ownershipEnd   "2004-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_T047 ;
    :percentageOwned 1.0 . 
    
### Residence Use
# Only T047b qualifies
:Use_T047b_1 a :ResidenceUseInterval ;
    :residenceStart "2001-02-01"^^xsd:date ;
    :residenceEnd   "2004-12-31"^^xsd:date ;
    :hasResidenceOf :Property_T047 .

### Disposition
:Disp_T047 a :Disposition ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain "350000"^^xsd:integer ;
    :involves :Property_T047 .

### Associations
:T047a :owns :Own_T047a_1 ; :disposesOf :Disp_T047 .
:T047b :owns :Own_T047b_1 ; :uses :Use_T047b_1 ; :disposesOf :Disp_T047 .

### Joint Return
:Return_T047 a :JointReturn ;
    :exclusionCap "500000"^^xsd:integer ;
    :associates :T047a, :T047b ;
    :linkedTo :Disp_T047 .
