##############################
# T017
##############################

:T017 a :Taxpayer .

:Property_T017_House a :Property .

:Own_T017_House a :OwnershipUseInterval ;
    :ownershipStart "1990-05-01"^^xsd:date ;
    :ownershipEnd "2000-08-15"^^xsd:date ;
    :hasOwnershipOf :Property_T017_House .

:T017 :owns :Own_T017_House .

:Use_T017_House_1990_1997 a :ResidenceUseInterval ;
    :residenceStart "1990-05-01"^^xsd:date ;
    :residenceEnd "1997-12-31"^^xsd:date ;
    :hasResidenceOf :Property_T017_House .

:T017 :uses :Use_T017_House_1990_1997 .

:Disp_T017_House a :Disposition ;
    :sellDate "2000-08-15"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer ;
    :involves :Property_T017_House .

:T017 :disposesOf :Disp_T017_House .

:Return_T017 a :SingleReturn ;
    :associates :T017 ;
    :linkedTo :Disp_T017_House ;
    :exclusionCap "250000"^^xsd:integer .