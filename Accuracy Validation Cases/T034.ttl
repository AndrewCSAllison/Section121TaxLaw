@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayers
:T034a a :Taxpayer .
:T034b a :Taxpayer .

### Property
:Property_T034 a :Property .

### Ownership Intervals
:Own_T034a_1 a :OwnershipUseInterval ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd   "2014-08-31"^^xsd:date ;
    :hasOwnershipOf :Property_T034 .

:Own_T034b_1 a :OwnershipUseInterval ;
    :ownershipStart "2012-09-01"^^xsd:date ;
    :ownershipEnd   "2014-08-31"^^xsd:date ;
    :hasOwnershipOf :Property_T034 .

### Residence Use
:Use_T034a_1 a :ResidenceUseInterval ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd   "2014-08-31"^^xsd:date ;
    :hasResidenceOf :Property_T034 .

:Use_T034b_1 a :ResidenceUseInterval ;
    :residenceStart "2012-09-01"^^xsd:date ;
    :residenceEnd   "2014-08-31"^^xsd:date ;
    :hasResidenceOf :Property_T034 .

### Dispositions (split gain)
:Disp_T034a a :Disposition ;
    :sellDate "2014-08-31"^^xsd:date ;
    :potentialGain "360000"^^xsd:integer ;
    :involves :Property_T034 .

:Disp_T034b a :Disposition ;
    :sellDate "2014-08-31"^^xsd:date ;
    :potentialGain "360000"^^xsd:integer ;
    :involves :Property_T034 .

### Associations
:T034a :owns :Own_T034a_1 ; :uses :Use_T034a_1 ; :disposesOf :Disp_T034a .
:T034b :owns :Own_T034b_1 ; :uses :Use_T034b_1 ; :disposesOf :Disp_T034b .

### Individual Returns
:Return_T034a a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :T034a ;
    :linkedTo :Disp_T034a .

:Return_T034b a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :T034b ;
    :linkedTo :Disp_T034b .
