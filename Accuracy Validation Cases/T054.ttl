@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayer
:T054 a :Taxpayer .

### Properties
:Property_T054_1 a :Property .
:Property_T054_2 a :Property .

### Ownership Intervals
:Own_T054_1 a :OwnershipUseInterval ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd   "2000-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_T054_1 .

:Own_T054_2 a :OwnershipUseInterval ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd   "2003-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_T054_2 .

### Residence Use Intervals
:Use_T054_1 a :ResidenceUseInterval ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd   "2000-12-31"^^xsd:date ;
    :hasResidenceOf :Property_T054_1 .

:Use_T054_2 a :ResidenceUseInterval ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd   "2003-12-31"^^xsd:date ;
    :hasResidenceOf :Property_T054_2 .

### Dispositions
:Disp_T054_1 a :Disposition ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "200000"^^xsd:integer ;
    :involves :Property_T054_1 .

:Disp_T054_2 a :Disposition ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "280000"^^xsd:integer ;
    :involves :Property_T054_2 .

### Associations
:T054 :owns :Own_T054_1, :Own_T054_2 ;
       :uses :Use_T054_1, :Use_T054_2 ;
       :disposesOf :Disp_T054_1, :Disp_T054_2 .

### Single Return
:Return_T054 a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :T054 ;
    :linkedTo :Disp_T054_1, :Disp_T054_2 .
