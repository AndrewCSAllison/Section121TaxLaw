PREFIX : <http://example.org/section121#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

INSERT {
  GRAPH :InterpretationInfo {
    ?interpNode a :InterpretationInfo ;
                :forTaxpayer ?taxpayer ;
                :forDisposition ?disposition ;
                :sellDate ?sellDate ;
                :involves ?property ;
                :Rule121aFinal ?Rule121aFinal ;
                :Rule121aSatisfied ?Rule121aSatisfiedSafe ;
                :Rule121b1Excluded ?Rule121b1Excluded ;
                :Rule121b2AExcluded ?Rule121b2AExcluded ;
                :Rule121b2BExcluded ?Rule121b2BExcluded ;
                :Rule121b3Applies ?Rule121b3Applies ;
                :Rule121cExcluded ?Rule121cExcluded ;
                :Rule121cReasonNonQualifying ?Rule121cReasonNonQualifying ;
                :Rule121d1Applies ?Rule121d1Applies ;
                :partialExclusionReason ?reason ;
                :gainShare ?gainShare ;
                :excludedGain ?excludedGain ;
                :taxableGain ?taxableGain ;
                :potentialGain ?realizedGain .
    ?disposition :hasInterpretationInfo ?interpNode .
  }
}
WHERE {
  ?disposition :sellDate ?sellDate .

  GRAPH :DerivedInfo {
    ?disposition :hasDerivedInfo ?derivedNode .
    ?derivedNode a :DerivedInfo ;
                 :forTaxpayer ?taxpayer ;
                 :forDisposition ?disposition ;
                 :involves ?property ;
                 :potentialGain ?gain ;
                 :ownDays ?ownDays ;
                 :resDays ?resDays ;
                 :shorterDays ?shorterDays ;
                 :numeratorDays ?numeratorDays ;
                 :daysSincePrevQualifyingSale ?daysSincePrevQualifyingSale .

    OPTIONAL { ?derivedNode :singleReturnFlag ?isSingleReturn }
    OPTIONAL { ?derivedNode :singleExclusionCap ?singleCap }
    OPTIONAL { ?derivedNode :jointReturnFlag ?isJointReturn }
    OPTIONAL { ?derivedNode :jointExclusionCap ?jointCap }
    OPTIONAL { ?derivedNode :allocableGain ?allocableGain }
    OPTIONAL { ?derivedNode :spouseOwnDays ?spouseOwnDays }
    OPTIONAL { ?derivedNode :spouseResDays ?spouseResDays }
    OPTIONAL { ?derivedNode :spouseDaysSincePrevQualifyingSale ?spouseDaysSincePrevQualifyingSale }
    OPTIONAL { ?derivedNode :coFilerOnDisposition ?coFilerOnDisposition }
    OPTIONAL { ?derivedNode :gainShare ?derivedGainShare }
    OPTIONAL { ?derivedNode :coFilerRanksFirst ?coFilerRanksFirst }
    OPTIONAL { ?derivedNode :hasReason ?reasonType }
  }

  # --- Subquery 1: loss guard ---
  OPTIONAL {
    SELECT ?disposition (COUNT(?lossDisp) AS ?lossCount)
    WHERE {
      GRAPH :DerivedInfo {
        ?disposition :hasDerivedInfo ?anchorNode .
        ?anchorNode :forTaxpayer ?anchorTaxpayer .
      }
      ?disposition :sellDate ?anchorDate .

      GRAPH :DerivedInfo {
        ?lossNode a :DerivedInfo ;
                  :forTaxpayer ?anchorTaxpayer ;
                  :forDisposition ?lossDisp ;
                  :allocableGain ?lossGain .
        FILTER(?lossGain < 0)
      }
      ?lossDisp :sellDate ?anchorDate .
    }
    GROUP BY ?disposition
  }

  # --- Subquery 2: better disposition check ---
  OPTIONAL {
    SELECT ?disposition (COUNT(?betterDisp) AS ?betterCount)
    WHERE {
      GRAPH :DerivedInfo {
        ?disposition :hasDerivedInfo ?anchorNode .
        ?anchorNode :forTaxpayer ?anchorTaxpayer ;
                    :allocableGain ?thisGain .
      }
      ?disposition :sellDate ?anchorDate .

      GRAPH :DerivedInfo {
        ?otherNode a :DerivedInfo ;
                   :forTaxpayer ?anchorTaxpayer ;
                   :forDisposition ?betterDisp ;
                   :allocableGain ?otherGain .
        FILTER(?betterDisp != ?disposition)
        FILTER(
          ?otherGain > ?thisGain ||
          (?otherGain = ?thisGain && STR(?betterDisp) > STR(?disposition))
        )
      }
      ?betterDisp :sellDate ?anchorDate .
    }
    GROUP BY ?disposition
  }

  # --- Null-safe variables ---
  BIND(IF(bound(?singleCap),  xsd:decimal(?singleCap),  xsd:decimal(250000)) AS ?singleCapSafe)
  BIND(IF(bound(?jointCap),   xsd:decimal(?jointCap),   xsd:decimal(500000)) AS ?jointCapSafe)
  BIND(IF(bound(?isSingleReturn), ?isSingleReturn, false) AS ?isSingleReturnSafe)
  BIND(IF(bound(?isJointReturn),  ?isJointReturn,  false) AS ?isJointReturnSafe)
  BIND(IF(bound(?spouseOwnDays),  ?spouseOwnDays,  0)     AS ?spouseOwnDaysSafe)
  BIND(IF(bound(?spouseResDays),  ?spouseResDays,  0)     AS ?spouseResDaysSafe)
  BIND(IF(bound(?spouseDaysSincePrevQualifyingSale), ?spouseDaysSincePrevQualifyingSale, -1)          AS ?spouseDaysSincePrevQualifyingSaleSafe)
  BIND(IF(bound(?allocableGain), xsd:decimal(?allocableGain), xsd:decimal(0)) AS ?allocableGainSafe)
  BIND(IF(bound(?coFilerOnDisposition), ?coFilerOnDisposition, false) AS ?coFilerOnDispositionSafe)

  # --- §121(a) ---
  BIND(IF(?ownDays >= 730 && ?resDays >= 730, true, false) AS ?Rule121aSatisfiedSafe)
  BIND(IF(?spouseOwnDaysSafe >= 730 && ?spouseResDaysSafe >= 730, true, false) AS ?spouseRule121aSatisfiedSafe)

  # --- §121(b)(3) prior-sale lookback ---
  BIND(
    IF(bound(?daysSincePrevQualifyingSale) &&
       ?daysSincePrevQualifyingSale >= 0 &&
       ?daysSincePrevQualifyingSale < 730,
       true, false)
  AS ?Rule121b3PriorSale)

  BIND(
    IF(?spouseDaysSincePrevQualifyingSaleSafe >= 0 &&
       ?spouseDaysSincePrevQualifyingSaleSafe < 730,
       true, false)
  AS ?spouseRule121b3Applies)

  # --- §121(b)(3) concurrent block ---
  BIND(
    (COALESCE(?lossCount, 0) = 0 && COALESCE(?betterCount, 0) > 0)
  AS ?Rule121b3ConcurrentBlock)

  BIND((?Rule121b3PriorSale || ?Rule121b3ConcurrentBlock) AS ?Rule121b3Applies)

  # --- Override §121(a) ---
  # Also serves as the §121(c)(2)(A) test: ?Rule121aFinal is false when §121(a)
  # would not apply by reason of (i) failing ownership/use or (ii) §121(b)(3).
  # Consumed as !?Rule121aFinal in ?ownPartialClaim and ?Rule121cExcluded.
  BIND(IF(COALESCE(?Rule121b3Applies, false), false, COALESCE(?Rule121aSatisfiedSafe, false)) AS ?Rule121aFinal)
  BIND(IF(COALESCE(?spouseRule121b3Applies, false), false, COALESCE(?spouseRule121aSatisfiedSafe, false)) AS ?spouseRule121aFinal)

  # --- §121(b)(2)(B): each spouse treated as owning for the period either owned ---
  BIND(IF(?spouseOwnDaysSafe > ?ownDays,
          ?spouseOwnDaysSafe, ?ownDays) AS ?betterSpouseOwnershipDays)

  # §121(c)(1): reduced-exclusion numerator is the shortest of
  # ownership (as imputed above), use, and time since the prior excluded sale.
  BIND(IF(?betterSpouseOwnershipDays < ?resDays,
          ?betterSpouseOwnershipDays, ?resDays) AS ?betterShorterDays)

  BIND(IF(?daysSincePrevQualifyingSale >= 0 &&
          ?daysSincePrevQualifyingSale < ?betterShorterDays,
          ?daysSincePrevQualifyingSale, ?betterShorterDays) AS ?betterNumeratorDays)

  # --- Gain attribution between spouses filing jointly on one sale ---
  BIND(IF(?betterSpouseOwnershipDays < ?spouseResDaysSafe,
          ?betterSpouseOwnershipDays, ?spouseResDaysSafe) AS ?spouseShorterDays)
  BIND(
    bound(?reasonType) &&
    ?reasonType IN (:EmploymentRelatedReason, :HealthRelatedReason, :UnforeseenCircumstanceReason)
    AS ?qualifyingPartialReason
  )
  BIND(?qualifyingPartialReason && !?Rule121aFinal &&
       ?betterNumeratorDays > 0 && ?betterNumeratorDays < 730 AS ?ownPartialClaim)
  BIND(?qualifyingPartialReason && !?spouseRule121aFinal &&
       ?spouseShorterDays > 0 && ?spouseShorterDays < 730 AS ?spousePartialClaim)

  # --- Both spouses qualify: individual row output still carries the whole gain ---
  BIND(IF(bound(?coFilerRanksFirst), ?coFilerRanksFirst, false) AS ?coFilerRanksFirstSafe)
  BIND(?isJointReturnSafe && ?coFilerOnDispositionSafe &&
       ?Rule121aFinal && ?spouseRule121aFinal AS ?bothSpousesQualify)

  BIND(
    (?isJointReturnSafe && ?coFilerOnDispositionSafe &&
     ?Rule121aFinal && !?spouseRule121aFinal && !?spousePartialClaim) ||
    (?bothSpousesQualify && !?coFilerRanksFirstSafe)
    AS ?carriesWholeGain
  )
  BIND(
    (?isJointReturnSafe && ?coFilerOnDispositionSafe &&
     !?Rule121aFinal && ?spouseRule121aFinal && !?ownPartialClaim) ||
    (?bothSpousesQualify && ?coFilerRanksFirstSafe)
    AS ?yieldsGainToCoFiler
  )

  BIND(
    IF(?carriesWholeGain,
       xsd:decimal(?gain),
       IF(?yieldsGainToCoFiler,
          xsd:decimal(0),
          ?allocableGainSafe)
    ) AS ?realizedGain
  )

  # --- Share of the sale's gain this row carries ---
  BIND(
    IF(?carriesWholeGain,
       xsd:decimal(1.0),
       IF(?yieldsGainToCoFiler,
          xsd:decimal(0),
          IF(bound(?derivedGainShare), xsd:decimal(?derivedGainShare), xsd:decimal(1.0)))
    ) AS ?gainShare
  )

  # --- §121(b)(1) ---
  BIND(
    IF(?isSingleReturnSafe && ?Rule121aFinal,
       IF(?realizedGain <= 0,
          xsd:decimal(0),
          IF(?realizedGain > ?singleCapSafe, ?singleCapSafe, ?realizedGain)
       ),
       xsd:decimal(0)
    ) AS ?Rule121b1Excluded
  )

  # --- §121(b)(2)(A) ---
  BIND(
    IF(
      ?isJointReturnSafe &&
      (?ownDays >= 730 || ?spouseOwnDaysSafe >= 730) &&
      (?resDays >= 730 && ?spouseResDaysSafe >= 730) &&
      (!?Rule121b3Applies && !?spouseRule121b3Applies),
      IF(?realizedGain > ?jointCapSafe, ?jointCapSafe, ?realizedGain),
      xsd:decimal(0)
    ) AS ?Rule121b2AExcluded
  )

  # --- §121(b)(2)(B) ---
  BIND(
    IF(
      ?isJointReturnSafe &&
      !(?Rule121b2AExcluded > 0) &&
      COALESCE(?Rule121aFinal, false) &&
      (
        (COALESCE(?Rule121aFinal, false) && !COALESCE(?spouseRule121aFinal, false)) ||
        (!COALESCE(?Rule121aFinal, false) && COALESCE(?spouseRule121aFinal, false))
      ),
      IF(?realizedGain > (?jointCapSafe / 2), (?jointCapSafe / 2), ?realizedGain),
      xsd:decimal(0)
    ) AS ?Rule121b2BExcluded
  )

  # --- §121(c) ---
  # Gate is §121(c)(2): (A) !?Rule121aFinal and (B) the reason list.
  # Amount is §121(c)(1) with the numerator.
  BIND(
    IF(bound(?betterNumeratorDays) && bound(?reasonType) &&
       !?Rule121aFinal &&
       ?betterNumeratorDays > 0 && ?betterNumeratorDays < 730 &&
       ?reasonType IN (:EmploymentRelatedReason, :HealthRelatedReason, :UnforeseenCircumstanceReason),
       ROUND((?betterNumeratorDays / 730.0 * 250000) * 100) / 100,
       xsd:decimal(0)
    ) AS ?Rule121cExcluded
  )

  # --- §121(c) claim refused: reason outside §121(c)(2)(B) ---
  BIND(
    bound(?reasonType) && !?qualifyingPartialReason && !?Rule121aFinal
    AS ?Rule121cReasonNonQualifying
  )

  BIND(?reasonType AS ?reason)

  # --- §121(d)(1) ---
  BIND(
    IF(
      ?isJointReturnSafe && (?Rule121aFinal || ?spouseRule121aFinal),
      true, false
    ) AS ?Rule121d1Applies
  )

  # --- Combine exclusions ---
  BIND(
    IF(bound(?Rule121b2BExcluded) && ?Rule121b2BExcluded > 0,
       IF(bound(?Rule121cExcluded) && ?Rule121cExcluded > 0,
          IF(?Rule121cExcluded < ?Rule121b2BExcluded, ?Rule121cExcluded, ?Rule121b2BExcluded),
          ?Rule121b2BExcluded),
       ?Rule121cExcluded
    ) AS ?finalExcludedGain
  )

  # --- Select highest valid exclusion ---
  BIND(
    IF(bound(?Rule121b1Excluded) && ?Rule121b1Excluded > 0,
       ?Rule121b1Excluded,
       IF(bound(?Rule121b2AExcluded) && ?Rule121b2AExcluded > 0,
          ?Rule121b2AExcluded,
          ?finalExcludedGain)
    ) AS ?rawExcludedGain
  )

  # --- Cap at realized gain, floored at zero ---
  BIND(
    IF(?realizedGain <= 0,
       xsd:decimal(0),
       IF(?rawExcludedGain > ?realizedGain, ?realizedGain, ?rawExcludedGain)
    ) AS ?excludedGain
  )

  # --- Taxable gain ---
  BIND(?realizedGain - COALESCE(?excludedGain, 0) AS ?taxableGain)

  # --- Unique interpretation node ---
  BIND(IRI(CONCAT(
    STR(:), "InterpretationInfo_",
    STRAFTER(STR(?taxpayer), "#"), "_",
    STRAFTER(STR(?disposition), "#")
  )) AS ?interpNode)
}
