PREFIX : <http://example.org/section121#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?taxpayer ?property ?sellDate ?numeratorDaysSafe ?percentageOwned ?isSingleReturn ?isJointReturn
       (MAX(?Rule121aFinal) AS ?Rule121aFinal)
       (MAX(?Rule121b1Excluded) AS ?Rule121b1Excluded)
       (MAX(?Rule121b2AExcluded) AS ?Rule121b2AExcluded)
       (MAX(?Rule121b2BExcluded) AS ?Rule121b2BExcluded)
       (MAX(?Rule121b3Applies) AS ?Rule121b3Applies)
       (MAX(?Rule121cExcluded) AS ?Rule121cExcluded)
       (MAX(?Rule121d1Applies) AS ?Rule121d1Applies)
       (MAX(?partialExclusionReason) AS ?partialExclusionReason)
       (MAX(?realizedGain) AS ?realizedGain)
       (MAX(?excludedGain) AS ?excludedGain)
       (MAX(?taxableGain) AS ?taxableGain)
WHERE {
  ?disposition :sellDate ?sellDate .

  GRAPH :DerivedInfo {
    ?disposition :hasDerivedInfo ?derivedNode .
    ?derivedNode :forTaxpayer ?taxpayer ;
                 :involves ?property ;
                 :numeratorDays ?numeratorDaysSafe ;
				 :jointReturnFlag ?isJointReturn ;
        		 :singleReturnFlag ?isSingleReturn .
  }

  GRAPH :Interpretation {
    ?interpNode :forDisposition ?disposition ;
                :forTaxpayer ?taxpayer ;
                :involves ?property .
    OPTIONAL { ?interpNode :Rule121aFinal ?Rule121aFinal }
    OPTIONAL { ?interpNode :Rule121b1Excluded ?Rule121b1Excluded }
    OPTIONAL { ?interpNode :Rule121b2AExcluded ?Rule121b2AExcluded }
    OPTIONAL { ?interpNode :Rule121b2BExcluded ?Rule121b2BExcluded }
    OPTIONAL { ?interpNode :Rule121b3Applies ?Rule121b3Applies }
    OPTIONAL { ?interpNode :Rule121cExcluded ?Rule121cExcluded }
    OPTIONAL { ?interpNode :Rule121d1Applies ?Rule121d1Applies }
    OPTIONAL { ?interpNode :partialExclusionReason ?partialExclusionReason }
    OPTIONAL { ?interpNode :excludedGain ?excludedGain }
    OPTIONAL { ?interpNode :taxableGain ?taxableGain }
    OPTIONAL { ?interpNode :potentialGain ?realizedGain }
    OPTIONAL { ?interpNode :percentageOwned ?percentageOwned }    

  }
}
GROUP BY ?taxpayer ?property ?sellDate ?numeratorDaysSafe ?percentageOwned ?isSingleReturn ?isJointReturn
ORDER BY ?taxpayer ?property ?sellDate
