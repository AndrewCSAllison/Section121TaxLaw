:AG_1 a :Taxpayer .
:AG_2 a :Taxpayer .

:MainResidence a :Property .

:AG1_OwnUse a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned 0.5 .

:AG2_OwnUse a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned 0.5 .

:AG1_ResUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:AG2_ResUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:Disposition1 a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2017-05-14"^^xsd:date ;
    :potentialGain 540000 .

:Return1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AG_1 ;
    :linkedTo :Disposition1 .

:Return2 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AG_2 ;
    :linkedTo :Disposition1 .

:AG_1 :owns :AG1_OwnUse ;
       :uses :AG1_ResUse ;
       :disposesOf :Disposition1 .

:AG_2 :owns :AG2_OwnUse ;
       :uses :AG2_ResUse ;
       :disposesOf :Disposition1 .