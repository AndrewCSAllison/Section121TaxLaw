@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:BQ a :Taxpayer .

:MainCondo a :Property .

:BQOwnership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainCondo ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2003-09-01"^^xsd:date ;
    :percentageOwned "1.0"^^xsd:decimal .

:BQResidence1 a :ResidenceUseInterval ;
    :hasResidenceOf :MainCondo ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2003-09-01"^^xsd:date .

:BQDisposition1 a :Disposition ;
    :involves :MainCondo ;
    :sellDate "2003-09-01"^^xsd:date ;
    :potentialGain "90000"^^xsd:integer ;
    :partialExclusionReason :UnforeseenCircumstanceReason .

:BQReturn1 a :SingleReturn ;
    :associates :BQ ;
    :linkedTo :BQDisposition1 ;
    :exclusionCap "250000"^^xsd:integer .

:BQ :owns :BQOwnership1 ;
    :uses :BQResidence1 ;
    :disposesOf :BQDisposition1 .