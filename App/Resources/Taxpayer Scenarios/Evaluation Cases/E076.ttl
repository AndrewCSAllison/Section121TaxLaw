@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#########################
# Property
#########################
:Townhouse a :Property .

#########################
# Taxpayer
#########################
:Z a :Taxpayer ;
    :owns :Z_OwnershipInterval1 ;
    :uses :Z_ResidenceInterval1 ;
    :disposesOf :Z_Disposition1 .

#########################
# OwnershipUseInterval
#########################
:Z_OwnershipInterval1 a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "1997-01-18"^^xsd:date ;
    :ownershipEnd "2000-05-25"^^xsd:date ;
    :percentageOwned 1.0 .

#########################
# ResidenceUseInterval
#########################
:Z_ResidenceInterval1 a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "1995-05-25"^^xsd:date ;
    :residenceEnd "1998-02-01"^^xsd:date .

#########################
# Disposition
#########################
:Z_Disposition1 a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2000-05-25"^^xsd:date ;
    :potentialGain 180000 .

#########################
# Return
#########################
:Z_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :Z ;
    :linkedTo :Z_Disposition1 .