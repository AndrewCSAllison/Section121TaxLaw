@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#########################
# Properties
#########################
:Townhouse a :Property .
:House2002 a :Property .

#########################
# Taxpayer
#########################
:BA a :Taxpayer .

#########################
# Ownership Use Intervals
#########################
:BA_Townhouse_OwnUse a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BA_Townhouse_ResUse a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:BA_House2002_OwnUse a :OwnershipUseInterval ;
    :hasOwnershipOf :House2002 ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BA_House2002_ResUse a :ResidenceUseInterval ;
    :hasResidenceOf :House2002 ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

#########################
# Dispositions
#########################
:BA_Townhouse_Disposition a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain 180000 .

:BA_House2002_Disposition a :Disposition ;
    :involves :House2002 ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain 320000 .

#########################
# Returns
#########################
:BA_Townhouse_Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BA ;
    :linkedTo :BA_Townhouse_Disposition .

:BA_House2002_Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BA ;
    :linkedTo :BA_House2002_Disposition .

#########################
# Taxpayer Relations
#########################
:BA :owns :BA_Townhouse_OwnUse, :BA_House2002_OwnUse ;
    :uses :BA_Townhouse_ResUse, :BA_House2002_ResUse ;
    :disposesOf :BA_Townhouse_Disposition, :BA_House2002_Disposition .