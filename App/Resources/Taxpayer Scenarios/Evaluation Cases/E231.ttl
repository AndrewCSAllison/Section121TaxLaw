@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Property1 a :Property .

:OwnershipInterval_BY1 a :OwnershipUseInterval ;
    :hasOwnershipOf :Property1 ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "2000-01-15"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:OwnershipInterval_BY2 a :OwnershipUseInterval ;
    :hasOwnershipOf :Property1 ;
    :ownershipStart "1999-01-15"^^xsd:date ;
    :ownershipEnd "2000-01-15"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:ResidenceInterval_BY1 a :ResidenceUseInterval ;
    :hasResidenceOf :Property1 ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "2000-01-15"^^xsd:date .

:ResidenceInterval_BY2 a :ResidenceUseInterval ;
    :hasResidenceOf :Property1 ;
    :residenceStart "1999-01-15"^^xsd:date ;
    :residenceEnd "2000-01-15"^^xsd:date .

:Disposition1 a :Disposition ;
    :involves :Property1 ;
    :sellDate "2000-01-15"^^xsd:date ;
    :potentialGain "500000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:BY_1 a :Taxpayer ;
    :owns :OwnershipInterval_BY1 ;
    :uses :ResidenceInterval_BY1 ;
    :disposesOf :Disposition1 .

:BY_2 a :Taxpayer ;
    :owns :OwnershipInterval_BY2 ;
    :uses :ResidenceInterval_BY2 ;
    :disposesOf :Disposition1 .

:Return1 a :JointReturn ;
    :exclusionCap "500000"^^xsd:integer ;
    :associates :BY_1, :BY_2 ;
    :linkedTo :Disposition1 .