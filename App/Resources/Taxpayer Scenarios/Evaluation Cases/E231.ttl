@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:MainResidence a :Property .

:BY_1 a :Taxpayer ;
    :owns :BY1_OwnershipInterval ;
    :uses :BY1_ResidenceInterval ;
    :disposesOf :Sale2000 .

:BY_2 a :Taxpayer ;
    :owns :BY2_OwnershipInterval ;
    :uses :BY2_ResidenceInterval ;
    :disposesOf :Sale2000 .

:BY1_OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "2000-01-15"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:BY1_ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "2000-01-15"^^xsd:date .

:BY2_OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1999-01-15"^^xsd:date ;
    :ownershipEnd "2000-01-15"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:BY2_ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "1999-01-15"^^xsd:date ;
    :residenceEnd "2000-01-15"^^xsd:date .

:Sale2000 a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2000-01-15"^^xsd:date ;
    :potentialGain "500000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

:BY1_Return a :SingleReturn ;
    :associates :BY_1 ;
    :linkedTo :Sale2000 ;
    :exclusionCap "250000"^^xsd:integer .

:BY2_Return a :SingleReturn ;
    :associates :BY_2 ;
    :linkedTo :Sale2000 ;
    :exclusionCap "250000"^^xsd:integer .
