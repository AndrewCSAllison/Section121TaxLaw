:BV a :Taxpayer .

:CondoBV a :Property .
:HouseBV a :Property .

:BVCondoOwnership a :OwnershipUseInterval ;
    :hasOwnershipOf :CondoBV ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date ;
    :percentageOwned 1.0 .

:BVCondoResidence a :ResidenceUseInterval ;
    :hasResidenceOf :CondoBV ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:BVCondoDisposition a :Disposition ;
    :involves :CondoBV ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain 190000 ;
    :partialExclusionReason :UnforeseenCircumstanceReason .

:BVSingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BV ;
    :linkedTo :BVCondoDisposition .

:BV a :Taxpayer ;
    :owns :BVCondoOwnership ;
    :uses :BVCondoResidence ;
    :disposesOf :BVCondoDisposition .