:AI_1 a :Taxpayer .
:AI_2 a :Taxpayer .

:MainResidence a :Property .

:AI1_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned 0.5 .

:AI2_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd "2012-05-31"^^xsd:date ;
    :percentageOwned 0.5 .

:AI1_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:AI2_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd "2012-05-31"^^xsd:date .

:AI_Disposition a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2012-05-31"^^xsd:date ;
    :potentialGain 256000 .

:AI1_JointReturn a :JointReturn ;
    :exclusionCap 500000 ;
    :associates :AI_1 ;
    :linkedTo :AI_Disposition .

:AI2_JointReturn a :JointReturn ;
    :exclusionCap 500000 ;
    :associates :AI_2 ;
    :linkedTo :AI_Disposition .

:AI_1 :owns :AI1_Ownership ;
        :uses :AI1_Residence ;
        :disposesOf :AI_Disposition .

:AI_2 :owns :AI2_Ownership ;
        :uses :AI2_Residence ;
        :disposesOf :AI_Disposition .