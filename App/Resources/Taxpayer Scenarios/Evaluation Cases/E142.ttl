:MainResidence a :Property .

:AV_1 a :Taxpayer .
:AV_2 a :Taxpayer .

:AV_1Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1999-02-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:AV_2Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1999-02-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:AV_2Residence a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "1999-02-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:DispositionMainResidence a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain 280000 .

:JointReturn2002 a :JointReturn ;
    :exclusionCap 500000 ;
    :associates :AV_1 , :AV_2 ;
    :linkedTo :DispositionMainResidence .

:AV_1 :owns :AV_1Ownership .
:AV_2 :owns :AV_2Ownership ;
    :uses :AV_2Residence .

:AV_1 :disposesOf :DispositionMainResidence .
:AV_2 :disposesOf :DispositionMainResidence .