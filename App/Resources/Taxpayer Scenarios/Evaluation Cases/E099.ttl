@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AG_1 a :Taxpayer ;
    :owns :AG_1_OwnershipInterval ;
    :uses :AG_1_ResidenceInterval ;
    :disposesOf :AG_1_Disposition .

:AG_2 a :Taxpayer ;
    :owns :AG_2_OwnershipInterval ;
    :uses :AG_2_ResidenceInterval ;
    :disposesOf :AG_2_Disposition .

:MainResidence a :Property .

:AG_1_OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned 0.5 .

:AG_2_OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2015-05-15"^^xsd:date ;
    :ownershipEnd "2017-05-14"^^xsd:date ;
    :percentageOwned 0.5 .

:AG_1_ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:AG_2_ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2015-05-15"^^xsd:date ;
    :residenceEnd "2017-05-14"^^xsd:date .

:AG_1_Disposition a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2017-05-14"^^xsd:date ;
    :potentialGain 270000 .

:AG_2_Disposition a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2017-05-14"^^xsd:date ;
    :potentialGain 270000 .

:AG_1_Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AG_1 ;
    :linkedTo :AG_1_Disposition .

:AG_2_Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AG_2 ;
    :linkedTo :AG_2_Disposition .