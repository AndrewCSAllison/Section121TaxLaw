@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayers
:AE_1 a :Taxpayer .
:AE_2 a :Taxpayer .

### Property
:MainResidence a :Property .

### Ownership Intervals
:OUI_AE_1 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned 0.5 .

:OUI_AE_2 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "2020-01-01"^^xsd:date ;
    :ownershipEnd "2022-12-31"^^xsd:date ;
    :percentageOwned 0.5 .

### Residence Use Intervals
:RUI_AE_1 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

:RUI_AE_2 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "2020-01-01"^^xsd:date ;
    :residenceEnd "2022-12-31"^^xsd:date .

### Disposition
:Disposition_1 a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2022-12-31"^^xsd:date ;
    :potentialGain 256000 .

### Linking Taxpayers to Ownership and Residence
:AE_1 :owns :OUI_AE_1 ;
       :uses :RUI_AE_1 ;
       :disposesOf :Disposition_1 .

:AE_2 :owns :OUI_AE_2 ;
       :uses :RUI_AE_2 ;
       :disposesOf :Disposition_1 .

### Returns
:Return_AE_1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AE_1 ;
    :linkedTo :Disposition_1 .

:Return_AE_2 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :AE_2 ;
    :linkedTo :Disposition_1 .