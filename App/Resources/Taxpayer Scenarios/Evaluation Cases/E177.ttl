@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#########################
# Properties
#########################
:Townhouse a :Property .
:House2003 a :Property .

#########################
# Taxpayer
#########################
:BG a :Taxpayer .

#########################
# Ownership Intervals
#########################
:BG_Own_Townhouse a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "2001-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BG_Own_House2003 a :OwnershipUseInterval ;
    :hasOwnershipOf :House2003 ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

#########################
# Residence Intervals
#########################
:BG_Use_Townhouse a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "2001-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:BG_Use_House2003 a :ResidenceUseInterval ;
    :hasResidenceOf :House2003 ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

#########################
# Dispositions
#########################
:Disposition_Townhouse a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain 190000 .

:Disposition_House2003 a :Disposition ;
    :involves :House2003 ;
    :sellDate "2006-12-31"^^xsd:date ;
    :potentialGain 310000 .

#########################
# Returns
#########################
:Return_Townhouse a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BG ;
    :linkedTo :Disposition_Townhouse .

:Return_House2003 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BG ;
    :linkedTo :Disposition_House2003 .

#########################
# Link taxpayer to intervals and dispositions
#########################
:BG :owns :BG_Own_Townhouse, :BG_Own_House2003 ;
    :uses :BG_Use_Townhouse, :BG_Use_House2003 ;
    :disposesOf :Disposition_Townhouse, :Disposition_House2003 .