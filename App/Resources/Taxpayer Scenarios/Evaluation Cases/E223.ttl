:BW a :Taxpayer .

:SmallHouse a :Property .

:BW_OwnershipInterval1 a :OwnershipUseInterval ;
    :hasOwnershipOf :SmallHouse ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :percentageOwned 1.0 .

:BW_ResidenceInterval1 a :ResidenceUseInterval ;
    :hasResidenceOf :SmallHouse ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date .

:BW_Disposition1 a :Disposition ;
    :involves :SmallHouse ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain 120000 ;
    :partialExclusionReason :NonQualifyingReason .

:BW_Return1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BW ;
    :linkedTo :BW_Disposition1 .

:BW :owns :BW_OwnershipInterval1 ;
    :uses :BW_ResidenceInterval1 ;
    :disposesOf :BW_Disposition1 .