@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

#########################
# Taxpayers
#########################
:BY_1 a :Taxpayer .
:BY_2 a :Taxpayer .

#########################
# Property
#########################
:MainResidence a :Property .

#########################
# Ownership/Use Intervals - BY_1
#########################
:BY1_Ownership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "1999-01-15"^^xsd:date .

:BY1_Residence1 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "1999-01-15"^^xsd:date .

:BY1_Ownership2 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1999-01-15"^^xsd:date ;
    :ownershipEnd "2000-01-15"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:BY1_Residence2 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "1999-01-15"^^xsd:date ;
    :residenceEnd "2000-01-15"^^xsd:date .

#########################
# Ownership/Use Intervals - BY_2
#########################
:BY2_Ownership1 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1999-01-15"^^xsd:date ;
    :ownershipEnd "2000-01-15"^^xsd:date ;
    :percentageOwned "0.5"^^xsd:decimal .

:BY2_Residence1 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "1999-01-15"^^xsd:date ;
    :residenceEnd "2000-01-15"^^xsd:date .

#########################
# Taxpayer Links
#########################
:BY_1 :owns :BY1_Ownership1, :BY1_Ownership2 ;
      :uses :BY1_Residence1, :BY1_Residence2 ;
      :disposesOf :Disposition1 .

:BY_2 :owns :BY2_Ownership1 ;
      :uses :BY2_Residence1 ;
      :disposesOf :Disposition1 .

#########################
# Disposition
#########################
:Disposition1 a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2000-01-15"^^xsd:date ;
    :potentialGain "500000"^^xsd:integer ;
    :partialExclusionReason :EmploymentRelatedReason .

#########################
# Return
#########################
:Return1 a :JointReturn ;
    :associates :BY_1, :BY_2 ;
    :linkedTo :Disposition1 ;
    :exclusionCap 500000 .
