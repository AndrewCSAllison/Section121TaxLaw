@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#########################
# Properties
#########################
:Townhouse a :Property .
:House a :Property .

#########################
# Taxpayer
#########################
:BF a :Taxpayer .

#########################
# Ownership and Residence Use Intervals
#########################
:BF_Townhouse_OwnUse a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BF_Townhouse_ResUse a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:BF_House_OwnUse a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2005-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BF_House_ResUse a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2005-12-31"^^xsd:date .

#########################
# Dispositions
#########################
:BF_Townhouse_Sale a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain 210000 .

:BF_House_Sale a :Disposition ;
    :involves :House ;
    :sellDate "2005-12-31"^^xsd:date ;
    :potentialGain 290000 .

#########################
# Single Returns
#########################
:BF_Townhouse_Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BF ;
    :linkedTo :BF_Townhouse_Sale .

:BF_House_Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BF ;
    :linkedTo :BF_House_Sale .

#########################
# Taxpayer Links
#########################
:BF :owns :BF_Townhouse_OwnUse, :BF_House_OwnUse ;
    :uses :BF_Townhouse_ResUse, :BF_House_ResUse ;
    :disposesOf :BF_Townhouse_Sale, :BF_House_Sale .