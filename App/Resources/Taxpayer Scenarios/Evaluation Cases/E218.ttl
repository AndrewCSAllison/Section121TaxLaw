:BU a :Taxpayer .

:BU_House a :Property .

:BU_OwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :BU_House ;
    :ownershipStart "2003-04-01"^^xsd:date ;
    :ownershipEnd "2004-10-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BU_ResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :BU_House ;
    :residenceStart "2003-04-01"^^xsd:date ;
    :residenceEnd "2004-10-31"^^xsd:date .

:BU_Disposition a :Disposition ;
    :involves :BU_House ;
    :sellDate "2004-10-31"^^xsd:date ;
    :potentialGain 95000 .

:BU_Return a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BU ;
    :linkedTo :BU_Disposition .

:BU :owns :BU_OwnershipInterval ;
    :uses :BU_ResidenceInterval ;
    :disposesOf :BU_Disposition .