:TaxpayerJ a :Taxpayer ;
    :owns :J_TexasOwnershipInterval , :J_NewMexicoOwnershipInterval ;
    :uses :J_TexasResidence2000_2001 , :J_NewMexicoResidence2002_2003 , :J_TexasResidence2004 ;
    :disposesOf :J_TexasDisposition , :J_NewMexicoDisposition .

:MainResidenceTexas a :Property .
:MainResidenceNewMexico a :Property .

:J_TexasOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidenceTexas ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:J_NewMexicoOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidenceNewMexico ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd "2004-12-31"^^xsd:date .

:J_TexasResidence2000_2001 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidenceTexas ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd "2001-12-31"^^xsd:date .

:J_NewMexicoResidence2002_2003 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidenceNewMexico ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2003-12-31"^^xsd:date .

:J_TexasResidence2004 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidenceTexas ;
    :residenceStart "2004-01-01"^^xsd:date ;
    :residenceEnd "2004-12-31"^^xsd:date .

:J_TexasDisposition a :Disposition ;
    :involves :MainResidenceTexas ;
    :sellDate "2004-12-18"^^xsd:date ;
    :potentialGain 230000 .

:J_NewMexicoDisposition a :Disposition ;
    :involves :MainResidenceNewMexico ;
    :sellDate "2004-12-18"^^xsd:date ;
    :potentialGain 210000 .

:J_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :TaxpayerJ ;
    :linkedTo :J_TexasDisposition , :J_NewMexicoDisposition .
