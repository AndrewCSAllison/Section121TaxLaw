:BK a :Taxpayer .

:BKHouse a :Property .

:BKHouseOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :BKHouse ;
    :ownershipStart "2002-02-01"^^xsd:date ;
    :ownershipEnd "2005-08-01"^^xsd:date .

:BKHouseResidenceInterval1 a :ResidenceUseInterval ;
    :hasResidenceOf :BKHouse ;
    :residenceStart "2002-02-01"^^xsd:date ;
    :residenceEnd "2003-05-01"^^xsd:date .

:BKHouseResidenceInterval2 a :ResidenceUseInterval ;
    :hasResidenceOf :BKHouse ;
    :residenceStart "2003-05-01"^^xsd:date ;
    :residenceEnd "2005-06-01"^^xsd:date .

:BKHouseDisposition a :Disposition ;
    :involves :BKHouse ;
    :sellDate "2005-08-01"^^xsd:date ;
    :potentialGain 200000 ;
    :partialExclusionReason :EmploymentRelatedReason .

:BKSingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BK ;
    :linkedTo :BKHouseDisposition .

:BK :owns :BKHouseOwnershipInterval ;
    :uses :BKHouseResidenceInterval1 , :BKHouseResidenceInterval2 ;
    :disposesOf :BKHouseDisposition .