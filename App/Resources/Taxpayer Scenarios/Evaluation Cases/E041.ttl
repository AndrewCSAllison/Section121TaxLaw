:TaxpayerN a :Taxpayer ;
    :owns :HouseOwnershipInterval , :LandOwnershipInterval ;
    :uses :HouseResidenceInterval , :LandResidenceInterval ;
    :disposesOf :HouseDisposition , :LandDisposition .

:MainHouse a :Property .
:ParcelLand a :Property .

:HouseOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :MainHouse ;
    :ownershipStart "1995-01-01"^^xsd:date ;
    :ownershipEnd "2000-12-31"^^xsd:date .

:LandOwnershipInterval a :OwnershipUseInterval ;
    :hasOwnershipOf :ParcelLand ;
    :ownershipStart "1996-01-01"^^xsd:date ;
    :ownershipEnd "2000-12-31"^^xsd:date .

:HouseResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :MainHouse ;
    :residenceStart "1995-01-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:LandResidenceInterval a :ResidenceUseInterval ;
    :hasResidenceOf :ParcelLand ;
    :residenceStart "1996-01-01"^^xsd:date ;
    :residenceEnd "2000-12-31"^^xsd:date .

:HouseDisposition a :Disposition ;
    :involves :MainHouse ;
    :sellDate "2000-05-20"^^xsd:date ;
    :potentialGain -10000 .

:LandDisposition a :Disposition ;
    :involves :ParcelLand ;
    :sellDate "2000-05-20"^^xsd:date ;
    :potentialGain 250000 .

:SingleReturn2000 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :TaxpayerN ;
    :linkedTo :HouseDisposition , :LandDisposition .
