:Property1 a :Property .

:OwnershipInterval1 a :OwnershipUseInterval ;
    :hasOwnershipOf :Property1 ;
    :ownershipStart "1986-01-01"^^xsd:date ;
    :ownershipEnd "2000-04-18"^^xsd:date .

:ResidenceInterval1 a :ResidenceUseInterval ;
    :hasResidenceOf :Property1 ;
    :residenceStart "1986-01-01"^^xsd:date ;
    :residenceEnd "1998-01-31"^^xsd:date .

:ResidenceInterval2 a :ResidenceUseInterval ;
    :hasResidenceOf :Property1 ;
    :residenceStart "2000-04-18"^^xsd:date ;
    :residenceEnd "2000-04-18"^^xsd:date .

:Disposition1 a :Disposition ;
    :involves :Property1 ;
    :sellDate "2000-04-18"^^xsd:date ;
    :potentialGain 200000 .

:TaxpayerP a :Taxpayer ;
    :owns :OwnershipInterval1 ;
    :uses :ResidenceInterval1, :ResidenceInterval2 ;
    :disposesOf :Disposition1 .

:SingleReturn1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :TaxpayerP ;
    :linkedTo :Disposition1 .
