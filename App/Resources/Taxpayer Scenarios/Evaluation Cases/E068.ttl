@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:W a :Taxpayer ;
    :owns :W_OwnershipInterval1 ;
    :uses :W_ResidenceInterval1 ;
    :disposesOf :Disposition1 .

:MainResidence a :Property .

:W_OwnershipInterval1 a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1986-05-10"^^xsd:date ;
    :ownershipEnd "2001-09-20"^^xsd:date ;
    :percentageOwned 1.0 .

:W_ResidenceInterval1 a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "1986-05-10"^^xsd:date ;
    :residenceEnd "1998-01-04"^^xsd:date .

:Disposition1 a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2001-09-20"^^xsd:date ;
    :potentialGain 195000 .

:Return1 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :W ;
    :linkedTo :Disposition1 .