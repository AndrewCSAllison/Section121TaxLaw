@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:BR a :Taxpayer .

:MainResidence a :Property .

:BR_Ownership1 a :OwnershipUseInterval ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-01-01"^^xsd:date ;
    :hasOwnershipOf :MainResidence .

:BR_Residence1 a :ResidenceUseInterval ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-01-01"^^xsd:date ;
    :hasResidenceOf :MainResidence .

:BR_Disposition1 a :Disposition ;
    :sellDate "2004-01-01"^^xsd:date ;
    :potentialGain 200000 ;
    :involves :MainResidence ;
    :partialExclusionReason :NonQualifyingReason .

:BR :owns :BR_Ownership1 ;
    :uses :BR_Residence1 ;
    :disposesOf :BR_Disposition1 .

:BR_Return1 a :SingleReturn ;
    :associates :BR ;
    :linkedTo :BR_Disposition1 ;
    :exclusionCap 250000 .