@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:BE a :Taxpayer .

:Townhouse a :Property .
:House a :Property .

:BE_Owns_Townhouse a :OwnershipUseInterval ;
    :hasOwnershipOf :Townhouse ;
    :ownershipStart "1997-01-01"^^xsd:date ;
    :ownershipEnd "2001-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BE_Uses_Townhouse a :ResidenceUseInterval ;
    :hasResidenceOf :Townhouse ;
    :residenceStart "1997-01-01"^^xsd:date ;
    :residenceEnd "1998-12-31"^^xsd:date .

:BE_Owns_House a :OwnershipUseInterval ;
    :hasOwnershipOf :House ;
    :ownershipStart "1999-01-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:BE_Uses_House a :ResidenceUseInterval ;
    :hasResidenceOf :House ;
    :residenceStart "1999-01-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:Disposition_Townhouse a :Disposition ;
    :involves :Townhouse ;
    :sellDate "2001-12-31"^^xsd:date ;
    :potentialGain 120000 .

:Disposition_House a :Disposition ;
    :involves :House ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain 270000 .

:SingleReturn_Townhouse a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BE ;
    :linkedTo :Disposition_Townhouse .

:SingleReturn_House a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BE ;
    :linkedTo :Disposition_House .

:BE :owns :BE_Owns_Townhouse, :BE_Owns_House ;
    :uses :BE_Uses_Townhouse, :BE_Uses_House ;
    :disposesOf :Disposition_Townhouse, :Disposition_House .