:BV a :Taxpayer .

:BV_Condo a :Property .
:BV_House a :Property .

:BV_Ownership_Condo a :OwnershipUseInterval ;
    :hasOwnershipOf :BV_Condo ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2004-06-01"^^xsd:date ;
    :percentageOwned 1.0 .

:BV_Residence_Condo a :ResidenceUseInterval ;
    :hasResidenceOf :BV_Condo ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2004-06-01"^^xsd:date .

:BV_CondoDisposition a :Disposition ;
    :involves :BV_Condo ;
    :sellDate "2004-06-01"^^xsd:date ;
    :potentialGain 190000 ;
    :partialExclusionReason :UnforeseenCircumstanceReason .

:BV_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :BV ;
    :linkedTo :BV_CondoDisposition .

:BV a :Taxpayer ;
    :owns :BV_Ownership_Condo ;
    :uses :BV_Residence_Condo ;
    :disposesOf :BV_CondoDisposition . 