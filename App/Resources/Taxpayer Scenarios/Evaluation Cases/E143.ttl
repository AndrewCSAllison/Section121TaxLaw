:MainResidence a :Property .

:AV_1 a :Taxpayer .
:AV_2 a :Taxpayer .

:AV_1_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1999-02-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned 1.0 .
    
:AV_2_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :MainResidence ;
    :ownershipStart "1999-02-01"^^xsd:date ;
    :ownershipEnd "2002-12-31"^^xsd:date ;
    :percentageOwned 1.0 .

:AV_2_ResidenceUse a :ResidenceUseInterval ;
    :hasResidenceOf :MainResidence ;
    :residenceStart "1999-02-01"^^xsd:date ;
    :residenceEnd "2002-12-31"^^xsd:date .

:Disposition_Main a :Disposition ;
    :involves :MainResidence ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain 280000 .

:JointReturn_2002 a :JointReturn ;
    :exclusionCap 500000 ;
    :associates :AV_1 , :AV_2 ;
    :linkedTo :Disposition_Main .

:AV_1 :owns :AV_1_Ownership ;
       :disposesOf :Disposition_Main .

:AV_2 :owns :AV_2_Ownership ;
       :uses :AV_2_ResidenceUse ;
       :disposesOf :Disposition_Main .