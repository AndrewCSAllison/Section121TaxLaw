:O a :Taxpayer ;
    :owns :O_House_Ownership , :O_Land_Ownership ;
    :uses :O_House_Residence , :O_Land_Residence ;
    :disposesOf :O_House_Disposition , :O_Land_Disposition .

:O_House a :Property .
:O_Land a :Property .

:O_House_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :O_House ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:O_Land_Ownership a :OwnershipUseInterval ;
    :hasOwnershipOf :O_Land ;
    :ownershipStart "2003-01-01"^^xsd:date ;
    :ownershipEnd "2006-12-31"^^xsd:date .

:O_House_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :O_House ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:O_Land_Residence a :ResidenceUseInterval ;
    :hasResidenceOf :O_Land ;
    :residenceStart "2003-01-01"^^xsd:date ;
    :residenceEnd "2006-12-31"^^xsd:date .

:O_House_Disposition a :Disposition ;
    :involves :O_House ;
    :sellDate "2006-09-10"^^xsd:date ;
    :potentialGain -20000 .

:O_Land_Disposition a :Disposition ;
    :involves :O_Land ;
    :sellDate "2006-09-10"^^xsd:date ;
    :potentialGain 260000 .

:O_SingleReturn a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :O ;
    :linkedTo :O_House_Disposition , :O_Land_Disposition .
