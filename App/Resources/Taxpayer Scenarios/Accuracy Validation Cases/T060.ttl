@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayer
:T060 a :Taxpayer .

### Properties
:Property_T060_1 a :Property .
:Property_T060_2 a :Property .

### Ownership Intervals
:Own_T060_1 a :OwnershipUseInterval ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd   "2000-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_T060_1 .

:Own_T060_2 a :OwnershipUseInterval ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd   "2002-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_T060_2 .

### Residence Use Intervals
:Use_T060_1 a :ResidenceUseInterval ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd   "2000-12-31"^^xsd:date ;
    :hasResidenceOf :Property_T060_1 .

:Use_T060_2 a :ResidenceUseInterval ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd   "2002-12-31"^^xsd:date ;
    :hasResidenceOf :Property_T060_2 .

### Dispositions
:Disp_T060_1 a :Disposition ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "160000"^^xsd:integer ;
    :involves :Property_T060_1 .

:Disp_T060_2 a :Disposition ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "280000"^^xsd:integer ;
    :involves :Property_T060_2 .

### Associations
:T060 :owns :Own_T060_1, :Own_T060_2 ;
       :uses :Use_T060_1, :Use_T060_2 ;
       :disposesOf :Disp_T060_1, :Disp_T060_2 .

### Single Return
:Return_T060 a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :T060 ;
    :linkedTo :Disp_T060_1, :Disp_T060_2 .
