@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayer
:T052 a :Taxpayer .

### Properties
:Property_T052_1 a :Property .
:Property_T052_2 a :Property .

### Ownership Intervals
:Own_T052_1 a :OwnershipUseInterval ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd   "2002-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_T052_1 .

:Own_T052_2 a :OwnershipUseInterval ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd   "2003-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_T052_2 .

### Residence Use Intervals
:Use_T052_1 a :ResidenceUseInterval ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd   "1999-12-31"^^xsd:date ;
    :hasResidenceOf :Property_T052_1 .

:Use_T052_2 a :ResidenceUseInterval ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd   "2003-12-31"^^xsd:date ;
    :hasResidenceOf :Property_T052_2 .

### Dispositions
:Disp_T052_1 a :Disposition ;
    :sellDate "2002-12-31"^^xsd:date ;
    :potentialGain "150000"^^xsd:integer ;
    :involves :Property_T052_1 .

:Disp_T052_2 a :Disposition ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "300000"^^xsd:integer ;
    :involves :Property_T052_2 .

### Associations
:T052 :owns :Own_T052_1, :Own_T052_2 ;
       :uses :Use_T052_1, :Use_T052_2 ;
       :disposesOf :Disp_T052_1, :Disp_T052_2 .

### Single Return
:Return_T052 a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :T052 ;
    :linkedTo :Disp_T052_1, :Disp_T052_2 .
