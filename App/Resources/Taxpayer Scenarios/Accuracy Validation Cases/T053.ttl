@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayer
:T053 a :Taxpayer .

### Properties
:Property_T053_1 a :Property .
:Property_T053_2 a :Property .

### Ownership Intervals
:Own_T053_1 a :OwnershipUseInterval ;
    :ownershipStart "2000-01-01"^^xsd:date ;
    :ownershipEnd   "2003-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_T053_1 .

:Own_T053_2 a :OwnershipUseInterval ;
    :ownershipStart "2002-01-01"^^xsd:date ;
    :ownershipEnd   "2004-12-31"^^xsd:date ;
    :hasOwnershipOf :Property_T053_2 .

### Residence Use Intervals
:Use_T053_1 a :ResidenceUseInterval ;
    :residenceStart "2000-01-01"^^xsd:date ;
    :residenceEnd   "2001-12-31"^^xsd:date ;
    :hasResidenceOf :Property_T053_1 .

:Use_T053_2 a :ResidenceUseInterval ;
    :residenceStart "2002-01-01"^^xsd:date ;
    :residenceEnd   "2004-12-31"^^xsd:date ;
    :hasResidenceOf :Property_T053_2 .

### Dispositions
:Disp_T053_1 a :Disposition ;
    :sellDate "2003-12-31"^^xsd:date ;
    :potentialGain "180000"^^xsd:integer ;
    :involves :Property_T053_1 .

:Disp_T053_2 a :Disposition ;
    :sellDate "2004-12-31"^^xsd:date ;
    :potentialGain "320000"^^xsd:integer ;
    :involves :Property_T053_2 .

### Associations
:T053 :owns :Own_T053_1, :Own_T053_2 ;
       :uses :Use_T053_1, :Use_T053_2 ;
       :disposesOf :Disp_T053_1, :Disp_T053_2 .

### Single Return
:Return_T053 a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :T053 ;
    :linkedTo :Disp_T053_1, :Disp_T053_2 .
