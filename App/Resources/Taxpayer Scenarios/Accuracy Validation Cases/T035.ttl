@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayers
:T035a a :Taxpayer .
:T035b a :Taxpayer .

### Property
:Property_T035 a :Property .

### Ownership Intervals
:Own_T035a_1 a :OwnershipUseInterval ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd   "2012-05-31"^^xsd:date ;
    :hasOwnershipOf :Property_T035 .

:Own_T035b_1 a :OwnershipUseInterval ;
    :ownershipStart "2010-06-01"^^xsd:date ;
    :ownershipEnd   "2012-05-31"^^xsd:date ;
    :hasOwnershipOf :Property_T035 .

### Residence Use
:Use_T035a_1 a :ResidenceUseInterval ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd   "2012-05-31"^^xsd:date ;
    :hasResidenceOf :Property_T035 .

:Use_T035b_1 a :ResidenceUseInterval ;
    :residenceStart "2010-06-01"^^xsd:date ;
    :residenceEnd   "2012-05-31"^^xsd:date ;
    :hasResidenceOf :Property_T035 .

### Dispositions (split gain)
:Disp_T035a a :Disposition ;
    :sellDate "2012-05-31"^^xsd:date ;
    :potentialGain "128000"^^xsd:integer ;
    :involves :Property_T035 .

:Disp_T035b a :Disposition ;
    :sellDate "2012-05-31"^^xsd:date ;
    :potentialGain "128000"^^xsd:integer ;
    :involves :Property_T035 .

### Associations
:T035a :owns :Own_T035a_1 ; :uses :Use_T035a_1 ; :disposesOf :Disp_T035a .
:T035b :owns :Own_T035b_1 ; :uses :Use_T035b_1 ; :disposesOf :Disp_T035b .

### Individual Returns
:Return_T035a a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :T035a ;
    :linkedTo :Disp_T035a .

:Return_T035b a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :T035b ;
    :linkedTo :Disp_T035b .
