@prefix : <http://example.org/section121#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Taxpayers
:T032a a :Taxpayer .
:T032b a :Taxpayer .

### Property
:Property_T032 a :Property .

### Ownership Intervals
:Own_T032a_1 a :OwnershipUseInterval ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd   "2020-02-28"^^xsd:date ;
    :hasOwnershipOf :Property_T032 .

:Own_T032b_1 a :OwnershipUseInterval ;
    :ownershipStart "2018-02-01"^^xsd:date ;
    :ownershipEnd   "2020-02-28"^^xsd:date ;
    :hasOwnershipOf :Property_T032 .

### Residence Use
:Use_T032a_1 a :ResidenceUseInterval ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd   "2020-02-28"^^xsd:date ;
    :hasResidenceOf :Property_T032 .

:Use_T032b_1 a :ResidenceUseInterval ;
    :residenceStart "2018-02-01"^^xsd:date ;
    :residenceEnd   "2020-02-28"^^xsd:date ;
    :hasResidenceOf :Property_T032 .

### Dispositions (split gain)
:Disp_T032a a :Disposition ;
    :sellDate "2020-02-28"^^xsd:date ;
    :potentialGain "150000"^^xsd:integer ;
    :involves :Property_T032 .

:Disp_T032b a :Disposition ;
    :sellDate "2020-02-28"^^xsd:date ;
    :potentialGain "150000"^^xsd:integer ;
    :involves :Property_T032 .

### Associations
:T032a :owns :Own_T032a_1 ; :uses :Use_T032a_1 ; :disposesOf :Disp_T032a .
:T032b :owns :Own_T032b_1 ; :uses :Use_T032b_1 ; :disposesOf :Disp_T032b .

### Individual Returns
:Return_T032a a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :T032a ;
    :linkedTo :Disp_T032a .

:Return_T032b a :SingleReturn ;
    :exclusionCap "250000"^^xsd:integer ;
    :associates :T032b ;
    :linkedTo :Disp_T032b .
