@prefix : <http://example.org/section121#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

:Example6Ontology a owl:Ontology ;
    rdfs:comment "Section 121 Example 6 – T009a sells after T009b’s death in the next tax year, filing as single taxpayer." .

#########################
# Taxpayers
#########################
:T009a a :Taxpayer ;
    rdfs:comment "Surviving spouse; sells property in 2002." .

:T009b a :Taxpayer ;
    rdfs:comment "Deceased spouse; owned and used property until death in 2001." .

#########################
# Property
#########################
:Home_Example6 a :Property ;
    rdfs:comment "Principal residence jointly owned by T009a and T009b since 1998." .

#########################
# Ownership Intervals
#########################
:OwnershipInterval_T009a a :OwnershipUseInterval ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2002-01-31"^^xsd:date ;
    :hasOwnershipOf :Home_Example6 .

:OwnershipInterval_T009b a :OwnershipUseInterval ;
    :ownershipStart "1998-01-01"^^xsd:date ;
    :ownershipEnd "2001-02-16"^^xsd:date ;
    :hasOwnershipOf :Home_Example6 .

#########################
# Residence Intervals
#########################
:ResidenceInterval_T009a a :ResidenceUseInterval ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2002-01-31"^^xsd:date ;
    :hasResidenceOf :Home_Example6 .

:ResidenceInterval_T009b a :ResidenceUseInterval ;
    :residenceStart "1998-01-01"^^xsd:date ;
    :residenceEnd "2001-02-16"^^xsd:date ;
    :hasResidenceOf :Home_Example6 .

#########################
# Taxpayer Relationships
#########################
:T009a :owns :OwnershipInterval_T009a ;
       :uses :ResidenceInterval_T009a ;
       :disposesOf :Disposition_Example6 .

:T009b :owns :OwnershipInterval_T009b ;
       :uses :ResidenceInterval_T009b .

#########################
# Disposition
#########################
:Disposition_Example6 a :Disposition ;
    :sellDate "2002-01-31"^^xsd:date ;
    :potentialGain 350000 ;
    :involves :Home_Example6 .

#########################
# Return
#########################
:SingleReturn_Example6 a :SingleReturn ;
    :exclusionCap 250000 ;
    :associates :T009a ;
    :linkedTo :Disposition_Example6 .
